#!/usr/bin/env bash
# onetree — a git worktree per agent task, a read-only main checkout, cleanup when the PR merges.
#   For Claude Code, Codex, pi and dsh.  https://github.com/aditya-jha/onetree
#
#   layout   <root>/<repo>/<slug>     root: ~/worktrees, or per repo (onetree.root)
#   branch   <prefix><slug>           prefix: feature/ (onetree.branchPrefix), cut from <base>/<integration> after a fetch
#   remotes  base: holds the integration branch and the PRs (onetree.remote, else `upstream` when it is another repo
#            than origin, else origin). push: where feature branches go (onetree.pushRemote, else remote.pushDefault,
#            else origin)
#   config   ~/.config/onetree/config (global) < <repo>/.onetree (committed) < <repo>/.git/config [onetree] (local),
#            all git-config format. keys: integration guard root branchPrefix copy keep keepSource bootstrap stale
#            writable lockIgnored; per clone only, never from a committed .onetree: remote pushRemote ghUser
#            production devClone. `onetree info` shows the effective values.
#
# Repos
#   init [repo] [--guard|--no-guard] [--integration B] [--root D] [--branch-prefix P] [--copy "f g"]
#        [--keep "f g"] [--keep-source D] [--bootstrap CMD] [--stale H] [--remote R] [--push-remote R]
#        [--gh-user LOGIN] [--writable "p d/"|--writable-add "p"|--writable-remove "p"] [--exclude-writable]
#        [--lock-ignored|--no-lock-ignored] [--carry <slug> [--carry-untracked]] [--file]
#                              register a repo and set its behaviour; --file writes a committable .onetree instead.
#                              A guarded mirror locks what git tracks or would track; gitignored paths (deps, caches,
#                              .env) stay writable unless --lock-ignored. --writable: local state to keep writable
#                              (d/ = a directory). --carry: move a dirty main's work into a worktree before locking.
#   repos | unregister [repo]  the registry
#   info [repo] [--json]       the effective settings (--json adds where each value came from)
#   snippet [repo]             a paragraph for the repo's AGENTS.md / CLAUDE.md
#
# Worktrees
#   new <slug> [repo]          create (idempotent) and bootstrap; prints the path
#   carry <slug> [repo] [--untracked]
#                              move a main checkout's uncommitted changes into a new worktree, verify, restore main
#   review <branch>|<PR> [repo]
#                              a clean detached checkout of a branch or of PR <n> (fork PRs too) for a reviewer;
#                              gc removes it once the PR resolves
#   ls [repo|--all] [--json] [--fresh]
#                              branch, dirty, unpushed, PR state, lock, live processes
#   rm <slug> [repo] [--force] remove a worktree and its branch when gc would (merged, or nothing of its own), clean
#                              and idle; --force skips the checks
#   gc [repo|--all] [--dry-run] [--json] [--fresh]
#                              remove each worktree onetree made that is merged, clean and idle, and park merged mains
#   park [repo|--all]          return a clean main whose branch merged to the integration branch; refresh its npm deps
#   bootstrap [path]           copy onetree.copy files, install deps, run onetree.bootstrap
#
# Agents
#   launch [--task <slug>] <agent> [args…]
#                              start claude, codex, pi or dsh where it belongs: a fresh worktree in a guarded mirror,
#                              the named one with --task, else as typed. The shell wrappers call this
#   resume [slug|session] [repo]
#                              the sessions that made this repo's worktrees; with one, recreate its worktree if gc
#                              removed it and print how to resume the session there
#   agents [--json]            live agent sessions and where they sit
#
# Visibility
#   events [--json] [--since 24h|7d|<epoch>] [--kind K] [-n N]
#                              what onetree did or refused (~/.local/state/onetree/events.jsonl)
#   snapshot [repo|--all] [--fresh]
#                              one JSON document of all of the above (docs/snapshot.md)
#   ui [--port N] [--no-open] [--ttl S] [--interval S] [--fixture F]
#                              the dashboard on 127.0.0.1, over `onetree snapshot`; needs node 22.6+
#
# Machine
#   install | update | uninstall
#                              hooks for each agent found, shell wrappers, the agent rules block, the hourly gc job
#   doctor [--json]            check all of that; rules: print the rules block; version: print the version
#
# Hooks and adapters (called by agents and wrappers, not by hand)
#   guard                      PreToolUse (Claude, Codex) and tool_call (pi, dsh): refuse changes to a guarded main
#   session                    SessionStart: record the session; one line of guidance where it matters
#   hook-create | hook-remove  Claude Code WorktreeCreate / WorktreeRemove
#   auto <agent>|--check | bound [--session S] [--pid P] | render pi|dsh
#                              wrapper and extension helpers
#
#   gh PR states, fetches and the doctor report are cached for a few minutes (ONETREE_PR_TTL, ONETREE_FETCH_TTL,
#   ONETREE_DOCTOR_TTL seconds); --fresh ignores the cache, and rm always asks gh. ONETREE_TIMING=1 prints phase times.
set -eo pipefail
# Map of this file, in order. Each section starts with a `# ----` line; `grep -n '^# ----' bin/onetree` lists them.
#   settings and helpers    paths, config layers (cfg), remotes, integration branch
#   writable local state    what stays writable in a guarded mirror, and the read-only lock itself
#   caches, review, JSON    TTL caches for gh and fetch; review checkouts; status_line and the --json shapes
#   agents                  which agent sessions are alive and where they sit
#   dependencies            is node_modules what the lockfile asks for; the refresh-and-swap of a main's
#   new                     bootstrap (copy files, dependencies, onetree.bootstrap) and cmd_new
#   carry                   moving a dirty main's work into a worktree, verified before main is restored
#   ls, rm, gc, park        remove_one holds every keep/remove verdict; park returns a main to its branch
#   events, snapshot, ui    the audit log, the one-document snapshot, the dashboard launcher
#   launch, resume          where an agent starts, and finding its worktree again
#   registry                init, unregister, info, snippet: per-repo settings
#   session, rules          the SessionStart hook and the rules block each agent's instructions carry
#   install, doctor         hooks, wrappers, the hourly job; and the checks that they still hold
#   guard                   the PreToolUse hook: a command-position parser over the agent's command
#   dispatch                the subcommand table at the bottom

# ---- settings and helpers every command uses
VERSION=1.1.0
[[ -n "${ONETREE_TIMING:-}" && -z "${ONETREE_T0:-}" ]] && { ONETREE_T0=$(perl -MTime::HiRes=time -e 'print time' 2>/dev/null || date +%s); export ONETREE_T0; }   # ONETREE_TIMING=1: phase timings on stderr
CFG=${ONETREE_CONFIG:-$HOME/.config/onetree/config}
EVENTS=${ONETREE_EVENTS:-$HOME/.local/state/onetree/events.jsonl}   # append-only record of what onetree did or refused (docs/snapshot.md)
SESSIONS=${ONETREE_SESSIONS:-$HOME/.local/state/onetree/sessions}   # one <pid>.json per live agent session, written by the SessionStart hook
ONETREE_CMD=${1:-}

die() { printf 'onetree: %s\n' "$*" >&2; exit 1; }
real() { ( cd "$1" 2>/dev/null && pwd -P ) || printf '%s' "$1"; }
tbl() {  # tab-separated rows on stdin -> aligned columns; column(1) is not in a minimal Debian (bsdextrautils), so awk stands in
  if command -v column >/dev/null 2>&1; then column -t -s $'\t'
  else awk -F'\t' '{ for (i = 1; i <= NF; i++) { c[NR, i] = $i; if (length($i) > w[i]) w[i] = length($i) } if (NF > n) n = NF }
      END { for (r = 1; r <= NR; r++) { s = ""; for (i = 1; i <= n; i++) { s = s c[r, i]; if (i < n) s = s substr("                                                                ", 1, w[i] - length(c[r, i]) + 2) } sub(/ +$/, "", s); print s } }'; fi
}
realfile() { printf '%s/%s' "$(real "$(dirname "$1")")" "$(basename "$1")"; }
mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0; }   # GNU first: BSD stat rejects -c, but GNU stat -f %m succeeds and prints the mount point
clone_dir() { cp -Rc "$1" "$2" 2>/dev/null || cp -R --reflink=auto "$1" "$2" 2>/dev/null || cp -R "$1" "$2"; }  # APFS / btrfs / xfs reflink when available
tilde() { local p=$1; p=${p/#\~/$HOME}; p=${p/#\$HOME/$HOME}; printf '%s' "$p"; }
gcfg() { [[ -f "$CFG" ]] && git config -f "$CFG" --get "$1" 2>/dev/null; }
gcfg_all() { [[ -f "$CFG" ]] && git config -f "$CFG" --get-all "$1" 2>/dev/null; return 0; }
CFG_DUMP_MAIN=; CFG_DUMP=   # "layer<tab>key<tab>value" for one main: its three config layers read once per process, inherited by subshells
REM_URLS=; REM_PUSHDEFAULT=   # from the same read of .git/config: "name<tab>url" per remote, and remote.pushDefault
cfg_dump() {  # main — three git calls, then every cfg lookup for this main is a loop in bash
  local m=$1 src list line key out="" rem="" pd=""
  [[ "$CFG_DUMP_MAIN" == "$m" ]] && return 0
  for src in local file global; do
    case $src in
      local) list=$(git -C "$m" config --local --list 2>/dev/null || true) ;;
      file) list=""; [[ -f "$m/.onetree" ]] && list=$(git config -f "$m/.onetree" --list 2>/dev/null || true) ;;
      global) list=""; [[ -f "$CFG" ]] && list=$(git config -f "$CFG" --list 2>/dev/null || true) ;;
    esac
    while IFS= read -r line; do
      if [[ "$line" == onetree.*=* ]]; then line=${line#onetree.}; out+="$src"$'\t'"${line%%=*}"$'\t'"${line#*=}"$'\n'
      elif [[ $src == local && "$line" == remote.*=* ]]; then   # git lower-cases the key, never the remote's name
        key=${line%%=*}
        if [[ "$key" == remote.pushdefault ]]; then pd=${line#*=}
        elif [[ "$key" == remote.*.url ]]; then key=${key#remote.}; rem+="${key%.url}"$'\t'"${line#*=}"$'\n'; fi
      fi
    done <<<"$list"
  done
  CFG_DUMP=$out; REM_URLS=$rem; REM_PUSHDEFAULT=$pd; CFG_DUMP_MAIN=$m; REM_MAIN=; INT_MAIN=; return 0
}
LCK=
# git lists keys in lower case
lc_key() { case "$1" in branchPrefix) LCK=branchprefix ;; keepSource) LCK=keepsource ;; pushRemote) LCK=pushremote ;; ghUser) LCK=ghuser ;; lockIgnored) LCK=lockignored ;; *) LCK=$1 ;; esac; }
# key main — sets CFG_VAL and CFG_SRC (local | file | global) from the winning layer, like git config --get: the layer's
# last value; 1 when unset
cfg_find() {
  local m=$2 src key val; lc_key "$1"; cfg_dump "$m"; CFG_SRC=""; CFG_VAL=""
  while IFS=$'\t' read -r src key val; do
    [[ "$key" == "$LCK" ]] || continue
    if [[ -z "$CFG_SRC" ]]; then CFG_SRC=$src; CFG_VAL=$val; elif [[ "$src" == "$CFG_SRC" ]]; then CFG_VAL=$val; else break; fi
  done <<<"$CFG_DUMP"
  [[ -n "$CFG_SRC" ]]
}
# key main — cfg_find for a per-clone key (remote names, a gh login): a committed .onetree value is skipped and left in
# CFG_SKIPPED
cfg_find_clone() {
  local m=$2 src key val; lc_key "$1"; cfg_dump "$m"; CFG_SRC=""; CFG_VAL=""; CFG_SKIPPED=""
  while IFS=$'\t' read -r src key val; do
    [[ "$key" == "$LCK" ]] || continue
    [[ $src == file ]] && { CFG_SKIPPED=$val; continue; }
    if [[ -z "$CFG_SRC" ]]; then CFG_SRC=$src; CFG_VAL=$val; elif [[ "$src" == "$CFG_SRC" ]]; then CFG_VAL=$val; else break; fi
  done <<<"$CFG_DUMP"
  [[ -n "$CFG_SRC" ]]
}
cfg() {  # key main [default] — local .git/config > committed .onetree > global config > default
  if cfg_find "$1" "$2"; then printf '%s\n' "$CFG_VAL"; return 0; fi
  [[ $# -ge 3 ]] && { printf '%s\n' "$3"; return 0; }
  return 1
}

# ---- remotes: the base remote holds the integration branch and the PRs; the push remote receives feature branches.
# One remote plays both roles unless the clone is a fork (an `upstream` that is another repo than origin) or config says
# otherwise.
REM_MAIN=; RB=; RB_SRC=; RP=; RP_SRC=; REM_SKIPPED=
# name -> url from .git/config, as written (no insteadOf)
rem_url() { local n u; while IFS=$'\t' read -r n u; do [[ -n "$n" && "$n" == "$1" ]] && { printf '%s' "$u"; return 0; }; done <<<"$REM_URLS"; return 1; }
# remote url -> the repo gh should ask: owner/repo on github.com or behind an ssh alias, host/owner/repo on another
# host; a local path minus .git
url_slug() {
  local u=$1 h
  if [[ "$u" =~ github\.com[:/](.*)$ ]]; then u=${BASH_REMATCH[1]}
  elif [[ "$u" == file:* || "$u" == /* || "$u" == .* ]]; then :
  elif [[ "$u" =~ ^[A-Za-z][A-Za-z0-9+.-]*://([^@/]*@)?([^/:]+)(:[0-9]*)?/(.*)$ ]]; then h=${BASH_REMATCH[2]}; u=${BASH_REMATCH[4]}; [[ "$h" == *.* ]] && u="$h/$u"
  # scp-like; a host without a dot is an ssh alias
  elif [[ "$u" =~ ^([^@/:]+@)?([^/:]+):(.*)$ ]]; then h=${BASH_REMATCH[2]}; u=${BASH_REMATCH[3]}; [[ "$h" == *.* ]] && u="$h/$u"
  fi
  printf '%s' "${u%.git}"
}
slug_same() { [[ "$(tr '[:upper:]' '[:lower:]' <<<"${1%/}")" == "$(tr '[:upper:]' '[:lower:]' <<<"${2%/}")" ]]; }
# main — sets RB RB_SRC RP RP_SRC (sources: local | global | upstream-convention | remote.pushDefault | default),
# REM_SKIPPED (keys a committed .onetree tried to set); memoised with the config read
remotes_resolve() {
  local m=$1 ou uu; cfg_dump "$m"
  [[ "$REM_MAIN" == "$m" ]] && return 0
  REM_SKIPPED=
  if cfg_find_clone remote "$m"; then RB=$CFG_VAL; RB_SRC=$CFG_SRC
  elif uu=$(rem_url upstream) && { ! ou=$(rem_url origin) || ! slug_same "$(url_slug "$uu")" "$(url_slug "$ou")"; }; then RB=upstream; RB_SRC=upstream-convention
  else RB=origin; RB_SRC=default; fi
  [[ -n "$CFG_SKIPPED" ]] && REM_SKIPPED="remote"
  if cfg_find_clone pushRemote "$m"; then RP=$CFG_VAL; RP_SRC=$CFG_SRC
  elif [[ -n "$REM_PUSHDEFAULT" ]]; then RP=$REM_PUSHDEFAULT; RP_SRC=remote.pushDefault
  elif [[ "$RB" == origin ]] || rem_url origin >/dev/null; then RP=origin; RP_SRC=default
  else RP=$RB; RP_SRC=default; fi
  [[ -n "$CFG_SKIPPED" ]] && REM_SKIPPED="${REM_SKIPPED:+$REM_SKIPPED }pushRemote"
  cfg_find_clone ghUser "$m" >/dev/null || true; [[ -n "$CFG_SKIPPED" ]] && REM_SKIPPED="${REM_SKIPPED:+$REM_SKIPPED }ghUser"
  REM_MAIN=$m; return 0
}
remote_slug() {  # main name -> url_slug of that remote (empty when it has no url)
  local u; u=$(rem_url "$2") || u=$(git -C "$1" config --get "remote.$2.url" 2>/dev/null) || return 0
  url_slug "$u"
}
# main -> the push remote's owner, lower case, when it is another repo than the base (a fork): PR lookups keep only
# heads from it; empty otherwise
pr_owner() {
  local b p o; remotes_resolve "$1"; [[ "$RP" != "$RB" ]] || return 0
  b=$(remote_slug "$1" "$RB"); p=$(remote_slug "$1" "$RP")
  [[ "$p" == */* && "$p" != /* && "$p" != .* ]] && ! slug_same "$b" "$p" || return 0
  o=${p%/*}; o=$(tr '[:upper:]' '[:lower:]' <<<"${o##*/}")
  [[ "$o" =~ ^[a-z0-9._-]+$ ]] && printf '%s' "$o"
  return 0
}
GHT=; GHT_MAIN=
# main — GHT: the token of this repo's onetree.ghUser (gh auth token reads it locally), so gh asks as that account;
# empty: gh's active account
gh_env() {
  [[ "$GHT_MAIN" == "$1" ]] && return 0
  GHT=; GHT_MAIN=$1
  if cfg_find_clone ghUser "$1"; then GHT=$(gh auth token --user "$CFG_VAL" 2>/dev/null) || GHT=; fi
  return 0
}
ghx() { if [[ -n "$GHT" ]]; then GH_TOKEN=$GHT gh "$@"; else gh "$@"; fi; }   # gh, as gh_env chose

INT_MAIN=; INT_VAL=
integration() {  # main — memoised per process; unset: the base remote's HEAD branch
  [[ "$INT_MAIN" == "$1" ]] && { echo "$INT_VAL"; return 0; }
  local v; remotes_resolve "$1"
  if v=$(cfg integration "$1"); then :; elif v=$(git -C "$1" symbolic-ref -q --short "refs/remotes/$RB/HEAD" 2>/dev/null); then v=${v#"$RB"/}; else v=main; fi
  INT_MAIN=$1; INT_VAL=$v; echo "$v"
}
root_of() { tilde "$(cfg root "$1" "$HOME/worktrees")"; }
prefix_of() { cfg branchPrefix "$1" "feature/"; }
guarded() { [[ "$(cfg guard "$1" false)" == true ]]; }
# opt-in: a guarded mirror locks gitignored paths too (only onetree.writable stays writable)
lock_ignored() { [[ "$(cfg lockIgnored "$1" false)" == true ]]; }
# clone-local controls: deliberately bypass .onetree and $CFG
clone_cfg() { git -C "$2" config --local --get "onetree.$1" 2>/dev/null; }
production() { [[ "$(clone_cfg production "$1" || true)" == true ]]; }
dev_clone() { local v; v=$(clone_cfg devClone "$1" || true); [[ -n "$v" ]] && tilde "$v"; return 0; }
repos_all() {  # one real path per line; paths may contain spaces
  local r
  while IFS= read -r r; do
    r=$(tilde "$r")
    [[ -e "$r/.git" ]] && printf '%s\n' "$r"
  done < <(gcfg_all onetree.repo)
  return 0
}
# cached list, so the per-tool-call guard costs one git read: cmd_guard reads it once into GUARDED_MEMO (it never refreshes it)
guarded_mains() { if [[ -n "${GUARDED_MEMO+x}" ]]; then [[ -z "$GUARDED_MEMO" ]] || printf '%s\n' "$GUARDED_MEMO"; else gcfg_all onetree.guarded; fi; }
# recompute the cache from every registered repo's effective config. Written only when it changes: a sandboxed agent
# cannot write the global config, and `new` calls this every time (#24). --check: 0 when it would write, else 1
refresh_guarded() {
  local r want="" have
  while IFS= read -r r; do
    [[ -n "$r" ]] || continue
    if guarded "$r"; then want+="$(real "$r")"$'\n'; fi
  done < <(repos_all)
  have=$(git config -f "$CFG" --get-all onetree.guarded 2>/dev/null || true)
  if [[ "${want%$'\n'}" == "$have" ]]; then [[ "${1:-}" == --check ]] && return 1; return 0; fi
  [[ "${1:-}" == --check ]] && return 0
  [[ -f "$CFG" ]] && git config -f "$CFG" --unset-all onetree.guarded 2>/dev/null || true
  while IFS= read -r r; do [[ -n "$r" ]] && git config -f "$CFG" --add onetree.guarded "$r"; done <<<"$want"
  return 0
}

# filesystem lock for guarded mains (docs/reference.md, Writable local state)
_gnu_find() { find --version >/dev/null 2>&1; }
# ---- writable local state in a guarded mirror. The lock covers what git tracks or would track; what git ignores is the working state of
# the repo's own tools (node_modules/, .husky/_/, .tsbuildinfo, .env, IDE and agent settings) and stays writable. It
# cannot carry task work: committing it takes git add -f, and mutating git is blocked here. A directory git ignores
# entirely keeps u+w and is never walked; an ignored file inside a locked directory keeps u+w and takes in-place writes
# only (its directory is locked, so writers that create a temp file and rename it — sed -i, perl -i, editors' "safe
# write" — fail, and perl -i fails silently; the guard refuses those). onetree.lockIgnored=true locks the ignored set
# too; onetree.writable then lists what stays writable (d/ = a directory). In both modes a listed entry is
# created when missing, which is the one thing the default cannot do: nothing creates a file inside a locked directory.
IGN_MAIN=; IGN_DIRS=(); IGN_FILES=()
# main — the untracked paths git ignores, from one ls-files: IGN_DIRS a directory ignored entirely (node_modules/,
# .husky/_/), IGN_FILES an ignored file whose directory holds tracked or unignored files (.env, .tsbuildinfo). Relative;
# nested entries dropped; empty with lockIgnored
ign_load() {
  local m=$1 e d
  IGN_DIRS=(); IGN_FILES=(); IGN_MAIN=$m
  lock_ignored "$m" && return 0
  while IFS= read -r -d '' e; do
    [[ -n "$e" ]] || continue
    # git lists .husky/_/ and then its files
    for d in ${IGN_DIRS[@]+"${IGN_DIRS[@]}"}; do [[ "$e" == "$d"* ]] && continue 2; done
    if [[ "$e" == */ ]]; then IGN_DIRS+=("$e"); else IGN_FILES+=("$e"); fi
  done < <(git -C "$m" ls-files -z --others --ignored --exclude-standard --directory 2>/dev/null)
  return 0
}
# main — give the ignored set back u+w where a lock took it (lockIgnored, since turned off). A directory whose top
# is writable is left alone: no lock walks into it, so what is inside is its tools' business, and node_modules is
# not walked every hour
ign_prepare() {
  local m=$1 e
  for e in ${IGN_DIRS[@]+"${IGN_DIRS[@]}"}; do
    [[ -d "$m/$e" && ! -w "$m/$e" ]] && { find "$m/${e%/}" \( -type f -o -type d \) ! -perm -200 -exec chmod u+w {} + 2>/dev/null || true; }
  done
  for e in ${IGN_FILES[@]+"${IGN_FILES[@]}"}; do
    [[ -f "$m/$e" && ! -L "$m/$e" && ! -w "$m/$e" ]] && { chmod u+w "$m/$e" 2>/dev/null || true; }
  done
  return 0
}
FG=
# a path as a find -path pattern that matches only itself; sets FG (no fork per path)
fglob() { FG=$1; FG=${FG//\\/\\\\}; FG=${FG//\*/\\*}; FG=${FG//\?/\\?}; FG=${FG//\[/\\[}; }
# main -> files a check tool creates on its first run (git hooks run tsc and eslint) that git ignores, that are missing,
# and whose directory is locked, so the tool would fail with EACCES: tsc's build info (root tsconfig*.json),
# .eslintcache, .stylelintcache
tool_caches() {
  local m=$1 f v b c d
  local -a cs=()
  for f in "$m"/tsconfig*.json; do
    [[ -f "$f" ]] || continue
    v=$(sed -n 's#^[[:space:]]*"tsBuildInfoFile"[[:space:]]*:[[:space:]]*"\([^"]*\)".*#\1#p' "$f" | head -1)
    if [[ -z "$v" ]] && grep -Eq '^[[:space:]]*"(incremental|composite)"[[:space:]]*:[[:space:]]*true' "$f" && ! grep -Eq '^[[:space:]]*"outDir"' "$f"; then
      b=${f##*/}; v=${b%.json}.tsbuildinfo   # tsc's default: next to the config when there is no outDir
    fi
    [[ -n "$v" ]] && cs+=("$v")
  done
  cs+=(.eslintcache .stylelintcache)
  for c in "${cs[@]}"; do
    while [[ "$c" == ./* ]]; do c=${c#./}; done
    case "/$c/" in //*|*/./*|*/../*|/.git/*) continue ;; esac
    [[ -e "$m/$c" || -L "$m/$c" ]] && continue
    d=$(dirname "$m/$c"); [[ -d "$d" && ! -w "$d" ]] || continue
    git -C "$m" check-ignore -q -- "$c" 2>/dev/null && printf '%s\n' "$c"
  done
  return 0
}
# main [verbose] — after a lock: create each tool_caches file empty, opening its directory for the moment. tsc 5.9 and
# eslint 10 both take
cache_prepare() {
  local m=$1 v=${2:-0} c d   # an empty cache file and rewrite it in place, which a locked directory allows
  while IFS= read -r c; do
    [[ -n "$c" && ! -e "$m/$c" ]] || continue
    d=$(dirname "$m/$c")
    if chmod u+w "$d" 2>/dev/null; then { : > "$m/$c"; } 2>/dev/null || true; chmod a-w "$d" 2>/dev/null || true; fi
    [[ -e "$m/$c" && $v == 1 ]] && printf 'onetree: created %s empty: its tool cannot create it in a locked directory, but rewrites it in place\n' "$c" >&2
  done < <(tool_caches "$m")
  return 0
}
# main -> one safe entry per line: relative, no . or .. component, outside .git, no glob characters; ./ and // squeezed
wr_entries() {
  local e v; local -a a
  cfg_find writable "$1" || return 0; v=$CFG_VAL
  read -ra a <<<"$v"
  for e in ${a[@]+"${a[@]}"}; do
    while [[ "$e" == ./* ]]; do e=${e#./}; done
    while [[ "$e" == *//* ]]; do e=${e//\/\//\/}; done
    case "/$e/" in //*|*/./*|*/../*|/.git/*|*[*?[]*) continue ;; esac
    printf '%s\n' "$e"
  done
}
# main [entries…] -> "entry<tab>reason" for each entry that would be a hole in the guard: tracked, holding tracked
# files, or not ignored
wr_problems() {
  local m=$1 e tracked ign; shift
  local -a es=(); [[ $# -gt 0 ]] && es=("$@")
  [[ $# -gt 0 ]] || { while IFS= read -r e; do [[ -n "$e" ]] && es+=("$e"); done < <(wr_entries "$m"); }
  [[ ${#es[@]} -gt 0 ]] || return 0
  # one call: every tracked file at or under an entry
  tracked=$(git -C "$m" ls-files -- "${es[@]}" 2>/dev/null || true)
  # one call: the entries git ignores (d/ asks about the directory)
  ign=$(git -C "$m" check-ignore -- "${es[@]}" 2>/dev/null || true)
  for e in "${es[@]}"; do
    if [[ "$e" == */ ]]; then
      if awk -v p="$e" 'index($0, p) == 1 { f = 1 } END { exit !f }' <<<"$tracked"; then printf '%s\ttracked files inside\n' "$e"; continue; fi
    elif grep -qxF -- "$e" <<<"$tracked"; then printf '%s\ttracked\n' "$e"; continue; fi
    grep -qxF -- "$e" <<<"$ign" || printf '%s\tnot ignored\n' "$e"
  done
  return 0
}
wr_valid() {  # main -> the entries that are safe to leave writable (wr_entries minus wr_problems), one per line
  local m=$1 e bad; bad=$(wr_problems "$m" | cut -f1)
  while IFS= read -r e; do [[ -n "$e" ]] && ! grep -qxF -- "$e" <<<"$bad" && printf '%s\n' "$e"; done < <(wr_entries "$m")
  return 0
}
# main verbose entries — before a lock: create missing entries, a directory or an empty file ({} for .json), under a
# locked parent that
wr_prepare() {
  local m=$1 v=$2 e a; shift 2   # briefly gets u+w (the lock walk takes it back), and give every entry u+w
  for e in "$@"; do
    if [[ ! -e "$m/$e" && ! -L "$m/${e%/}" ]]; then
      a=$(dirname "$m/${e%/}"); while [[ ! -d "$a" ]]; do a=$(dirname "$a"); done
      [[ -w "$a" ]] || chmod u+w "$a" 2>/dev/null || true
      if [[ "$e" == */ ]]; then mkdir -p "$m/$e" 2>/dev/null
      else mkdir -p "$(dirname "$m/$e")" 2>/dev/null && { if [[ "$e" == *.json ]]; then printf '{}\n'; fi > "$m/$e"; } 2>/dev/null; fi
      if [[ -e "$m/$e" ]]; then [[ $v == 1 ]] && printf 'onetree: created %s (listed in onetree.writable)\n' "$e" >&2; else printf 'onetree: could not create %s\n' "$m/$e" >&2; fi
    fi
    if [[ "$e" == */ ]]; then
      if [[ -d "$m/$e" ]]; then find "$m/$e" \( -type f -o -type d \) ! -perm -200 -exec chmod u+w {} + 2>/dev/null || true; fi
    elif [[ -e "$m/$e" ]]; then [[ -w "$m/$e" ]] || chmod u+w "$m/$e" 2>/dev/null || true
    fi
  done
  return 0
}
# absolute path -> the path the kernel would write: existing directories resolved physically (symlinks, ..); 1 when the
# leaf is a symlink or a . / .. follows a missing directory
phys_path() {
  local p=$1 d rest="" b
  [[ "$p" == /* ]] || return 1
  while [[ "$p" == */ && "$p" != / ]]; do p=${p%/}; done
  b=${p##*/}
  if [[ "$b" == . || "$b" == .. ]]; then d=$( (cd -P "$p" 2>/dev/null && pwd -P) ) || return 1; printf '%s' "$d"; return 0; fi
  d=${p%/*}; [[ -n "$d" ]] || d=/
  while [[ ! -d "$d" ]]; do rest="/${d##*/}$rest"; d=${d%/*}; [[ -n "$d" ]] || d=/; done
  case "$rest/" in */./*|*/../*) return 1 ;; esac
  d=$( (cd -P "$d" 2>/dev/null && pwd -P) ) || return 1; [[ "$d" == / ]] && d=
  p="$d$rest/$b"
  [[ -L "$p" ]] && return 1
  printf '%s' "$p"
}
WR_KIND=; WR_NEW=0
# main path — 0 when path is writable local state: ignored by git (so never a tracked file, and never a new file git
# would track) and, with lockIgnored, at or inside a onetree.writable entry. Resolved physically first (symlinks, ..).
# WR_KIND: in (its directory is writable too, so every writer works) or at (in-place writes only). WR_NEW=1 (refused)
# for a missing file in a locked directory
writable_ok() {
  local m=$1 p rel e k="" a
  WR_KIND=; WR_NEW=0
  p=$(phys_path "$2") || return 1
  [[ "$p" == "$m"/* ]] || return 1; rel=${p#"$m"/}
  if cfg_find writable "$m" && [[ -n "$CFG_VAL" ]]; then
    while IFS= read -r e; do
      [[ -n "$e" ]] || continue
      if [[ "$e" == */ ]]; then
        [[ "$rel" == "${e%/}" ]] && { k='at'; break; }
        [[ "$rel" == "$e"* ]] && { k='in'; break; }
      elif [[ "$rel" == "$e" ]]; then k='at'; break; fi
    done < <(wr_entries "$m")
  fi
  if [[ -z "$k" ]] && lock_ignored "$m"; then return 1; fi
  [[ -d "$p" ]] && rel="$rel/"
  # a new file under a writable directory must itself be ignored: no staging task work there
  git -C "$m" check-ignore -q -- "$rel" 2>/dev/null || return 1
  # the default: what the kernel will allow — a writable directory is one git ignores (or a listed one)
  if [[ -z "$k" ]]; then
    a=$(dirname "$p"); while [[ ! -d "$a" ]]; do a=$(dirname "$a"); done
    if [[ -w "$a" ]]; then k='in'; else k='at'; fi
  fi
  [[ $k == at && ! -e "$p" ]] && { WR_NEW=1; return 1; }
  WR_KIND=$k
}

# the Claude app's own worktrees, made there when it skips onetree's WorktreeCreate hook (an existing branch, say)
APP_WORKTREES=.claude/worktrees
# main — keep APP_WORKTREES creatable in a locked mirror: made once, pruned from the lock walk, kept out of git status
app_worktrees_prepare() {
  local m=$1 gd
  [[ -d "$HOME/.claude" && ! -d "$m/$APP_WORKTREES" ]] || return 0
  # the walk locks them again
  chmod u+w "$m" 2>/dev/null || true; [[ -d "$m/.claude" ]] && chmod u+w "$m/.claude" 2>/dev/null
  mkdir -p "$m/$APP_WORKTREES" 2>/dev/null || return 0
  git -C "$m" check-ignore -q "$APP_WORKTREES/x" && return 0
  gd=$(git -C "$m" rev-parse --path-format=absolute --git-common-dir) || return 0; mkdir -p "$gd/info"
  [[ -s "$gd/info/exclude" && -n "$(tail -c1 "$gd/info/exclude")" ]] && echo >> "$gd/info/exclude"
  echo "/$APP_WORKTREES/" >> "$gd/info/exclude"
}
# ---- the read-only lock on a guarded main, and the park lock that serialises each unlock window
# main lock|unlock|has-writable — one find, prune .git / in-tree root / other worktrees / the ignored set / valid
# writable entries, no per-file git
_chmod_walk() {
  local main=$1 action=$2 r w out
  main=$(real "$main")
  set -- find "$main" \( -name .git -prune \)
  r=$(real "$(root_of "$main")")
  [[ "$r" == "$main"/* ]] && { fglob "$r"; set -- "$@" -o \( -path "$FG" -prune \); }
  fglob "$main/$APP_WORKTREES"; set -- "$@" -o \( -path "$FG" -prune \)
  while IFS= read -r w; do
    [[ -n "$w" ]] || continue
    w=$(real "$w")
    [[ "$w" == "$main"/* ]] && { fglob "$w"; set -- "$@" -o \( -path "$FG" -prune \); }
  done < <(worktrees_of "$main")
  # never locked, so never unlocked either: no walk of node_modules on every park
  [[ "$IGN_MAIN" == "$main" ]] || ign_load "$main"
  for w in ${IGN_DIRS[@]+"${IGN_DIRS[@]}"} ${IGN_FILES[@]+"${IGN_FILES[@]}"}; do fglob "$main/${w%/}"; set -- "$@" -o \( -path "$FG" -prune \); done
  if [[ "$action" != unlock ]]; then
    while IFS= read -r w; do [[ -n "$w" ]] && { fglob "$main/${w%/}"; set -- "$@" -o \( -path "$FG" -prune \); }; done < <(wr_valid "$main")
  fi
  case "$action" in
    lock)
      if _gnu_find; then set -- "$@" -o \( \( -type f -o -type d \) -perm /222 -exec chmod a-w {} + \)
      else set -- "$@" -o \( \( -type f -o -type d \) -perm +222 -exec chmod a-w {} + \); fi
      "$@" >/dev/null 2>&1 || true ;;
    unlock)
      set -- "$@" -o \( \( -type f -o -type d \) ! -perm -200 -exec chmod u+w {} + \)
      "$@" >/dev/null 2>&1 || true ;;
    has-writable)
      if _gnu_find; then set -- "$@" -o \( \( -type f -o -type d \) -perm /222 -print \)
      else set -- "$@" -o \( \( -type f -o -type d \) -perm +222 -print \); fi
      out=$("$@" 2>/dev/null | head -1)
      [[ -n "$out" ]] ;;
  esac
}
# main [verbose] — lock what git tracks or would track; verbose (onetree init): name each dirty path, and say which are
# local state and which are leftovers
lock_main() {
  local main=$1 verbose=${2:-0} dirty e
  local -a valid=()
  main=$(real "$main")
  while IFS= read -r e; do [[ -n "$e" ]] && valid+=("$e"); done < <(wr_valid "$main")
  [[ ${#valid[@]} -gt 0 ]] && wr_prepare "$main" "$verbose" "${valid[@]}"
  app_worktrees_prepare "$main"
  ign_load "$main"; ign_prepare "$main"
  _chmod_walk "$main" lock
  if _chmod_walk "$main" has-writable; then return 1; fi
  lock_ignored "$main" || cache_prepare "$main" "$verbose"
  dirty=$(git -C "$main" status --porcelain 2>/dev/null || true)
  [[ -n "$dirty" ]] && printf 'onetree: warning: %s is guarded but dirty; move the work into a worktree with `onetree carry <slug>` (it restores main once the worktree has it), do not stash here\n' "$main" >&2
  [[ -n "$dirty" && $verbose == 1 ]] && dirty_report "$main" "$dirty" >&2
  return 0
}
# main porcelain — one line per dirty path (at most 20): writable local state is fine, anything else is a leftover
dirty_report() {
  local m=$1 line st rel n=0
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    n=$((n+1)); [[ $n -le 20 ]] || { printf 'onetree:   … and more (git -C %s status)\n' "$m"; break; }
    st=${line:0:2}; rel=${line:3}; rel=${rel#\"}; rel=${rel%\"}
    if writable_ok "$m" "$m/$rel"; then printf 'onetree:   writable  %s %s (local state)\n' "$st" "$rel"
    elif [[ "$st" == '??' ]]; then printf 'onetree:   leftover  %s %s (untracked and not ignored, so locked: commit it from a worktree (onetree carry <slug> --untracked moves it), or keep it local: onetree init --writable-add %s --exclude-writable)\n' "$st" "$rel" "$rel"
    else printf 'onetree:   leftover  %s %s\n' "$st" "$rel"; fi
  done <<<"$2"
  return 0
}
unlock_main() { local m; m=$(real "$1"); ign_load "$m"; ign_prepare "$m"; _chmod_walk "$m" unlock; return 0; }
writable_tree() {  # worktree path — u+w every regular file/dir that lacks it (post-bootstrap)
  local path=$1
  path=$(real "$path")
  find "$path" \( -name .git -prune \) -o \( \( -type f -o -type d \) ! -perm -200 -exec chmod u+w {} + \) >/dev/null 2>&1 || true
  return 0
}
main_has_writable() { _chmod_walk "$(real "$1")" has-writable; }
_git_dir() { git -C "$1" rev-parse --path-format=absolute --git-dir; }
# worktree — onetree made it (gc tells it from other tools' by this)
mark_ours() { { printf 'onetree\n' > "$(_git_dir "$1")/onetree"; } 2>/dev/null || true; }
_park_lock_stale() {  # lock — 0 when its holder is dead. A live holder is never stale, however long it takes
  local lock=$1 holder pid
  # the lock is a symlink whose target is "pid time": made in one step
  if [[ -L "$lock" ]]; then holder=$(readlink "$lock" 2>/dev/null || true)
  # a directory with a holder file is honoured too
  elif [[ -d "$lock" ]]; then holder=$(cat "$lock/holder" 2>/dev/null || true); [[ -n "$holder" ]] || return 0
  else return 1; fi
  pid=${holder%% *}
  [[ -n "$pid" ]] && ! kill -0 "$pid" 2>/dev/null
}
acquire_park_lock() {
  local gd=$1 lock
  lock="$gd/onetree-park.lock"
  if command -v flock >/dev/null 2>&1; then
    exec 9>"$gd/onetree-park.flock"
    flock -n 9 || { printf 'onetree: park lock held (%s)\n' "$gd" >&2; return 1; }
    return 0
  fi
  # the lock and its holder in one step: no moment where it exists without one
  ln -s "$$ $(date +%s)" "$lock" 2>/dev/null && return 0
  # one taker at a time, and the holder checked again once we are it:
  if _park_lock_stale "$lock" && mkdir "$lock.takeover" 2>/dev/null; then
    # another
    if _park_lock_stale "$lock"; then rm -rf "$lock"; ln -s "$$ $(date +%s)" "$lock" 2>/dev/null && { rmdir "$lock.takeover"; return 0; }; fi
    rmdir "$lock.takeover"   # taker may have replaced the dead holder already
  fi
  printf 'onetree: park lock held (%s)\n' "$gd" >&2
  return 1
}
release_park_lock() {
  local gd=$1 l="$1/onetree-park.lock"
  # never `exec 9>&- 2>/dev/null`: that redirects the shell's own stderr for good
  if command -v flock >/dev/null 2>&1; then exec 9>&-; return 0; fi
  # only our own: never another park's lock
  if [[ -L "$l" ]]; then [[ "$(readlink "$l")" == "$$ "* ]] && rm -f "$l"; else rm -rf "$l"; fi
}
with_main_unlocked() {
  local main=$1 gd st=0; shift
  gd=$(_git_dir "$main")
  acquire_park_lock "$gd" || return 1
  relock_on_exit "lock_main $(printf %q "$main") || true; release_park_lock $(printf %q "$gd")"
  unlock_main "$main" || true
  if [[ $# -gt 0 ]]; then "$@" || st=$?; fi
  lock_main "$main" || true
  release_park_lock "$gd"
  relock_on_exit ""
  return $st
}
# command — run it if onetree is killed or exits inside an unlock window, so main never stays writable; "" when the
# window closes
relock_on_exit() {
  # shellcheck disable=SC2064   # expanded now on purpose: the caller's quoted command, run later
  if [[ -n "$1" ]]; then trap "$1" EXIT; trap 'exit 143' INT TERM HUP   # exit runs the EXIT trap
  else trap - EXIT INT TERM HUP; fi
}
_porcelain_user_writable() {  # 0 if some porcelain path exists and is user-writable
  local main=$1 line rel
  while IFS= read -r -d '' line; do
    rel=${line:3}
    [[ -e "$main/$rel" && -w "$main/$rel" ]] && return 0
  done < <(git -C "$main" status --porcelain -z 2>/dev/null)
  return 1
}
# 0 if locked tree looks like a half-applied switch (decide BEFORE unlock). Only a switch onetree started counts (its
# marker is still there): a main guarded while dirty also has read-only dirty paths, and `switch -f` would throw that
# work away
half_switch_p() {
  local main=$1
  [[ -f "$(_git_dir "$main" 2>/dev/null)/onetree-switching" ]] || return 1
  [[ -n "$(git -C "$main" status --porcelain 2>/dev/null)" ]] || return 1
  git -C "$main" diff --cached --quiet 2>/dev/null || return 1
  _porcelain_user_writable "$main" && return 1
  return 0
}
apply_half_switch_repair() {
  local main=$1 int
  int=$(integration "$main"); remotes_resolve "$main"
  printf 'onetree: repairing half-applied switch on %s onto %s\n' "$(basename "$main")" "$int" >&2
  switch_int "$main" "$int" -f 2>/dev/null || git -C "$main" checkout -q -f "$int"
  rm -f "$(_git_dir "$main")/onetree-switching"
}
# main int [-f] — switch a main checkout to its integration branch. Without a local one, track <base>/<int> by name:
switch_int() {
  local m=$1 int=$2 f=${3:-}   # git's guess refuses when two remotes (a fork and its upstream) both have that branch
  if git -C "$m" show-ref -q --verify "refs/heads/$int" || ! git -C "$m" show-ref -q --verify "refs/remotes/$RB/$int"; then git -C "$m" switch -q $f "$int"
  else git -C "$m" switch -q $f -c "$int" --track "$RB/$int"; fi
}

# main path if $1 (dir or file) lies inside a guarded main checkout and not inside a linked worktree nested there
# main dir — 0 when dir is one of main's worktrees; a .git file alone proves nothing, since anyone can write one
# pointing at main
listed_worktree() {
  local w; while IFS= read -r w; do [[ -n "$w" && "$(real "$w")" == "$2" ]] && return 0; done < <(worktrees_of "$1"); return 1
}
guarded_main_of_path() {
  local p d m
  if [[ -d "$1" ]]; then p=$(real "$1"); else p=$(real "$(dirname "$1")")/$(basename "$1"); fi
  while IFS= read -r m; do
    [[ -n "$m" ]] || continue
    [[ "$p" == "$m" || "$p" == "$m"/* ]] || continue
    d=$p; [[ -d "$d" ]] || d=$(dirname "$d")
    while [[ "$d" == "$m"/* ]]; do [[ -f "$d/.git" ]] && listed_worktree "$m" "$d" && return 1; d=$(dirname "$d"); done
    echo "$m"; return 0
  done < <(guarded_mains)
  return 1
}

main_of() {  # main checkout for a registered repo name, a path, or (no arg) the repo owning $PWD
  local a=${1:-} r
  if [[ -n "$a" && "$a" != --all ]]; then
    if [[ -e "$(tilde "$a")/.git" ]]; then a=$(tilde "$a"); common=$(git -C "$a" rev-parse --path-format=absolute --git-common-dir); real "$(dirname "$common")"; return; fi
    while IFS= read -r r; do [[ -n "$r" ]] || continue; [[ "$(basename "$r")" == "$a" ]] && { real "$r"; return; }; done < <(repos_all)
    die "no registered repo named $a (onetree repos)"
  fi
  local common; common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) \
    || die "not inside a repo: pass the repo name ($(repo_names))"
  real "$(dirname "$common")"
}
repo_names() { local r; while IFS= read -r r; do [[ -n "$r" ]] && printf '%s ' "$(basename "$r")"; done < <(repos_all); }
# main
is_registered() { local r; while IFS= read -r r; do [[ -n "$r" && "$(real "$r")" == "$1" ]] && return 0; done < <(repos_all); return 1; }
ensure_registered() {  # main
  local m=$1; is_registered "$m" && return 0
  mkdir -p "$(dirname "$CFG")"; git config -f "$CFG" --add onetree.repo "$m"
  printf 'onetree: registered %s (guard off, integration %s; change with `onetree init`)\n' "$m" "$(integration "$m")" >&2
  refresh_guarded
}

# the base repo, where PRs are opened and merged; empty, never a failure, for a repo without that remote
gh_slug() { remotes_resolve "$1"; remote_slug "$1" "$RB"; }

# ---- caches (docs/snapshot.md): answers that are slow to get and change rarely, each with a TTL in seconds; --fresh ignores them
CACHE=${ONETREE_CACHE:-$HOME/.local/state/onetree/cache}
PR_TTL=${ONETREE_PR_TTL:-300}          # a PR state from gh (one call per worktree branch)
FETCH_TTL=${ONETREE_FETCH_TTL:-120}    # a fetch of a main checkout
# the doctor report, when snapshot embeds it (the walks over guarded mains are the slow part)
DOCTOR_TTL=${ONETREE_DOCTOR_TTL:-300}
cache_key() { printf '%s' "$*" | cksum | cut -d' ' -f1; }
cache_get() {  # file ttl — the file's content when it is younger than ttl seconds
  local f=$1 ttl=$2; [[ -f "$f" && "$ttl" -gt 0 ]] || return 1
  [[ $(( $(date +%s) - $(mtime "$f") )) -lt "$ttl" ]] || return 1
  cat "$f"
}
cache_put() {  # file content — atomic; never fails the caller
  local f=$1; { mkdir -p "$(dirname "$f")" && printf '%s\n' "$2" > "$f.$$" && mv -f "$f.$$" "$f"; } 2>/dev/null || true
}
# slug branch [owner] -> "STATE SHA" from gh, cached when gh answered. gh --head matches the branch name in every fork,
# so with owner (a fork clone) only a PR whose head lives in owner's repo counts
pr_fetch() {
  local out n=1 f=state,headRefOid q='.[0] | "\(.state) \(.headRefOid)"'
  [[ -n "${3:-}" ]] && { n=30; f=state,headRefOid,headRepositoryOwner; q='map(select((.headRepositoryOwner.login // "") | ascii_downcase == "'"$3"'")) | .[0] | "\(.state) \(.headRefOid)"'; }
  out=$(ghx pr list -R "$1" --head "$2" --state all --limit "$n" --json "$f" -q "$q" 2>/dev/null) || { echo "UNKNOWN -"; return; }
  [[ -z "$out" || "$out" == "null null" ]] && out="NONE -"
  cache_put "$CACHE/pr/$(cache_key "$1" "$2" ${3:+"$3"})" "$out"; echo "$out"
}
# main branch|#n -> "<STATE> <headsha>"  STATE: MERGED OPEN CLOSED NONE UNKNOWN; from the cache while younger than
# PR_TTL
pr_info() {
  # no branch, no PR to ask about
  local slug c own out; [[ -n "$2" && "$2" != "(detached)" ]] || { echo "NONE -"; return; }
  remotes_resolve "$1"; slug=$(gh_slug "$1"); [[ "$slug" == */* ]] || { echo "UNKNOWN -"; return; }
  # a review checkout of PR <n>: its number is unique on the base repo, whoever's fork the head lives in
  if [[ "$2" =~ ^#[0-9]+$ ]]; then
    c=$(cache_get "$CACHE/pr/$(cache_key "$slug" "$2")" "$PR_TTL") && { echo "$c"; return; }
    gh_env "$1"; out=$(ghx pr view "${2#\#}" -R "$slug" --json state,headRefOid -q '"\(.state) \(.headRefOid)"' 2>/dev/null) || { echo "UNKNOWN -"; return; }
    [[ -n "$out" && "$out" != "null null" ]] || out="NONE -"
    cache_put "$CACHE/pr/$(cache_key "$slug" "$2")" "$out"; echo "$out"; return
  fi
  own=$(pr_owner "$1")
  c=$(cache_get "$CACHE/pr/$(cache_key "$slug" "$2" ${own:+"$own"})" "$PR_TTL") && { echo "$c"; return; }
  gh_env "$1"; pr_fetch "$slug" "$2" "$own"
}
merged_heads() {  # main -> the head shas of the last 30 merged PRs, one per line, cached like a PR state
  local slug c f; remotes_resolve "$1"; slug=$(gh_slug "$1"); [[ "$slug" == */* ]] || return 0
  f="$CACHE/merged/$(cache_key "$slug")"
  c=$(cache_get "$f" "$PR_TTL") && { printf '%s\n' "$c"; return 0; }
  gh_env "$1"; c=$(ghx pr list -R "$slug" --state merged --limit 30 --json headRefOid -q '.[].headRefOid' 2>/dev/null) || return 0
  cache_put "$f" "$c"; printf '%s\n' "$c"
}
# main — at init: when recently merged PRs on the base repo went into another branch more often than the integration
# branch, say so with the counts. Cached like merged_heads; fail-open; no network call when gh has no token for the
# account
integration_hint() {
  local m=$1 slug f bases int n b total ni why others
  command -v gh >/dev/null 2>&1 || return 0
  remotes_resolve "$m"; slug=$(gh_slug "$m")
  [[ "$slug" == */* && "$slug" != /* && "$slug" != .* ]] || return 0   # a local path has no pull requests
  gh_env "$m"; [[ -n "$GHT" ]] || gh auth token >/dev/null 2>&1 || return 0
  f="$CACHE/bases/$(cache_key "$slug")"
  if ! bases=$(cache_get "$f" "$PR_TTL"); then
    if ! bases=$(ghx pr list -R "$slug" --state merged --limit 50 --json baseRefName -q '.[].baseRefName' 2>/dev/null); then
      cfg_find_clone ghUser "$m" && why="as $CFG_VAL" || why="as gh's active account; if another \`gh auth login\` account can see it: onetree init --gh-user <login>"
      printf 'onetree: note: gh could not list pull requests on %s (%s); PR states read UNKNOWN until it can\n' "$slug" "$why" >&2
      return 0
    fi
    cache_put "$f" "$bases"
  fi
  bases=$(grep -v '^$' <<<"$bases" || true); [[ -n "$bases" ]] || return 0
  int=$(integration "$m"); total=$(grep -c . <<<"$bases"); ni=$(grep -cxF -- "$int" <<<"$bases" || true)
  read -r n b < <(sort <<<"$bases" | uniq -c | sort -rn | head -1)
  # the most common base, not a majority: a repo may merge into a few long-lived branches
  [[ "$b" != "$int" && $n -gt $ni && $n -ge 3 ]] || return 0
  others=$(sort <<<"$bases" | uniq -c | sort -rn | awk -v b="$b" -v i="$int" '$2 != b && $2 != i { printf "%s%s %s", (k++ ? ", " : ""), $2, $1 }')
  if cfg_find integration "$m"; then why="set in $CFG_SRC config"; elif git -C "$m" symbolic-ref -q "refs/remotes/$RB/HEAD" >/dev/null 2>&1; then why="$RB/HEAD"; else why="default"; fi
  printf 'onetree: warning: %s of the last %s merged PRs on %s went into %s, %s into %s%s; integration is %s (%s). If PRs target %s: onetree init --integration %s\n' \
    "$n" "$total" "$slug" "$b" "$ni" "$int" "${others:+ (others: $others)}" "$int" "$why" "$b" "$b" >&2
}
# newline-separated mains — forget every cached answer these commands would use, so the next lookups ask again (once)
fresh_caches() {
  local m gd; rm -rf "$CACHE/pr" "$CACHE/merged" "$CACHE/bases" "$CACHE/doctor.json" 2>/dev/null || true
  while IFS= read -r m; do
    [[ -n "$m" ]] || continue
    gd=$(_git_dir "$m" 2>/dev/null) || continue; rm -f "$gd/onetree-fetched" 2>/dev/null || true
  done <<<"${1:-}"
  return 0
}
# newline-separated mains — warm the PR cache: one background job per main, each asking gh only for what the cache lacks
prefetch_prs() {
  local m pids=""
  [[ "$PR_TTL" -gt 0 ]] || return 0   # no cache to warm
  while IFS= read -r m; do
    [[ -n "$m" ]] || continue
    ( prefetch_main "$m" ) 2>/dev/null & pids="$pids $!"
  done <<<"${1:-}"
  [[ -n "$pids" ]] && wait $pids; return 0
}
# main — the merged heads, then each worktree's branch (a review checkout: the branch it was made from)
prefetch_main() {
  local m=$1 w b; remotes_resolve "$m"; [[ "$(gh_slug "$m")" == */* ]] || return 0
  merged_heads "$m" >/dev/null 2>&1 || true
  while IFS= read -r w; do
    [[ -n "$w" ]] || continue
    b=$(git -C "$w" symbolic-ref -q --short HEAD 2>/dev/null) || b=$(review_branch_of "$w")
    [[ -n "$b" ]] && { pr_info "$m" "$b" >/dev/null 2>&1 || true; }
  done < <(worktrees_of "$m")
  return 0
}
fetch_main() {  # main — fetch and prune unless done within FETCH_TTL seconds; the stamp lives in the git dir
  local m=$1 gd stamp; gd=$(_git_dir "$m" 2>/dev/null) || return 0; stamp="$gd/onetree-fetched"
  [[ -f "$stamp" && "$FETCH_TTL" -gt 0 && $(( $(date +%s) - $(mtime "$stamp") )) -lt "$FETCH_TTL" ]] && return 0
  remotes_resolve "$m"
  git -C "$m" fetch -q -p "$RB" 2>/dev/null || true; [[ "$RP" == "$RB" ]] || git -C "$m" fetch -q -p "$RP" 2>/dev/null || true
  git -C "$m" worktree prune 2>/dev/null || true
  touch "$stamp" 2>/dev/null || true
}
fetch_all() {  # newline-separated mains — every main at once
  local m pids=""
  while IFS= read -r m; do
    [[ -n "$m" ]] || continue
    ( fetch_main "$m" ) & pids="$pids $!"
  done <<<"${1:-}"
  [[ -n "$pids" ]] && wait $pids; return 0
}
doctor_cached() {  # the doctor report for a snapshot, reused within DOCTOR_TTL seconds
  local f="$CACHE/doctor.json" c
  c=$(cache_get "$f" "$DOCTOR_TTL") && { printf '%s\n' "$c"; return 0; }
  c=$(cmd_doctor --json 2>/dev/null || true); [[ -n "$c" ]] || return 0
  cache_put "$f" "$c"; printf '%s\n' "$c"
}
cat_all() { local f; for f in "$@"; do [[ -f "$f" ]] && cat "$f"; done; return 0; }
status_json_of() {  # main path -> the worktree's row as JSON
  local line branch dirty unpushed pr prhead lock live
  line=$(status_line "$1" "$2"); IFS=$'\t' read -r _ branch dirty unpushed pr prhead lock live <<<"$line"
  status_json "$1" "$2" "$branch" "$dirty" "$unpushed" "$pr" "$prhead" "$lock" "$live"
}
# main fn — run `fn main worktree` for every worktree of main at once, printing the outputs in worktree order
each_worktree() {
  local m=$1 fn=$2 w i=0 tmp; tmp=$(mktemp -d)
  while IFS= read -r w; do
    [[ -n "$w" ]] || continue
    i=$((i+1)); ( "$fn" "$m" "$w" || true ) > "$tmp/$(printf '%04d' "$i")" 2>/dev/null &
  done < <(worktrees_of "$m")
  tmark "$(basename "$m"): $fn spawned for $i worktrees"
  wait
  tmark "$(basename "$m"): $fn done"
  cat_all "$tmp"/[0-9]*; rm -rf "$tmp"
}
verdict_of() { remove_one "$1" "$2" 0 1; }   # a dry gc verdict, for each_worktree
tmark() { [[ -n "${ONETREE_TIMING:-}" ]] || return 0; printf 'onetree: %7.2fs  %s\n' "$(perl -MTime::HiRes=time -e 'printf "%.2f", time - $ENV{ONETREE_T0}' 2>/dev/null || echo "$SECONDS")" "$*" >&2; }
LSOF_MAP=   # "pid<tab>command<tab>cwd" for every process, from one lsof per run; subshells inherit it
lsof_prime() {
  [[ -n "$LSOF_MAP" ]] && return 0
  LSOF_MAP=$(lsof -a -d cwd -Fpcn 2>/dev/null | awk '/^p/{pid=substr($0,2)} /^c/{c=substr($0,2)} /^n/{print pid "\t" c "\t" substr($0,2)}' || true)
  [[ -n "$LSOF_MAP" ]] || LSOF_MAP=$'\t\t'
  dsh_prime
}
live_procs() {  # number of processes whose cwd is inside $1, and of loaded dsh sessions working there
  lsof_prime
  awk -F'\t' -v p="$1" '$3 == p || index($3, p "/") == 1 { n++ } END { print n + 0 }' <<<"$LSOF_MAP"$'\n'"$DSH_LIVE"
}
# A dsh server runs every session in one process outside the worktree, so lsof's cwd never shows them (issue #35). The
# plugin records each session's working directory, the worktrees it opened in the session's sandbox (a removed one
# would fail every write there, #22) and dsh's sessions folder; dsh holds <that>/*/<id>/session.lock open
# while the session is loaded and the kernel closes it with the process. A session is working while that lock is open
# and the session is not archived: a record alone keeps nothing. Asked with lsof, never flock: taking the lock even
# for an instant fails a resume that tries it then. A record whose lock is not open and whose folder is gone is dropped
DSH_LIVE=   # "-<tab>dsh<tab>folder" per folder a working dsh session uses, once per run; subshells inherit it
dsh_prime() {
  [[ -n "$DSH_LIVE" ]] && return 0
  DSH_LIVE=$'\t\t'
  local recs sid cwd root arch used u l held="" locks=()
  # one row per session, fields split by a record separator (read with IFS=tab would merge an empty field into the next)
  # and its folders (working directory, then the worktrees it opened) by a unit separator
  recs=$(cat "$SESSIONS"/dsh/*.json 2>/dev/null | jq -r 'select((.session // "") != "" and (.sessions // "") != "")
    | [.session, (.cwd // ""), .sessions, (.archived == true), ([.cwd] + (.opened | if type == "array" then . else [] end) | map(select(type == "string" and . != "")) | join("\u001f"))] | map(tostring | gsub("[\n\u001e]"; "")) | join("\u001e")' 2>/dev/null) || recs=""
  [[ -n "$recs" ]] || return 0
  while IFS=$'\036' read -r sid cwd root arch used; do
    for l in "$root"/*/"$sid"/session.lock; do [[ -e "$l" ]] && locks+=("$l"); done
  done <<<"$recs"
  [[ ${#locks[@]} -gt 0 ]] && held=$(lsof -Fn -- "${locks[@]}" 2>/dev/null | sed -n 's/^n//p' || true)
  while IFS=$'\036' read -r sid cwd root arch used; do
    if grep -qF -- "/$sid/session.lock" <<<"$held"; then
      [[ "$arch" == true ]] && continue
      while IFS= read -r u; do [[ -n "$u" ]] && DSH_LIVE+=$'\n'"-"$'\t'"dsh"$'\t'"$u"; done < <(tr '\037' '\n' <<<"$used")
    elif [[ -n "$cwd" && ! -d "$cwd" ]]; then rm -f "$SESSIONS/dsh/$sid.json"; fi
  done <<<"$recs"
  return 0
}
worktrees_of() { git -C "$1" worktree list --porcelain | awk '/^worktree /{print substr($0,10)}' | grep -vxF "$1" || true; }
lock_of() { git -C "$1" worktree list --porcelain | awk -v p="$2" '/^worktree /{c=substr($0,10)} /^locked/&&c==p{sub(/^locked/,"");sub(/^ /,"");print "LOCKED" ($0?": "$0:"")}'; }

# ---- review checkouts: `onetree review` leaves a detached worktree at origin/<branch>, so it holds no work of its own
review_branch_of() {  # worktree -> the branch `onetree review` made it from, when that was recorded
  local gd; gd=$(_git_dir "$1" 2>/dev/null) || return 0
  [[ -f "$gd/onetree-review" ]] && head -1 "$gd/onetree-review" 2>/dev/null
  return 0
}
# main worktree — 0 and who made it when another tool did; 1 when onetree did. Markers decide first, onetree's and then
# the other tools' (a root under ~/.codex/worktrees, or a path an event once named, must not make a Codex worktree
# onetree's). Only then does an unmarked one count as onetree's, by its review-* name, its place
# under the root or an event, and get the marker
foreign_owner() {
  local m=$1 p=$2 gd r
  gd=$(_git_dir "$p" 2>/dev/null) || return 1
  [[ -f "$gd/onetree" || -f "$gd/onetree-review" ]] && return 1
  if [[ -f "$gd/codex-thread.json" ]]; then echo "the Codex app"; return 0; fi
  if [[ "$p" == "$m/$APP_WORKTREES/"* ]]; then echo "the Claude app"; return 0; fi
  r=$(real "$(root_of "$m")")
  if is_review "$p" || [[ "$(real "$p")" == "$r"/* ]] || { [[ -f "$EVENTS" ]] && grep -F "\"path\":$(jq -n --arg p "$p" '$p')" "$EVENTS" 2>/dev/null | grep -qE '"kind":"(new|carry|review)"'; }; then
    mark_ours "$p"; return 1
  fi
  echo "a tool other than onetree"
}
is_review() {  # worktree -> 0 when `onetree review` made it: the record it leaves now, or the slug it has always used
  local gd; gd=$(_git_dir "$1" 2>/dev/null) && [[ -f "$gd/onetree-review" ]] && return 0
  [[ "$(basename "$1")" == review-* ]]
}

# path branch dirty unpushed prstate prhead lock live   (tab separated)
status_line() {
  local main=$1 path=$2 branch dirty unpushed pr int
  int=$(integration "$main"); remotes_resolve "$main"
  branch=$(git -C "$path" symbolic-ref -q --short HEAD 2>/dev/null || echo "(detached)")
  dirty=$(git -C "$path" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
  if [[ "$branch" == "(detached)" ]]; then
    # a detached HEAD has no upstream: what lives only here (a fetched PR head lives on the base)
    unpushed=$(git -C "$path" rev-list --count HEAD --not --remotes --glob='refs/onetree/pr/*' 2>/dev/null || echo '?')
    # a review checkout: the PR of the branch it was made from
    pr=$(pr_info "$main" "$(review_branch_of "$path")")
  else   # pushed: what the push remote's copy lacks; never pushed: what the base's integration branch lacks
    if git -C "$path" rev-parse -q --verify "$RP/$branch" >/dev/null 2>&1; then
      unpushed=$(git -C "$path" rev-list --count "$RP/$branch..HEAD")
    else unpushed=$(git -C "$path" rev-list --count "$RB/$int..HEAD" 2>/dev/null || echo '?'); fi
    pr=$(pr_info "$main" "$branch")
  fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$path" "$branch" "$dirty" "$unpushed" "${pr%% *}" "${pr#* }" "$(lock_of "$main" "$path")" "$(live_procs "$path")" | sed -E 's/\t\t/\t-\t/g'
}

# ---- machine-readable output (docs/snapshot.md): the facts the tables print, as JSON, for scripts and the dashboard
status_json() {  # main path branch dirty unpushed prstate prhead lock live -> one worktree object (from a status_line)
  local main=$1 path=$2 head; head=$(git -C "$path" rev-parse HEAD 2>/dev/null || true)
  jq -cn --arg path "$path" --arg repo "$(basename "$main")" --arg main "$main" --arg slug "$(basename "$path")" --arg head "$head" \
    --arg branch "$3" --arg dirty "$4" --arg unpushed "$5" --arg pr "$6" --arg prhead "$7" --arg lock "$8" --arg live "$9" '
    {path:$path, repo:$repo, main:$main, kind:"worktree", slug:$slug,
     branch:(if $branch=="(detached)" then null else $branch end), detached:($branch=="(detached)"), head:(if $head=="" then null else $head end),
     dirty:($dirty|tonumber), unpushed:($unpushed|tonumber? // null),
     pr:{state:$pr, head:(if $prhead=="-" then null else $prhead end)},
     lock:(if $lock=="-" then null else $lock end), live:($live|tonumber)}'
}
# main -> the main checkout as one object: the worktree keys plus guard, integration, behind (commits
# <base>/<integration> has that HEAD lacks)
main_json() {
  local m=$1 int branch dirty head behind
  int=$(integration "$m"); remotes_resolve "$m"
  branch=$(git -C "$m" symbolic-ref -q --short HEAD 2>/dev/null || echo "(detached)")
  dirty=$(git -C "$m" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
  head=$(git -C "$m" rev-parse HEAD 2>/dev/null || true)
  behind=$(git -C "$m" rev-list --count "HEAD..$RB/$int" 2>/dev/null || echo '?')
  jq -cn --arg path "$m" --arg repo "$(basename "$m")" --arg branch "$branch" --arg head "$head" --arg dirty "$dirty" --arg behind "$behind" \
    --arg live "$(live_procs "$m")" --argjson guard "$(guarded "$m" && echo true || echo false)" --arg int "$int" '
    {path:$path, repo:$repo, main:$path, kind:"main", slug:null,
     branch:(if $branch=="(detached)" then null else $branch end), detached:($branch=="(detached)"), head:(if $head=="" then null else $head end),
     dirty:($dirty|tonumber), unpushed:null, pr:null, lock:null, live:($live|tonumber),
     guard:$guard, integration:$int, behind:($behind|tonumber? // null)}'
}
cfg_src() {  # key main -> local | file | global | default: the layer the effective value came from (same order as cfg)
  if cfg_find "$1" "$2"; then echo "$CFG_SRC"; else echo default; fi
}
info_json() {  # main -> the effective config plus, under sources, the layer each value came from
  local m=$1 reg=false r isrc ghu="" ghs=default prod=false conflict=false dev=""
  while IFS= read -r r; do [[ -n "$r" ]] || continue; [[ "$(real "$r")" == "$m" ]] && reg=true; done < <(repos_all)
  remotes_resolve "$m"
  if cfg integration "$m" >/dev/null; then isrc=$(cfg_src integration "$m")
  elif git -C "$m" symbolic-ref -q --short "refs/remotes/$RB/HEAD" >/dev/null 2>&1; then isrc=remote-head
  else isrc=default; fi
  cfg_find_clone ghUser "$m" && { ghu=$CFG_VAL; ghs=$CFG_SRC; }
  production "$m" && prod=true; [[ $prod == true && $reg == true ]] && conflict=true; dev=$(dev_clone "$m")
  deps_state "$m" "$m"
  jq -cn --arg repo "$(basename "$m")" --arg main "$m" --argjson registered "$reg" --argjson guard "$(guarded "$m" && echo true || echo false)" \
    --arg int "$(integration "$m")" --arg root "$(root_of "$m")" --arg prefix "$(prefix_of "$m")" \
    --arg copy "$(cfg copy "$m" ".env .env.local")" --arg keep "$(cfg keep "$m" "")" --arg keepSource "$(tilde "$(cfg keepSource "$m" "$m")")" \
    --arg bootstrap "$(cfg bootstrap "$m" "")" --arg stale "$(cfg stale "$m" 24)" --argjson committed "$([[ -f "$m/.onetree" ]] && echo true || echo false)" \
    --arg remote "$RB" --arg pushRemote "$RP" --arg slug "$(gh_slug "$m")" --arg pushSlug "$(remote_slug "$m" "$RP")" --arg ghUser "$ghu" \
    --arg writable "$(wr_entries "$m" | tr '\n' ' ')" --arg ignored "$REM_SKIPPED" --argjson lockIgnored "$(lock_ignored "$m" && echo true || echo false)" \
    --argjson production "$prod" --argjson productionConflict "$conflict" --arg devClone "$dev" --arg dpm "$DEPS_PM" --arg dstate "$DEPS_STATE" --arg dwhy "$DEPS_WHY" \
    --arg s_guard "$(cfg_src guard "$m")" --arg s_int "$isrc" --arg s_root "$(cfg_src root "$m")" --arg s_prefix "$(cfg_src branchPrefix "$m")" \
    --arg s_copy "$(cfg_src copy "$m")" --arg s_keep "$(cfg_src keep "$m")" --arg s_keepSource "$(cfg_src keepSource "$m")" \
    --arg s_bootstrap "$(cfg_src bootstrap "$m")" --arg s_stale "$(cfg_src stale "$m")" \
    --arg s_remote "$RB_SRC" --arg s_pushRemote "$RP_SRC" --arg s_ghUser "$ghs" --arg s_writable "$(cfg_src writable "$m")" '
    def words: if .=="" then [] else split(" ") | map(select(.!="")) end;
    def orNull: if .=="" then null else . end;
    {repo:$repo, main:$main, registered:$registered, production:$production, productionConflict:$productionConflict, devClone:($devClone|orNull), guard:$guard, integration:$int, root:$root, worktreeDir:($root+"/"+$repo),
     branchPrefix:$prefix, copy:($copy|words), keep:($keep|words), keepSource:$keepSource,
     bootstrap:(if $bootstrap=="" then null else $bootstrap end), stale:($stale|tonumber? // null), committedFile:$committed,
     sources:{guard:$s_guard, integration:$s_int, root:$s_root, branchPrefix:$s_prefix, copy:$s_copy, keep:$s_keep,
              keepSource:$s_keepSource, bootstrap:$s_bootstrap, stale:$s_stale},
     remotes:{base:{name:$remote, source:$s_remote, slug:($slug|orNull)}, push:{name:$pushRemote, source:$s_pushRemote, slug:($pushSlug|orNull)},
              ghUser:{login:($ghUser|orNull), source:$s_ghUser}, ignoredFromFile:($ignored|words)},
     writable:{paths:($writable|words), source:$s_writable}, lockIgnored:$lockIgnored,
     deps:(if $dstate == "none" then null else {manager:$dpm, state:$dstate, detail:$dwhy} end)}'
}
# kind key=value… (key:=json for numbers and booleans) — one line appended to $EVENTS; never fails the caller
log_event() {
  local kind=$1 kv; shift
  [[ -n "${ONETREE_NO_EVENTS:-}" ]] && return 0
  local args=(--arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --argjson t "$(date +%s)" --arg kind "$kind" --arg cmd "$ONETREE_CMD")
  for kv in "$@"; do
    if [[ "$kv" == *:=* ]]; then args+=(--argjson "${kv%%:=*}" "${kv#*:=}"); else args+=(--arg "${kv%%=*}" "${kv#*=}"); fi
  done
  { mkdir -p "$(dirname "$EVENTS")" && jq -cn "${args[@]}" '$ARGS.named' >> "$EVENTS"; } 2>/dev/null || true
}
GC_JSON=0   # 1: gc verdicts as JSON objects instead of log lines (gc --json, snapshot)
GC_KEPT=0; GC_REMOVED=0; GC_PARKED=0; GC_FF=0   # tallied by gc_out / park_out for the gc-run event
# action code reason — a verdict on the worktree remove_one is looking at (reads its locals); the text form is the log
# line gc always wrote
gc_out() {
  local action=$1 code=$2 reason=$3
  case "$action" in
    keep) GC_KEPT=$((GC_KEPT+1)) ;;
    remove) GC_REMOVED=$((GC_REMOVED+1)); log_event gc action=remove "code=$code" "reason=$reason" "path=$path" "repo=$(basename "$main")" "branch=$branch" ;;
  esac
  if [[ $GC_JSON == 1 ]]; then
    status_json "$main" "$path" "$branch" "$dirty" "$unpushed" "$pr" "$prhead" "$lock" "$live" \
      | jq -c --arg action "$action" --arg code "$code" --arg reason "$reason" '. + {gc:{action:$action, code:$code, reason:$reason}}'
    return 0
  fi
  case "$action" in
    keep) echo "keep $path: $reason" ;;
    would-remove) echo "would remove $path ($reason)" ;;
    remove) echo "removed $path ($reason)" ;;
  esac
}
# main action code reason — a verdict on a main checkout; `none` prints nothing
park_out() {
  local main=$1 action=$2 code=$3 reason=$4 repo; repo=$(basename "$main")
  case "$action" in
    parked) GC_PARKED=$((GC_PARKED+1)); log_event park "action=$action" "code=$code" "reason=$reason" "main=$main" "repo=$repo" ;;
    fast-forwarded) GC_FF=$((GC_FF+1)); log_event park "action=$action" "code=$code" "reason=$reason" "main=$main" "repo=$repo" ;;
  esac
  if [[ $GC_JSON == 1 ]]; then
    jq -cn --arg main "$main" --arg repo "$repo" --arg action "$action" --arg code "$code" --arg reason "$reason" \
      '{path:$main, repo:$repo, kind:"main", park:{action:$action, code:$code, reason:$reason}}'
    return 0
  fi
  case "$action" in
    leave) echo "park $repo: $reason" ;;
    would-park) echo "would park $repo: $reason" ;;
    parked) echo "parked $repo: $reason" ;;
    fast-forwarded) echo "fast-forwarded $repo $reason" ;;
  esac
}

# ---- agents: which agent sessions are alive and where they sit (docs/snapshot.md)
AGENT_JQ='(.agent // (.transcript_path // "" | if test("/\\.claude/") then "claude" elif test("/\\.codex/") then "codex" elif test("/\\.pi/") then "pi" elif test("/\\.dsh/") then "dsh" else "" end))'
# hook json -> claude | codex | pi | dsh | unknown: what the payload says, else where its transcript lives
agent_from_payload() {
  local a; a=$(jq -r "$AGENT_JQ" <<<"$1" 2>/dev/null) || a=
  if [[ -n "$a" ]]; then echo "$a"; else echo unknown; fi
}
agent_pid() {  # the nearest ancestor of this process that is not a shell: the agent that ran the hook
  local p=$PPID c i
  for i in 1 2 3 4 5 6 7 8; do
    [[ "$p" =~ ^[0-9]+$ && "$p" != 0 && "$p" != 1 ]] || { echo ""; return 0; }
    c=$(ps -o comm= -p "$p" 2>/dev/null | tr -d ' '); c=${c##*/}
    case "$c" in sh|bash|zsh|dash|fish|ksh|"") p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ') ;; *) echo "$p"; return 0 ;; esac
  done
  echo ""
}
# hook json — remember which process is which agent session (ONETREE_SESSION_PID overrides the walk); never fails
record_session() {
  local j=$1 pid sid agent cwd
  pid=${ONETREE_SESSION_PID:-$(agent_pid)}; [[ "$pid" =~ ^[0-9]+$ ]] || return 0
  sid=$(jq -r '.session_id // empty' <<<"$j" 2>/dev/null) || sid=
  agent=$(agent_from_payload "$j"); cwd=$(jq -r '.cwd // empty' <<<"$j" 2>/dev/null) || cwd=
  { mkdir -p "$SESSIONS" && jq -cn --argjson pid "$pid" --arg session "$sid" --arg agent "$agent" --arg cwd "${cwd:-$PWD}" \
      --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --argjson t "$(date +%s)" \
      '{pid:$pid, session:(if $session=="" then null else $session end), agent:$agent, cwd:$cwd, recordedAt:$at, recorded:$t}' > "$SESSIONS/$pid.json"; } 2>/dev/null || true
  # dsh: one server holds every session, so each also gets its own record, for gc (dsh_prime). One without cwd (the
  # plugin's archive mark) keeps the folder recorded before
  if [[ "$agent" == dsh && "$sid" =~ ^[A-Za-z0-9._-]+$ ]]; then
    # each write merges into the last, and the plugin starts several at once (a new worktree opened, the working
    # directory moved): one at a time, or one drops the other's fields. A lock left by a killed writer is taken after 5 s
    local f="$SESSIONS/dsh/$sid.json" old='{}' i=0
    mkdir -p "$SESSIONS/dsh" 2>/dev/null || return 0
    until mkdir "$f.lock" 2>/dev/null; do
      i=$((i+1)); if [[ $i -ge 50 ]]; then rm -rf "$f.lock"; mkdir "$f.lock" 2>/dev/null || return 0; break; fi
      sleep 0.1
    done
    [[ -f "$f" ]] && old=$(<"$f")
    { jq -cn --argjson old "$old" --argjson new "$j" --argjson pid "$pid" --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        '$old + ($new | {session: .session_id, cwd, sessions: .dsh_sessions, opened} | with_entries(select(.value != null and .value != "")))
         + (if $new | has("archived") then {archived: ($new.archived == true)} else {} end)
         + {agent: "dsh", pid: $pid, recordedAt: $at}' > "$f.$$" && mv "$f.$$" "$f"; } 2>/dev/null || rm -f "$f.$$"
    rmdir "$f.lock" 2>/dev/null || true
  fi
  return 0
}
AGENT=
# exe argv — sets AGENT to claude | codex | pi | dsh | "": process name, else an interpreter judged by its script; a
# Codex Desktop thread is its cua-repl.mjs controller, not every cua_node helper
agent_of() {
  local exe=$1 argv=$2 base=${1##*/} w1=${2%% *} c; w1=${w1##*/}; AGENT=
  for c in "$base" "$w1"; do case "$c" in claude|claude-code) AGENT=claude; return 0 ;; codex) AGENT=codex; return 0 ;; pi) AGENT=pi; return 0 ;; dsh) AGENT=dsh; return 0 ;; esac; done
  # Claude Code's versioned binary
  [[ "$base" =~ ^[0-9]+(\.[0-9]+)+$ && "$exe" == *claude* ]] && { AGENT=claude; return 0; }
  # Codex Desktop: one controller per thread; node_repl / template-picker / server.mjs helpers are not sessions
  case "$argv" in *"/@oai/cua-repl/bin/cua-repl.mjs"*) AGENT=codex; return 0 ;; esac
  case "$base" in node|node_repl|bun|deno|python*) ;; *)
    # macOS comm is often truncated; the first argv word still names the interpreter
    case "$w1" in node|node_repl|bun|deno|python*) ;; *) return 0 ;; esac
  esac
  case "$argv" in
    *"/pi/"*|*"/bin/pi "*|*" pi "*) AGENT=pi ;;
    # …/deepseek-harness/apps/cli/: dsh run from its source checkout (`pnpm dsh`, a wrapper that execs node on it)
    *"/dsh/"*|*"/bin/dsh "*|*" dsh "*|*"@deepseek-ai/dsh"*|*"/deepseek-harness/apps/cli/"*) AGENT=dsh ;;
    *"/codex/"*|*"/bin/codex "*) AGENT=codex ;;
    *"/claude-code/"*|*"/.claude/"*|*"/bin/claude "*) AGENT=claude ;;
  esac
  return 0
}
# A host fixes a session's folder when the session starts; after `onetree new` only the Claude desktop app can follow
# (change_directory). The Claude CLI could with EnterWorktree, but that binds the session to the worktree and Claude
# Code then refuses any shell command it cannot prove stays inside it, subagents included (the `claude -w` of #52), so
# Claude, Codex, pi and dsh are all told to name the worktree in their commands. host_of tells them apart for the hint onetree prints; the
# process decides the agent (a Codex started from a Claude shell inherits Claude's environment), the environment only
# the flavour. -> claude-app | claude-cli | claude-ide | claude-sdk | codex-app | codex-cli | pi | dsh, or nothing for a
# person
host_of() {
  [[ -n "${ONETREE_HOST:-}" ]] && { printf '%s\n' "$ONETREE_HOST"; return 0; }
  local p argv=""; p=${ONETREE_SESSION_PID:-$(agent_pid)}; AGENT=
  if [[ "$p" =~ ^[0-9]+$ ]]; then argv=$(ps -ww -o command= -p "$p" 2>/dev/null || true); agent_of "$(ps -o comm= -p "$p" 2>/dev/null || true)" "$argv"; fi
  # the walk ended at timeout, nice, make…
  # dsh gives each shell command it runs DSH_SESSION_ID, however dsh itself was started (`pnpm dsh web` is
  # `node … apps/cli/src/bin.ts`: nothing in its argv says dsh). It is the innermost of the three, so it is asked last
  if [[ -z "$AGENT" ]]; then [[ "${CLAUDECODE:-}" == 1 ]] && AGENT=claude; [[ -n "${CODEX_THREAD_ID:-}" ]] && AGENT=codex; [[ -n "${DSH_SESSION_ID:-}" ]] && AGENT=dsh; fi
  case "$AGENT" in
    claude) case "${CLAUDE_CODE_ENTRYPOINT:-}" in claude-desktop*) echo claude-app ;; claude-vscode*|*jetbrains*) echo claude-ide ;; sdk-*|mcp|*github-action*) echo claude-sdk ;; *) echo claude-cli ;; esac ;;
    codex) if [[ "$argv" == *" app-server"* ]]; then echo codex-app; else echo codex-cli; fi ;;
    pi|dsh) echo "$AGENT" ;;
  esac
  return 0
}
SKEY_SESSION=; SKEY_PID=; SKEY_START=
# host — how a later hook call finds this agent session again: its session id, and its pid with the pid's start time (a
# reused pid is another process). The Codex app-server and dsh's web server serve many sessions: no pid
session_key() {
  SKEY_SESSION=; SKEY_PID=; SKEY_START=
  case "$1" in claude-*) SKEY_SESSION=${CLAUDE_CODE_SESSION_ID:-} ;; codex-*) SKEY_SESSION=${CODEX_THREAD_ID:-} ;; dsh) SKEY_SESSION=${ONETREE_SESSION_ID:-${DSH_SESSION_ID:-}} ;; ?*) SKEY_SESSION=${ONETREE_SESSION_ID:-} ;; esac
  case "$1" in ""|codex-app|dsh) return 0 ;; esac
  SKEY_PID=${ONETREE_SESSION_PID:-$(agent_pid)}; [[ "$SKEY_PID" =~ ^[0-9]+$ ]] || { SKEY_PID=; return 0; }
  SKEY_START=$(ps -o lstart= -p "$SKEY_PID" 2>/dev/null | tr -s ' ' || true)
  return 0
}
# session pid [main] — the worktrees (of main, if given) that this agent session made (onetree new, carry), newest
# first, each once, still there
bound_worktrees() {
  local s=$1 p=$2 m=$3 st="" w
  [[ -n "$s$p" && -f "$EVENTS" ]] || return 0
  [[ "$p" =~ ^[0-9]+$ ]] && st=$(ps -o lstart= -p "$p" 2>/dev/null | tr -s ' ' || true)
  grep -F '"kind":"new"' "$EVENTS" 2>/dev/null | jq -r --arg s "$s" --arg p "$p" --arg st "$st" \
      'select((.subagent // "") == "") | select(($s != "" and .session == $s) or ($st != "" and (.pid | tostring) == $p and .pidStart == $st)) | .path' 2>/dev/null |
    awk '{ a[NR] = $0 } END { for (i = NR; i >= 1; i--) if (!seen[a[i]]++) print a[i] }' |
    while IFS= read -r w; do [[ -d "$w" ]] && { [[ -z "$m" || "$(git -C "$w" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" == "$m/.git" ]]; } && echo "$w"; done
  return 0
}
# word — as a shell reads it back: left as it is when nothing in it is special (a <placeholder> too), else single-quoted
shq() {
  local s=$1
  if [[ "$s" == "<path>" || "$s" =~ ^[A-Za-z0-9_./~@%+=:,-]+$ ]]; then printf '%s' "$s"; return 0; fi
  s=${s//\'/\'\\\'\'}; printf "'%s'" "$s"
}
# dir main — the worktree of main that dir is in, if it is in one: read from git, no record of who made it
worktree_at() { local t; [[ -n "$1" ]] && t=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null) && t=$(real "$t") && listed_worktree "$2" "$t" && printf '%s\n' "$t"; }
# host path main — one paragraph: how the agent in that host works in path from here on. Tool arguments and Codex's /cd
move_hint() {
  local p=$2 m=$3 q   # take the path as it is; in a shell command it is quoted
  q=$(shq "$p")
  case "$1" in
    claude-subagent) printf "prefix every command with \`cd %s &&\` and edit by absolute path: a subagent stays in the folder it started in (\`change_directory\` moves only the main conversation)." "$q" ;;
    claude-app) printf "call \`change_directory\` with %s (the main conversation, never a subagent): the app's file pane, diff, terminal and PR card move there when this turn ends, which \`EnterWorktree\` would not do. Until then use absolute paths, or \`cd %s &&\` before each command." "$p" "$q" ;;
    # never EnterWorktree: like `claude -w` it binds the session, and Claude then refuses shell it cannot verify (#52)
    claude-*) printf "prefix every command with \`cd %s &&\` and edit by absolute path. Do not call \`EnterWorktree\`: from then on Claude Code refuses any shell command it cannot prove stays inside that one worktree, in this session and in its subagents." "$q" ;;
    codex-cli) printf "prefix every command with \`cd %s &&\` (onetree's hook judges the command, never \`workdir\`) and give apply_patch absolute paths under it. To move this thread itself, ask the user to type \`/cd %s\`." "$q" "$p" ;;
    codex-app) printf "prefix every command with \`cd %s &&\` (onetree's hook judges the command, never \`workdir\`) and give apply_patch absolute paths under it. This thread's review pane stays on %s; to review the work in the app, ask the user to open a new thread on %s." "$q" "$m" "$p" ;;
    pi) printf "nothing to do: onetree's pi extension runs this session's commands in %s from now on, and relative paths in read, write and edit resolve there." "$p" ;;
    # dsh-moved: the working directory the dsh plugin sent is inside the worktree (the plugin moved it there, or the
    # session was started there); dsh: it is not. The session's folder in the web UI never changes
    dsh-moved) printf "leave \`workdir\` out of bash calls and give file tools paths under it: this session works in %s, though the web UI may still list it under %s." "$p" "$m" ;;
    dsh) printf "pass \`workdir\` %s to every bash call and give file tools absolute paths under it: this session's working directory is not there, and the web UI keeps it under %s." "$p" "$m" ;;
    *) printf "prefix every command with \`cd %s &&\` and edit by absolute path (in the Claude desktop app, \`change_directory\` with that path)." "$q" ;;
  esac
}
# path main — after new, carry or review run by an agent: how it works there now. Nothing for a person, a wrapper or a
# hook
next_step() {
  local h; h=$(host_of); [[ -n "$h" ]] || return 0
  printf 'onetree: next, %s\n' "$(move_hint "$h" "$1" "$2")" >&2
}
SECS=0
etime_secs() {  # ps etime [[dd-]hh:]mm:ss — sets SECS
  local e=${1// /} d=0 a b c
  [[ "$e" == *-* ]] && { d=${e%%-*}; e=${e#*-}; }
  a=${e%%:*}; c=${e##*:}; b=${e#*:}; b=${b%:*}
  if [[ "$e" == *:*:* ]]; then SECS=$(( 10#$d*86400 + 10#$a*3600 + 10#$b*60 + 10#$c )); else SECS=$(( 10#$d*86400 + 10#${a:-0}*60 + 10#${c:-0} )); fi
  return 0
}
iso_of() { date -u -r "$1" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -d "@$1" +%Y-%m-%dT%H:%M:%SZ; }
locations() {  # kind main path — every registered main and each of its worktrees, one per line
  local m w
  while IFS= read -r m; do
    [[ -n "$m" ]] || continue
    m=$(real "$m"); printf 'main\t%s\t%s\n' "$m" "$m"
    while IFS= read -r w; do
      [[ -n "$w" ]] || continue
      printf 'worktree\t%s\t%s\n' "$m" "$w"
    done < <(worktrees_of "$m")
  done < <(repos_all)
}
# cwd locations -> the innermost location containing cwd, as kind<tab>main<tab>path; nothing when outside every repo
locate() {
  local cwd=$1 best="" bestlen=0 kind main path
  while IFS=$'\t' read -r kind main path; do
    [[ -n "$path" ]] || continue
    [[ "$cwd" == "$path" || "$cwd" == "$path"/* ]] || continue
    [[ ${#path} -gt $bestlen ]] && { best="$kind"$'\t'"$main"$'\t'"$path"; bestlen=${#path}; }
  done <<<"$2"
  printf '%s' "$best"
}
# [--json] — live agent sessions and where they sit; a process counts when its name says agent, the SessionStart hook
# recorded it, or it is a Codex Desktop cua-repl controller
cmd_agents() {
  local json=0 a f pid cwd kind main path sess agent argv exe etime now rows="" cands="" pidlist="" sesspids="" psinfo pscmd joined line us=$'\x1f'
  for a in "$@"; do [[ $a == --json ]] && json=1 || die "agents: unknown option $a"; done
  # forget dead sessions
  if [[ -d "$SESSIONS" ]]; then for f in "$SESSIONS"/*.json; do [[ -f "$f" ]] || continue; pid=$(basename "$f" .json); if kill -0 "$pid" 2>/dev/null; then sesspids="$sesspids $pid"; else rm -f "$f"; fi; done; fi
  local locs; locs=$(locations); now=$(date +%s); lsof_prime; tmark "agents: locations and lsof"
  cands=$(awk -F'\t' -v OFS='\t' -v sess=" $sesspids " '   # candidates: a cwd inside a registered repo (the innermost one wins), or a session the hook recorded
    NR == FNR { if ($3 != "") { n++; kind[n] = $1; main[n] = $2; path[n] = $3; len[n] = length($3) }; next }
    $1 ~ /^[0-9]+$/ {
      best = 0; bl = 0
      for (i = 1; i <= n; i++) if ($3 == path[i] || substr($3, 1, len[i] + 1) == path[i] "/") if (len[i] > bl) { best = i; bl = len[i] }
      if (best) print $1, $3, kind[best], main[best], path[best]
      else if (index(sess, " " $1 " ")) print $1, $3, "", "", ""
    }' <(printf '%s\n' "$locs") <(printf '%s\n' "$LSOF_MAP"))
  [[ -n "$cands" ]] || { [[ $json == 1 ]] && echo '[]'; return 0; }
  pidlist=$(printf '%s\n' "$cands" | cut -f1 | tr '\n' ',' | sed 's/,$//')
  psinfo=$(ps -o pid=,etime=,comm= -p "$pidlist" 2>/dev/null || true)   # two ps calls cover every candidate
  pscmd=$(ps -o pid=,command= -p "$pidlist" 2>/dev/null || true)
  joined=$(awk -F'\t' -v OFS='\t' '   # candidate rows joined with what ps knows: etime, executable, argv
    FNR == 1 { f++ }
    f == 1 { l = $0; sub(/^ +/, "", l); p = l; sub(/ .*/, "", p); sub(/^[0-9]+ +/, "", l); e = l; sub(/ .*/, "", e); sub(/^[^ ]+ +/, "", l); etime[p] = e; exe[p] = l; next }
    f == 2 { l = $0; sub(/^ +/, "", l); p = l; sub(/ .*/, "", p); sub(/^[0-9]+ +/, "", l); gsub(/\t/, " ", l); cmd[p] = substr(l, 1, 200); next }
    ($1 in etime) { print $1, $2, $3, $4, $5, etime[$1], exe[$1], cmd[$1] }' <(printf '%s\n' "$psinfo") <(printf '%s\n' "$pscmd") <(printf '%s\n' "$cands"))
  tmark "agents: candidates and ps"
  # Tab is IFS whitespace, so `read` collapses the empty kind/main/path of a session outside every repo and the elapsed
  # time lands in kind. A non-whitespace separator keeps the empty fields.
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    IFS=$us read -r pid cwd kind main path etime exe argv <<<"${line//$'\t'/$us}"
    [[ -n "$pid" ]] || continue
    sess=""; [[ -f "$SESSIONS/$pid.json" ]] && { sess=$(<"$SESSIONS/$pid.json"); sess=${sess//$'\t'/ }; }
    agent_of "$exe" "$argv"; agent=$AGENT
    [[ -n "$agent" ]] || { [[ -n "$sess" ]] && agent=$(jq -r '.agent // empty' <<<"$sess" 2>/dev/null || true); }
    [[ -n "$agent" || -n "$sess" ]] || continue     # a shell, an editor, a build: not a session
    [[ -n "$agent" ]] || agent=unknown
    etime_secs "$etime"
    rows+="$pid"$'\t'"$agent"$'\t'"$sess"$'\t'"$argv"$'\t'"${exe##*/}"$'\t'"$cwd"$'\t'"$kind"$'\t'"$main"$'\t'"$path"$'\t'"$(( now - SECS ))"$'\n'
  done <<<"$joined"
  tmark "agents: rows"
  local out; out=$(printf '%s' "$rows" | jq -Rs '   # one jq for every row, not one per row
    split("\n") | map(select(length > 0) | split("\t")) | map(
      {pid: (.[0]|tonumber), agent: .[1], session: (if .[2] == "" then null else (.[2]|fromjson|.session) end), command: .[3], exe: .[4], cwd: .[5],
       kind: (if .[6] == "" then null else .[6] end), repo: (if .[7] == "" then null else (.[7]|split("/")|last) end),
       main: (if .[7] == "" then null else .[7] end), path: (if .[8] == "" then null else .[8] end),
       slug: (if .[6] == "worktree" then (.[8]|split("/")|last) else null end), started: (.[9]|tonumber), startedAt: (.[9]|tonumber|todate)})
    | sort_by(.started)' 2>/dev/null || echo '[]')
  if [[ $json == 1 ]]; then printf '%s\n' "$out"; return 0; fi
  [[ "$out" != "[]" ]] || return 0
  { printf 'PID\tAGENT\tSESSION\tREPO\tKIND\tWHERE\tSINCE\tCOMMAND\n'
    jq -r '.[] | [(.pid|tostring), .agent, (.session // "-"), (.repo // "-"), (.kind // "-"), (.path // .cwd), .startedAt, (.command[0:60])] | @tsv' <<<"$out"; } | tbl
}

# ---- dependencies: is an installed node_modules what a lockfile asks for? npm records what it installed in node_modules/.package-lock.json,
# compared entry by entry: the same version and source (integrity; resolved where there is none, as for a git
# dependency), and the package's directory still there. pnpm keeps the lockfile it installed from in
# node_modules/.pnpm/lock.yaml. yarn and bun record nothing comparable.
DEPS_PM=; DEPS_STATE=; DEPS_WHY=
deps_state() {  # installed-dir lock-dir — <installed-dir>/node_modules against <lock-dir>'s lockfile. DEPS_STATE: none (no package.json), absent (no
  # node_modules), current, stale, unknown; DEPS_WHY says why in a few words, with the counts for npm
  local d=$1 l=$2 r ok miss chg opt k
  DEPS_PM=; DEPS_STATE=none; DEPS_WHY="no package.json"
  [[ -f "$l/package.json" ]] || return 0
  if [[ -f "$l/pnpm-lock.yaml" ]]; then DEPS_PM=pnpm; elif [[ -f "$l/yarn.lock" ]]; then DEPS_PM=yarn; elif [[ -f "$l/bun.lock" || -f "$l/bun.lockb" ]]; then DEPS_PM=bun; else DEPS_PM=npm; fi
  [[ -d "$d/node_modules" ]] || { DEPS_STATE=absent; DEPS_WHY="no node_modules"; return 0; }
  DEPS_STATE=unknown
  case $DEPS_PM in
    npm)
      [[ -f "$l/package-lock.json" ]] || { DEPS_WHY="no package-lock.json"; return 0; }
      [[ -f "$d/node_modules/.package-lock.json" ]] || { DEPS_WHY="no node_modules/.package-lock.json, so npm did not record what it installed"; return 0; }
      r=$(jq -n -r --slurpfile want "$l/package-lock.json" --slurpfile have "$d/node_modules/.package-lock.json" '
        if ($want[0].packages | type) != "object" then "unknown" else
        ($want[0].packages | del(.[""])) as $w | ($have[0].packages // {}) as $h
        | reduce ($w | to_entries[]) as $e ({ok:0, missing:0, changed:0, optional:0, dirs:[]};
            $e.value as $v | $h[$e.key] as $i
            | if $i == null then (if $v.optional == true then .optional += 1 else .missing += 1 end)
              elif (($v.version // null) != null and $i.version != $v.version)
                or ($v.integrity != null and $i.integrity != null and $i.integrity != $v.integrity)
                or ($v.integrity == null and $v.resolved != null and $i.resolved != null and $i.resolved != $v.resolved) then .changed += 1
              else .ok += 1 | if $v.optional == true then . else .dirs += [$e.key] end end)
        | "\(.ok) \(.missing) \(.changed) \(.optional)", .dirs[] end' 2>/dev/null) || { DEPS_WHY="could not read the lockfiles"; return 0; }
      [[ "$r" != unknown ]] || { DEPS_WHY="package-lock.json predates lockfileVersion 2"; return 0; }
      { read -r ok miss chg opt
        # recorded, but its directory is gone
        while IFS= read -r k; do [[ -z "$k" || -d "$d/$k" ]] || { ok=$((ok - 1)); miss=$((miss + 1)); }; done
      } <<<"$r"
      if [[ $miss == 0 && $chg == 0 ]]; then DEPS_STATE=current; DEPS_WHY="$ok installed$([[ $opt -gt 0 ]] && printf ', %s optional not installed' "$opt")"
      else DEPS_STATE=stale; DEPS_WHY="$miss missing, $chg at another version or source, of $((ok + miss + chg + opt)) in package-lock.json"; fi ;;
    pnpm)
      if cmp -s "$l/pnpm-lock.yaml" "$d/node_modules/.pnpm/lock.yaml"; then DEPS_STATE=current; DEPS_WHY="installed from this pnpm-lock.yaml"
      elif [[ -f "$d/node_modules/.pnpm/lock.yaml" ]]; then DEPS_WHY="node_modules/.pnpm/lock.yaml differs from pnpm-lock.yaml"
      else DEPS_WHY="no node_modules/.pnpm/lock.yaml"; fi ;;
    *) DEPS_WHY="$DEPS_PM records nothing onetree can compare" ;;
  esac
  return 0
}
# main — what is working in main right now, from a fresh lsof: "pid name" for each process whose cwd is inside it,
# except the shells and
main_busy() {
  local m=$1 pid c cwd exe   # agent sessions that merely sit there. A git hook running there shows as git, node, tsc…
  LSOF_MAP=; lsof_prime
  while IFS=$'\t' read -r pid c cwd; do
    [[ "$pid" =~ ^[0-9]+$ && ( "$cwd" == "$m" || "$cwd" == "$m"/* ) ]] || continue
    exe=$(ps -o comm= -p "$pid" 2>/dev/null) || continue   # gone already, like the lsof that listed it
    case "${exe##*/}" in sh|bash|zsh|dash|fish|ksh|tcsh|-*) continue ;; esac
    agent_of "$exe" "$(ps -o command= -p "$pid" 2>/dev/null)"; [[ -n "$AGENT" ]] && continue
    printf '%s %s\n' "$pid" "${exe##*/}"
  done <<<"$LSOF_MAP"
  return 0
}
# main — one refresh per main at a time: they share the scratch directory, so the one that loses the lock touches
# nothing
deps_refresh() {
  local gd l h; gd=$(_git_dir "$1" 2>/dev/null) || return 0; l="$gd/onetree-deps.lock"
  if ! mkdir "$l" 2>/dev/null; then
    h=$(cat "$l/holder" 2>/dev/null || true)
    if [[ -n "$h" ]]; then kill -0 "${h%% *}" 2>/dev/null && return 0   # another refresh is running
    # made a moment ago, its holder not written yet
    elif [[ $(( $(date +%s) - $(mtime "$l") )) -lt 60 ]]; then return 0; fi
    # never removed here: two refreshes could both take it over
    deps_out "$1" stuck "a dependency refresh died holding $l; once no onetree gc or park is running, rm -rf $l, then onetree park"
    return 0
  fi
  printf '%s %s\n' "$$" "$(date +%s)" > "$l/holder"
  _deps_refresh "$1"; rm -rf "$l"; return 0
}
# main — a guarded main whose npm node_modules is stale against its own lockfile: npm ci into a scratch directory in the
# git dir, check it, then swap it in. A failure leaves the old node_modules as it was; gc retries only once the lockfile
# changes, `onetree park` always. Deferred while something works in main
_deps_refresh() {
  local m=$1 gd s h out was rw=0 moved=0 placed=0 busy
  gd=$(_git_dir "$m" 2>/dev/null) || return 0; s="$gd/onetree-deps"
  if [[ -e "$s/old" ]]; then deps_out "$m" stuck "an earlier swap could not finish: the previous node_modules is at $s/old; move it back to $m/node_modules (or delete it), then onetree park"; return 0; fi
  # nothing installed here, or locked (onetree.lockIgnored)
  [[ -d "$m/node_modules" && -w "$m/node_modules" && -f "$m/package-lock.json" ]] || return 0
  deps_state "$m" "$m"; [[ "$DEPS_PM" == npm && "$DEPS_STATE" == stale ]] || return 0
  # node_modules in several places: left to you
  grep -q '"workspaces"' "$m/package.json" && return 0
  # an uncommitted lockfile is someone's work in progress
  git -C "$m" diff --quiet HEAD -- package.json package-lock.json 2>/dev/null || return 0
  command -v npm >/dev/null 2>&1 || return 0
  was=$DEPS_WHY
  h=$(cat "$m/package.json" "$m/package-lock.json" | cksum | cut -d' ' -f1)
  [[ -z "${DEPS_FORCE:-}" && "$(cat "$gd/onetree-deps-failed" 2>/dev/null)" == "$h" ]] && return 0
  busy=$(main_busy "$m"); [[ -z "$busy" ]] || { deps_out "$m" deferred "$(busy_text "$busy")"; return 0; }
  rm -rf "$s"; mkdir -p "$s" || return 0
  cp "$m/package.json" "$m/package-lock.json" "$s/"; [[ -f "$m/.npmrc" ]] && cp "$m/.npmrc" "$s/"
  if ! out=$( { cd "$s" && npm ci --ignore-scripts; } 2>&1 ); then deps_out "$m" failed "npm ci --ignore-scripts failed: $(grep -m1 -iE 'err|error|40[0-9]' <<<"$out" || head -1 <<<"$out")" "$h"; rm -rf "$s"; return 0; fi
  deps_state "$s" "$s"
  [[ "$DEPS_STATE" == current ]] || { deps_out "$m" failed "the fresh install does not match package-lock.json ($DEPS_WHY)" "$h"; rm -rf "$s"; return 0; }
  # renaming node_modules needs its directory, the locked root, writable for a moment
  acquire_park_lock "$gd" 2>/dev/null || { rm -rf "$s"; return 0; }
  busy=$(main_busy "$m")   # again, right before the swap: the install took a while
  if [[ -n "$busy" ]]; then release_park_lock "$gd"; rm -rf "$s"; deps_out "$m" deferred "$(busy_text "$busy")"; return 0; fi
  [[ -w "$m" ]] || { chmod u+w "$m" 2>/dev/null && rw=1; }
  [[ $rw == 1 ]] && relock_on_exit "chmod a-w $(printf %q "$m") 2>/dev/null; release_park_lock $(printf %q "$gd")"
  # each move only onto nothing: mv onto an existing directory moves into it
  if mv "$m/node_modules" "$s/old" 2>/dev/null; then
    moved=1
    if [[ ! -e "$m/node_modules" && ! -L "$m/node_modules" ]] && mv "$s/node_modules" "$m/node_modules" 2>/dev/null; then placed=1
    elif [[ ! -e "$m/node_modules" && ! -L "$m/node_modules" ]] && mv "$s/old" "$m/node_modules" 2>/dev/null; then moved=0; fi
  fi
  [[ $rw == 1 ]] && chmod a-w "$m" 2>/dev/null
  release_park_lock "$gd"; relock_on_exit ""
  if [[ $placed == 1 ]]; then rm -rf "$s"; rm -f "$gd/onetree-deps-failed"; deps_out "$m" refreshed "reinstalled node_modules from package-lock.json (was: $was)"
  elif [[ $moved == 0 ]]; then rm -rf "$s"; deps_out "$m" failed "could not swap the fresh node_modules in" "$h"
  # kept for you, never deleted
  else deps_out "$m" stuck "could not swap the fresh node_modules in, nor put the previous one back: it is at $s/old, the fresh one at $s/node_modules; move one to $m/node_modules, then onetree park"; fi
  return 0
}
busy_text() {  # main_busy lines -> one phrase for gc's log
  local n names; n=$(grep -c . <<<"$1"); names=$(awk '{print $2}' <<<"$1" | sort -u | tr '\n' ' '); names=${names% }
  printf 'deferred: %s process(es) working in main (%s); retried at the next park' "$n" "$names"
}
# main action reason [hash] — refreshed | failed | deferred | stuck: an event and a line in gc's log; a failure is
# remembered against that lockfile
deps_out() {
  local repo; repo=$(basename "$1")
  [[ -n "${4:-}" ]] && { printf '%s\n' "$4" > "$(_git_dir "$1")/onetree-deps-failed"; } 2>/dev/null
  log_event deps "action=$2" "reason=$3" "main=$1" "repo=$repo"
  [[ $GC_JSON == 1 ]] || printf 'deps %s: %s%s\n' "$repo" "$3" "$([[ "$2" == failed ]] && printf '; node_modules left as it was, onetree park retries')"
}

# ---- new: create a worktree and make it ready to work in
bootstrap() {  # main path — copy the gitignored bits a fresh checkout lacks, install deps, run the project's own hook
  local main=$1 path=$2 f pm inst custom out
  local -a fs; read -ra fs <<<"$(cfg copy "$main" ".env .env.local")"
  for f in ${fs[@]+"${fs[@]}"}; do [[ -e "$main/$f" && ! -e "$path/$f" ]] && cp -Rp "$main/$f" "$path/$f"; done
  if [[ -f "$path/package.json" && ! -d "$path/node_modules" ]]; then
    if   [[ -f "$path/pnpm-lock.yaml" ]]; then pm=pnpm; inst="pnpm install --frozen-lockfile --ignore-scripts"
    elif [[ -f "$path/yarn.lock" ]];      then pm=yarn; inst="yarn install --frozen-lockfile --ignore-scripts"
    elif [[ -f "$path/bun.lock" || -f "$path/bun.lockb" ]]; then pm=bun; inst="bun install --frozen-lockfile --ignore-scripts"
    else pm=npm; inst="npm ci --ignore-scripts"; fi
    # what main installed against this worktree's lockfile, not two lockfiles
    DEPS_STATE=absent; [[ -d "$main/node_modules" ]] && deps_state "$main" "$path"
    if [[ $DEPS_STATE == current ]]; then
      clone_dir "$main/node_modules" "$path/node_modules"         # copy-on-write clone where the filesystem supports it
    else   # unknown never clones: a stale clone fails hours later, in a typecheck or a git hook, far from its cause
      [[ $DEPS_STATE == absent ]] || printf 'onetree: not cloning %s/node_modules (%s: %s); installing fresh: %s\n' "$main" "$DEPS_STATE" "$DEPS_WHY" "$inst" >&2
      if ! out=$( { cd "$path" && $inst; } 2>&1 ); then
        printf 'onetree: dependency install failed in %s (%s)\n%s\n' "$path" "$inst" "$out" >&2
        writable_tree "$path"
        return 1
      fi
    fi
    # husky: hookspath is relative
    (cd "$path" && $pm run prepare --if-present >/dev/null 2>&1) || printf 'onetree: prepare failed in %s\n' "$path" >&2
  fi
  if [[ -f "$path/uv.lock" && ! -d "$path/.venv" ]] && command -v uv >/dev/null; then
    if ! (cd "$path" && uv sync -q >/dev/null); then printf 'onetree: uv sync failed in %s\n' "$path" >&2; writable_tree "$path"; return 1; fi
  fi
  if custom=$(cfg bootstrap "$main"); then
    # stdout is the path: callers capture it (carry, launch)
    if ! (cd "$path" && ONETREE_MAIN=$main ONETREE_PATH=$path bash -c "$custom" >&2); then
      printf 'onetree: bootstrap command failed in %s\n' "$path" >&2
      writable_tree "$path"
      return 1
    fi
  fi
  writable_tree "$path"
  return 0
}

# dir — 0 when a file can be made in dir, or in the nearest folder above it that exists. Tried, not read from the mode
# bits: a sandbox refuses writes the bits allow
can_write() {
  local d=$1 f; while [[ ! -e "$d" && "$d" != / ]]; do d=$(dirname "$d"); done
  f=$(mktemp "$d/.onetree-probe.XXXXXX" 2>/dev/null) || return 1
  rm -f "$f"; return 0
}
# main slug — the first place `new` must write and cannot, or 1: the main's git dir, the global config when it would
# change, and, for a worktree not made yet, the folder it goes in
new_unwritable() {
  local m=$1 p; p="$(root_of "$m")/$(basename "$m")/$2"
  can_write "$m/.git" || { printf '%s\n' "$m/.git"; return 0; }
  if ! is_registered "$m" || refresh_guarded --check; then can_write "$(dirname "$CFG")" || { printf '%s\n' "$CFG"; return 0; }; fi
  [[ -d "$p" ]] || can_write "$(dirname "$p")" || { printf '%s\n' "$(dirname "$p")"; return 0; }
  return 1
}
# host slug repo — how that agent gets a new worktree: dsh's sandbox cannot run `onetree new` (it writes outside it),
# so onetree's dsh plugin offers a tool that runs it outside, for the session's own repo (#24)
new_step() {
  case "$1" in
    dsh|dsh-moved) printf "call the \`onetree_new\` tool with slug %s: onetree's dsh plugin makes the worktree outside dsh's sandbox and opens it for this session (no such tool: ask the user to restart \`dsh web\`, which loads the plugin)" "$2" ;;
    *) printf "run \`onetree new %s%s\`" "$2" "${3:+ $3}" ;;
  esac
}
cmd_new() {
  # before anything with side effects: `new --help` once made a worktree
  local slug=${1:?slug}; [[ "$slug" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "slug: letters, digits, . _ - only, starting with a letter or digit"
  local main; main=$(main_of "${2:-}"); local repo; repo=$(basename "$main")
  # a sandboxed agent (Codex under workspace-write, dsh) may write only the folders it was started with: say so, before
  # git dies on a lock file (#15) or after git has made half a worktree (#24)
  local nw; if nw=$(new_unwritable "$main" "$slug"); then
    case "$(host_of)" in
      dsh) die "cannot write $nw, so no worktree can be made from inside dsh's sandbox. $(new_step dsh "$slug") instead." ;;
      *) die "cannot write $nw, so no worktree can be made from here. A sandboxed agent session writes only the worktree it started in; ask the user to start a session for this task: cd $(shq "$main") && onetree launch --task $slug <agent>" ;;
    esac
  fi
  ensure_registered "$main"; refresh_guarded
  local int; int=$(integration "$main"); local branch; branch="$(prefix_of "$main")$slug"; local root; root=$(root_of "$main"); local path="$root/$repo/$slug"
  # carry: a new branch at that commit, never a resumed one, so the carried changes apply as they were made
  if [[ -n "${NEW_FROM:-}" ]]; then
    [[ ! -e "$path" ]] || die "$path exists; carry needs a new slug"
    ! git -C "$main" show-ref -q --verify "refs/heads/$branch" || die "branch $branch exists; carry needs a new slug"
  fi
  # who moves in; never the caller of auto or a launcher
  local h=""; case "$ONETREE_CMD" in new|carry|hook-create) h=$(host_of) ;; esac; session_key "$h"
  if [[ -d "$path" ]]; then
    git -C "$main" worktree list --porcelain | grep -qx "worktree $path" || die "$path exists but is not a worktree of $repo"
    if ! bootstrap "$main" "$path"; then die "bootstrap failed in $path (worktree kept; retry the same slug)"; fi
    mark_ours "$path"; claude_trust_worktree "$main" "$path"
    [[ -n "$h" ]] && log_event new "path=$path" "repo=$repo" "branch=$branch" "reused:=true" "agent=${h%%-*}" "host=$h" "session=$SKEY_SESSION" "pid:=${SKEY_PID:-null}" "pidStart=$SKEY_START" ${SUBAGENT:+"subagent=$SUBAGENT"}
    echo "$path"; [[ "$ONETREE_CMD" == new ]] && next_step "$path" "$main"; return 0
  fi
  remotes_resolve "$main"
  git -C "$main" fetch -q "$RB"; [[ "$RP" == "$RB" ]] || git -C "$main" fetch -q "$RP"; tmark "new: fetch"
  mkdir -p "$root/$repo"
  # checkout.workers=0: write the files with one worker per core (29k-file repo: 8.7 s -> 4.3 s)
  local created_branch=0
  if [[ -n "${NEW_FROM:-}" ]]; then
    ! git -C "$main" show-ref -q --verify "refs/remotes/$RP/$branch" || die "branch $branch exists on $RP; carry needs a new slug"
    git -C "$main" -c checkout.workers=0 worktree add -q --no-track -b "$branch" "$path" "$NEW_FROM"
    if [[ "$RP" != "$RB" ]]; then git -C "$main" branch -q --set-upstream-to="$RB/$int" "$branch" 2>/dev/null || true; git -C "$main" config "branch.$branch.pushRemote" "$RP"; fi
    created_branch=1
  elif git -C "$main" show-ref -q --verify "refs/remotes/$RP/$branch" \
    && { ! git -C "$main" show-ref -q --verify "refs/heads/$branch" || git -C "$main" merge-base --is-ancestor "refs/heads/$branch" "$RP/$branch"; }; then
    # resume a branch that exists where branches are pushed; -B resets
    git -C "$main" -c checkout.workers=0 worktree add -q --track -B "$branch" "$path" "$RP/$branch"
  elif git -C "$main" show-ref -q --verify "refs/heads/$branch"; then
    # local-only branch (git refuses if checked out elsewhere)
    git -C "$main" -c checkout.workers=0 worktree add -q "$path" "$branch"
  elif [[ "$RP" == "$RB" ]]; then
    # no upstream until the agent pushes -u
    git -C "$main" -c checkout.workers=0 worktree add -q --no-track -b "$branch" "$path" "$RB/$int"
    created_branch=1
  # a fork: track <base>/<integration> and push to the push remote. pushRemote alone is not enough when that remote is
  # origin: git then sees no triangle, and a bare `git push` wants an upstream
  else
    git -C "$main" -c checkout.workers=0 worktree add -q --track -b "$branch" "$path" "$RB/$int"
    git -C "$main" config "branch.$branch.pushRemote" "$RP"
    created_branch=1
  fi
  tmark "new: worktree add"
  if ! bootstrap "$main" "$path"; then
    git -C "$main" worktree remove --force "$path" 2>/dev/null || true
    git -C "$main" worktree prune
    [[ $created_branch == 1 ]] && git -C "$main" branch -q -D "$branch" 2>/dev/null || true
    die "bootstrap failed; rolled back new worktree $path"
  fi
  tmark "new: bootstrap"; mark_ours "$path"; claude_trust_worktree "$main" "$path"
  log_event new "path=$path" "repo=$repo" "branch=$branch" "seconds:=$SECONDS" "resumed:=$([[ $created_branch == 1 ]] && echo false || echo true)" \
    "agent=${h%%-*}" "host=$h" "session=$SKEY_SESSION" "pid:=${SKEY_PID:-null}" "pidStart=$SKEY_START" ${SUBAGENT:+"subagent=$SUBAGENT"}
  echo "$path"; [[ "$ONETREE_CMD" == new ]] && next_step "$path" "$main"
  return 0
}

# ---- carry: a dirty main's uncommitted work moves into a new worktree instead of being locked in place. Nothing in main changes until
# the worktree holds the same changes (compared as diffs against the same HEAD, and file by file for untracked files).
carry_run() {  # main slug untracked(0|1) — 0 when carried (or nothing to carry); 1 with main untouched, the half-made worktree removed
  local m=$1 slug=$2 u=$3 head tmp path b n nu=0 f
  head=$(git -C "$m" rev-parse -q --verify HEAD) || { echo "onetree: carry: $m has no commit to cut a worktree from" >&2; return 1; }
  [[ -z "$(git -C "$m" ls-files -u 2>/dev/null)" ]] || { echo "onetree: carry: $m has unmerged paths; finish or abort that merge first" >&2; return 1; }
  f=$(comm -12 <(git -C "$m" diff --cached --name-only | sort) <(git -C "$m" diff --name-only | sort) | head -3 | tr '\n' ' ')   # carry moves one version per path: a staged
  [[ -z "$f" ]] || { echo "onetree: carry: ${f% } in $m has a staged version that differs from both HEAD and the working copy; stage all of it (git add) or unstage it (git restore --staged), then carry" >&2; return 1; }   # one would be lost
  tmp=$(mktemp -d)
  cdiff() { git -C "$1" diff HEAD --binary --no-ext-diff --no-textconv --no-color --src-prefix=a/ --dst-prefix=b/ > "$2"; }
  cdiff "$m" "$tmp/patch" || { rm -rf "$tmp"; echo "onetree: carry: could not diff $m" >&2; return 1; }
  n=$(git -C "$m" diff HEAD --name-only 2>/dev/null | grep -c . || true)
  : > "$tmp/untracked"
  [[ $u == 1 ]] && git -C "$m" ls-files -z --others --exclude-standard > "$tmp/untracked"
  nu=$(tr -cd '\0' < "$tmp/untracked" | wc -c | tr -d ' ')
  if [[ $n == 0 && $nu == 0 ]]; then
    local left; left=$(git -C "$m" ls-files --others --exclude-standard | grep -c . || true)
    printf 'onetree: carry: nothing to carry in %s%s\n' "$m" "$([[ $left -gt 0 && $u == 0 ]] && printf ' (%s untracked file(s) stay; --untracked carries them too)' "$left")" >&2
    rm -rf "$tmp"; return 0
  fi
  if ! path=$(NEW_FROM=$head cmd_new "$slug" "$m"); then rm -rf "$tmp"; echo "onetree: carry: no worktree, so nothing moved; $m is as it was" >&2; return 1; fi
  b=$(git -C "$path" symbolic-ref -q --short HEAD)
  carry_undo() {   # the worktree is ours and holds only a copy: remove it and its branch; main was never touched
    git -C "$m" worktree remove --force "$path" 2>/dev/null || true; git -C "$m" worktree prune 2>/dev/null || true
    git -C "$m" branch -q -D "$b" 2>/dev/null || true; rm -rf "$tmp"
    printf 'onetree: carry: %s; removed %s again, and %s is as it was\n' "$1" "$path" "$m" >&2
  }
  git -C "$m" diff HEAD --name-only --diff-filter=A -z > "$tmp/added"   # new files: intent-to-add in the worktree, as in main (apply -N would rewrite its whole index)
  if [[ -s "$tmp/patch" ]] && ! { git -C "$path" apply --binary "$tmp/patch" && { [[ ! -s "$tmp/added" ]] || git -C "$path" add -N --pathspec-from-file="$tmp/added" --pathspec-file-nul; }; } 2>"$tmp/err"; then
    carry_undo "the changes did not apply ($(head -1 "$tmp/err"))"; return 1
  fi
  if [[ $nu -gt 0 ]] && ! { ( cd "$m" && tar -cf - --null -T "$tmp/untracked" ) | ( cd "$path" && tar -xpf - ); } 2>"$tmp/err"; then carry_undo "copying the untracked files failed ($(head -1 "$tmp/err"))"; return 1; fi
  cdiff "$path" "$tmp/carried"
  cmp -s "$tmp/patch" "$tmp/carried" || { carry_undo "the worktree's changes differ from main's"; return 1; }
  git -C "$m" diff HEAD --name-only --no-renames -z > "$tmp/paths"   # and byte for byte: a clean/smudge filter (LFS, eol) can make equal diffs of unequal files
  cat "$tmp/untracked" >> "$tmp/paths"
  while IFS= read -r -d '' f; do
    if [[ ! -e "$m/$f" && ! -L "$m/$f" ]]; then [[ ! -e "$path/$f" && ! -L "$path/$f" ]] || { carry_undo "$f is deleted in main but not in the worktree"; return 1; }
    elif [[ -L "$m/$f" ]]; then [[ -L "$path/$f" && "$(readlink "$m/$f")" == "$(readlink "$path/$f")" ]] || { carry_undo "$f differs after the copy"; return 1; }
    else cmp -s "$m/$f" "$path/$f" || { carry_undo "$f differs after the copy"; return 1; }; fi
  done < "$tmp/paths"
  cdiff "$m" "$tmp/now"   # main must still be what was carried: a change made meanwhile is left in place, never thrown away
  cmp -s "$tmp/patch" "$tmp/now" || { rm -rf "$tmp"; printf 'onetree: carry: %s changed while it was being carried; left it as it is (%s has the earlier copy)\n' "$m" "$path" >&2; echo "$path"; return 1; }
  local st=0
  if guarded "$m"; then with_main_unlocked "$m" carry_restore "$m" "$tmp/untracked" || st=$?; else carry_restore "$m" "$tmp/untracked" || st=$?; fi
  rm -rf "$tmp"
  if [[ $st != 0 ]]; then printf 'onetree: carry: %s holds the changes, but restoring %s failed (is a onetree gc running?); both hold them now, so nothing is lost\n' "$path" "$m" >&2; echo "$path"; return 1; fi
  log_event carry "path=$path" "main=$m" "repo=$(basename "$m")" "branch=$b" "tracked:=$n" "untracked:=$nu"
  printf 'onetree: carried %s tracked path(s)%s from %s into %s (%s, cut from %s); main is back at HEAD\n' "$n" "$([[ $nu -gt 0 ]] && printf ' and %s untracked file(s)' "$nu")" "$m" "$path" "$b" "${head:0:7}" >&2
  echo "$path"; next_step "$path" "$m"
}
carry_restore() {  # main untracked-list — main back to HEAD: tracked paths restored, carried untracked files removed
  local m=$1 f
  git -C "$m" reset -q --hard HEAD || return 1
  while IFS= read -r -d '' f; do rm -f "$m/$f"; done < "$2"
  return 0
}
cmd_carry() {  # carry <slug> [repo] [--untracked]
  local u=0 args=() a; for a in "$@"; do case "$a" in --untracked) u=1 ;; -*) die "carry: unknown option $a" ;; *) args+=("$a") ;; esac; done
  local slug=${args[0]:?slug}; local main; main=$(main_of "${args[1]:-}"); ensure_registered "$main"
  carry_run "$main" "$slug" "$u" || exit 1
}

review_keep_own() {  # path — dies when an existing review checkout holds commits that exist nowhere else (on no remote, in no fetched PR head, not under
  local p=$1 rh c; [[ -d "$p" ]] || return 0   # the head it was made at): moving it to the new head would leave them unreachable. Run before any fetch
  rh=$(sed -n 2p "$(_git_dir "$p")/onetree-review" 2>/dev/null || true)
  c=$(git -C "$p" log --format='%h %s' HEAD --not --remotes --glob='refs/onetree/pr/*' ${rh:+"$rh"} 2>/dev/null | head -3 | tr '\n' ';')
  [[ -z "$c" ]] || die "$p has commits that exist nowhere else (${c%;}); keep them on a branch (git -C $p switch -c <name>, then push), or drop them with onetree rm $(basename "$p") --force, then review again"
}
review_move() {  # path ref — an existing review checkout to the new head; an ignored file of its own that the new head tracks is kept, and the move refused
  local err; err=$(git -C "$1" checkout -q --detach --no-overwrite-ignore "$2" 2>&1) || die "could not move $1 to $2: $(git_refusal "$err")"
}
cmd_review() {  # review <branch>|<PR> [repo] — a clean, detached checkout of <base>/<branch>, else <push>/<branch>, or of PR <n>, for a read-only reviewer
  local branch=${1:?branch or PR number}; local main; main=$(main_of "${2:-}"); local repo; repo=$(basename "$main"); ensure_registered "$main"
  local root; root=$(root_of "$main"); local slug="review-${branch//\//-}"; local path="$root/$repo/$slug" src
  remotes_resolve "$main"
  if [[ "$branch" =~ ^(pr:|#)?([0-9]+)$ ]]; then review_pr "$main" "${BASH_REMATCH[2]}"; return; fi
  review_keep_own "$path"
  git -C "$main" fetch -q "$RB"; [[ "$RP" == "$RB" ]] || git -C "$main" fetch -q "$RP"
  if git -C "$main" show-ref -q --verify "refs/remotes/$RB/$branch"; then src=$RB
  elif [[ "$RP" == "$RB" ]]; then die "$RB/$branch does not exist"
  elif git -C "$main" show-ref -q --verify "refs/remotes/$RP/$branch"; then src=$RP
  else die "$branch is on neither $RB nor $RP"; fi
  [[ "$RP" == "$RB" ]] || printf 'onetree: reviewing %s/%s\n' "$src" "$branch" >&2
  if [[ -d "$path" ]]; then review_move "$path" "$src/$branch"; else mkdir -p "$root/$repo"; git -C "$main" worktree add -q --detach "$path" "$src/$branch"; fi
  bootstrap "$main" "$path"
  { printf '%s\n%s\n' "$branch" "$(git -C "$path" rev-parse HEAD)" > "$(_git_dir "$path")/onetree-review"; } 2>/dev/null || true   # so gc knows whose PR to ask about, and that this holds nothing of its own
  log_event review "path=$path" "repo=$repo" "branch=$branch"
  echo "$path"; next_step "$path" "$main"
}

review_pr() {  # main n — PR <n>'s head from the base remote (pull/<n>/head, which GitHub serves for a fork's PR too) into refs/onetree/pr/<n>, outside
  local main=$1 n=$2 repo path ref="refs/onetree/pr/$2"   # any remote's namespace, so a fetch -p never prunes it; a detached checkout of it, recorded as #<n>
  repo=$(basename "$main"); path="$(root_of "$main")/$repo/review-pr-$n"
  review_keep_own "$path"
  git -C "$main" fetch -q "$RB" "+refs/pull/$n/head:$ref" 2>/dev/null || die "could not fetch pull/$n/head from $RB ($(gh_slug "$main")): is #$n a pull request there?"
  if [[ -d "$path" ]]; then review_move "$path" "$ref"; else mkdir -p "$(dirname "$path")"; git -C "$main" worktree add -q --detach "$path" "$ref"; fi
  bootstrap "$main" "$path"
  # gc asks gh about PR <n>, and removes the checkout once it resolves
  { printf '#%s\n%s\n' "$n" "$(git -C "$path" rev-parse HEAD)" > "$(_git_dir "$path")/onetree-review"; } 2>/dev/null || true
  log_event review "path=$path" "repo=$repo" "branch=#$n" "pr:=$n"
  echo "$path"; next_step "$path" "$main"
}

cmd_bootstrap() {
  local path; path=$(real "${1:-$PWD}"); local main; main=$(cd "$path" && main_of)
  [[ "$path" == "$main" ]] && die "$path is the main checkout, nothing to bootstrap"
  bootstrap "$main" "$path"; echo "bootstrapped $path from $main"
  # say so, or "bootstrapped" reads as deps installed
  [[ -f "$path/package.json" || -f "$path/uv.lock" ]] || cfg bootstrap "$main" >/dev/null ||
    echo "onetree: no dependency step ran: no package.json or uv.lock, and onetree.bootstrap is unset (onetree init --bootstrap CMD)" >&2
}

mains_for() {  # one path per line
  local m
  if [[ "${1:-}" == --all ]]; then
    while IFS= read -r m; do [[ -n "$m" ]] || continue; real "$m"; done < <(repos_all)
  else
    main_of "${1:-}"
  fi
}

# ---- ls, rm, gc and park: what each worktree holds, and whether it can go
cmd_ls() {
  local json=0 fresh=0 target="" a m mains
  for a in "$@"; do case "$a" in --json) json=1 ;; --fresh) fresh=1 ;; *) target=$a ;; esac; done
  mains=$(mains_for "$target"); [[ $fresh == 1 ]] && fresh_caches "$mains"
  lsof_prime; prefetch_prs "$mains"
  if [[ $json == 1 ]]; then each_main "$mains" ls_json_of | jq -s .; return 0; fi
  { printf 'PATH\tBRANCH\tDIRTY\tUNPUSHED\tPR\tPRHEAD\tLOCK\tLIVE\n'; each_main "$mains" ls_text_of; } | sed -E 's/([0-9a-f]{7})[0-9a-f]{33}/\1/' | tbl
}
ls_json_of() { cfg_dump "$1"; integration "$1" >/dev/null; main_json "$1"; each_worktree "$1" status_json_of; }
ls_text_of() {
  cfg_dump "$1"; integration "$1" >/dev/null
  printf '%s\t%s\t%s\t-\tmain checkout\t-\t-\t%s\n' "$1" "$(git -C "$1" symbolic-ref -q --short HEAD || echo '(detached)')" "$(git -C "$1" status --porcelain | wc -l | tr -d ' ')" "$(live_procs "$1")"
  each_worktree "$1" status_line
}
# newline-separated mains, fn — run `fn main` for every main at once, printing the outputs in registry order
each_main() {
  local m fn=$2 i=0 tmp; tmp=$(mktemp -d)
  while IFS= read -r m; do
    [[ -n "$m" ]] || continue
    i=$((i+1)); ( "$fn" "$m" || true ) > "$tmp/$(printf '%03d' "$i")" 2>/dev/null &
  done <<<"$1"
  wait
  cat_all "$tmp"/[0-9]*; rm -rf "$tmp"
}

# remove_one main path force dry [explicit]  -> 0 removed, 1 kept (reason printed). explicit: `onetree rm`, which also
# takes a clean detached checkout whose HEAD is on a remote ref (or a fetched PR head) whatever its age or PR state,
# since it holds nothing of its own
remove_one() {
  local main=$1 path=$2 force=${3:-0} dry=${4:-0} explicit=${5:-0} line branch dirty unpushed pr prhead lock live head int merged=0 ghmerged=0 review=0 closed=0 onremote=0 rev="" label age stale
  line=$(status_line "$main" "$path"); IFS=$'\t' read -r _ branch dirty unpushed pr prhead lock live <<<"$line"
  head=$(git -C "$path" rev-parse HEAD); int=$(integration "$main"); stale=$(( $(cfg stale "$main" 24) * 3600 )); remotes_resolve "$main"
  if [[ "$branch" == "(detached)" ]] && is_review "$path"; then rev=$(review_branch_of "$path"); review=1; fi
  label=$branch; [[ -n "$rev" ]] && label="$rev (review)"
  [[ "$pr" == MERGED && "$prhead" == "$head" ]] && { merged=1; ghmerged=1; }
  # local head behind the merged head
  if [[ "$pr" == MERGED && $ghmerged == 0 ]] && git -C "$path" cat-file -e "$prhead^{commit}" 2>/dev/null && git -C "$path" merge-base --is-ancestor HEAD "$prhead" 2>/dev/null; then merged=1; ghmerged=1; fi
  # branch never had a PR: is its head inside some merged PR? Not asked of a head already in the integration branch: it
  # holds nothing of its own (a fresh worktree), every later PR contains it, and its age decides below
  if [[ "$pr" == NONE && "$branch" != "(detached)" ]] && ! git -C "$path" merge-base --is-ancestor HEAD "$RB/$int" 2>/dev/null; then
    local mh heads; heads=$(merged_heads "$main")
    if [[ -n "$heads" ]]; then   # one git call finds which merged heads this checkout has at all; only those are tested
      for mh in $(printf '%s\n' "$heads" | git -C "$path" cat-file --batch-check='%(objectname) %(objecttype)' 2>/dev/null | awk '$2 == "commit" { print $1 }'); do
        git -C "$path" merge-base --is-ancestor HEAD "$mh" 2>/dev/null && { merged=1; ghmerged=1; break; }
      done
    fi
  fi
  # the base's copy: a fork's integration branch may lag
  git -C "$path" merge-base --is-ancestor HEAD "$RB/$int" 2>/dev/null && merged=1
  [[ "$branch" == "(detached)" ]] && git -C "$path" for-each-ref --contains HEAD --format=x refs/remotes refs/onetree/pr 2>/dev/null | grep -q . && merged=1
  # still at the head it was made from, or on a remote: nothing here to lose, even after a squash merge deleted the
  # branch. A commit made here keeps it below.
  if [[ $review == 1 && ( "$unpushed" == 0 || "$head" == "$(sed -n 2p "$(_git_dir "$path")/onetree-review" 2>/dev/null)" ) ]]; then
    merged=1
    # the PR is resolved: no reason to wait out the stale window
    [[ "$pr" == MERGED || "$pr" == CLOSED ]] && ghmerged=1
  fi
  if [[ $force == 0 ]]; then   # each keep has a stable code (docs/snapshot.md) and the reason gc has always logged
    local owner; [[ $explicit == 0 ]] && owner=$(foreign_owner "$main" "$path") && { gc_out keep foreign "made by $owner, which removes it itself"; return 1; }
    [[ "$lock" != - ]]      && { gc_out keep locked "$lock"; return 1; }
    [[ "$live" != 0 ]]      && { gc_out keep live "$live live process(es) or dsh session(s) inside"; return 1; }
    [[ "$dirty" != 0 ]]     && { gc_out keep dirty "$dirty uncommitted path(s)"; return 1; }
    local kf ks; local -a kfs; ks=$(tilde "$(cfg keepSource "$main" "$main")"); read -ra kfs <<<"$(cfg keep "$main" "")"
    for kf in ${kfs[@]+"${kfs[@]}"}; do   # gitignored state that git status calls clean
      [[ -e "$path/$kf" ]] && ! cmp -s "$path/$kf" "$ks/$kf" && { gc_out keep keep-file "$kf differs from $ks/$kf"; return 1; }
    done
    # onetree rm: every commit is on a remote ref, so nothing here to lose
    if [[ $explicit == 1 && "$branch" == "(detached)" && "$unpushed" == 0 ]]; then onremote=1
    else
    [[ "$pr" == OPEN ]]     && { gc_out keep pr-open "PR open ($label)"; return 1; }
    # before the age check, or a merged PR reads as "no merged PR"
    [[ "$pr" == MERGED && $ghmerged == 0 ]] && { gc_out keep after-merge "commits after the merged PR head ($label)"; return 1; }
    if [[ $ghmerged == 0 ]]; then age=$(( $(date +%s) - $(mtime "$path/.git") )); [[ $age -lt $stale ]] && { gc_out keep young "no merged PR and younger than $((stale/3600))h"; return 1; }; fi
    # CLOSED: the PR was abandoned. If every commit is already on origin, this checkout is a copy of that abandoned
    # branch — after the stale window, drop it. Unique local commits still keep it as not-merged. Review checkouts
    # already go via $review.
    [[ $review == 0 && "$pr" == CLOSED && "$unpushed" == 0 ]] && closed=1
    [[ $merged == 1 || $closed == 1 ]]      || { gc_out keep not-merged "$label not merged (pr=$pr, unpushed=$unpushed)"; return 1; }
    [[ $ghmerged == 1 || $review == 1 || "$unpushed" == 0 ]] || { gc_out keep unpushed "$unpushed unpushed commit(s)"; return 1; }
    fi
  fi
  local how='in-integration'; [[ $ghmerged == 1 ]] && how='pr-merged'; [[ $onremote == 1 ]] && how='on-remote'; [[ $review == 1 ]] && how='review'; [[ $closed == 1 ]] && how='pr-closed'; [[ $force == 1 ]] && how='forced'
  [[ $dry == 1 ]] && { gc_out would-remove "$how" "$label, pr=$pr"; return 0; }
  local -a rmopt=(); [[ $force == 1 ]] && rmopt=(--force)
  # it changed after the checks above
  local err; err=$(git -C "$main" worktree remove "${rmopt[@]}" "$path" 2>&1) || { gc_out keep changed "git refused: ${err#fatal: }"; return 1; }
  if [[ "$branch" != "(detached)" ]]; then
    if [[ $ghmerged == 1 || $closed == 1 || $force == 1 ]]; then git -C "$main" branch -q -D "$branch" 2>/dev/null || true
    else git -C "$main" branch -q -d "$branch" 2>/dev/null || true; fi
  fi
  git -C "$main" worktree prune
  # the PR head fetched for it
  [[ "$rev" =~ ^#([0-9]+)$ ]] && git -C "$main" update-ref -d "refs/onetree/pr/${BASH_REMATCH[1]}" 2>/dev/null || true
  gc_out remove "$how" "$label, pr=$pr"
}

cmd_rm() {
  local force=0 args=() a; for a in "$@"; do [[ $a == --force ]] && force=1 || args+=("$a"); done
  PR_TTL=0   # one worktree, one gh call: always the current PR state
  local slug=${args[0]:?slug}; local main; main=$(main_of "${args[1]:-}")
  local path; path="$(root_of "$main")/$(basename "$main")/$slug"
  [[ -d "$path" ]] || path=$(worktrees_of "$main" | while IFS= read -r w; do [[ "$w" == */"$slug" ]] && { printf '%s' "$w"; break; }; done)
  [[ -n "$path" && -d "$path" ]] || die "no worktree named $slug (onetree ls)"
  [[ "$(real "$path")" == "$main" ]] && die "refusing to remove the main checkout"
  remove_one "$main" "$path" "$force" 0 1
}

git_refusal() {  # git's stderr -> "would overwrite a b c", from the files it lists under the error, else its first line
  local files; files=$(grep $'^\t' <<<"$1" | tr -d '\t' | head -3 | tr '\n' ' ')
  if [[ -n "$files" ]]; then printf 'would overwrite %s' "${files% }"; else printf 'failed: %s' "${1%%$'\n'*}"; fi
}
_park_body() {  # main — git mutations; caller holds the unlock window when guarded
  local main=$1 repo int branch pr prhead head merged=0 ghmerged=0 before after
  repo=$(basename "$main"); int=$(integration "$main"); remotes_resolve "$main"
  branch=$(git -C "$main" symbolic-ref -q --short HEAD || echo "(detached)")
  if [[ "${2:-0}" == 1 ]]; then
    apply_half_switch_repair "$main"
    branch=$(git -C "$main" symbolic-ref -q --short HEAD || echo "(detached)")
  elif [[ -n "$(git -C "$main" status --porcelain)" ]]; then
    park_out "$main" leave dirty "on $branch with uncommitted changes, leaving it"
    return 1
  fi
  if [[ "$branch" == "$int" ]]; then
    git -C "$main" fetch -q "$RB" 2>/dev/null || true
    before=$(git -C "$main" rev-parse HEAD); after=$before; local err=""
    if [[ -z "$(git -C "$main" status --porcelain)" ]] && err=$(git -C "$main" merge -q --ff-only --no-overwrite-ignore "$RB/$int" 2>&1); then after=$(git -C "$main" rev-parse HEAD)
    # an ignored file of the user's is where the update puts a tracked one: keep the user's
    elif [[ "$err" == *"would be overwritten"* ]]; then
      park_out "$main" leave blocked "fast-forwarding $int $(git_refusal "$err")"; return 1
    elif git -C "$main" show-ref -q --verify "refs/remotes/$RB/$int" && ! git -C "$main" merge-base --is-ancestor HEAD "$RB/$int"; then
      park_out "$main" leave diverged "$int has $(git -C "$main" rev-list --count "$RB/$int..HEAD") commit(s) $RB/$int lacks, so it cannot fast-forward"; return 1
    fi
    if [[ "$before" != "$after" ]]; then park_out "$main" fast-forwarded updated "$int to ${after:0:7}"; else park_out "$main" none on-integration "on $int"; fi
    return 0
  fi
  head=$(git -C "$main" rev-parse HEAD)
  if [[ "$branch" != "(detached)" ]]; then pr=$(pr_info "$main" "$branch"); prhead=${pr#* }; pr=${pr%% *}; else pr=NONE; prhead=-; fi
  [[ "$pr" == MERGED && "$prhead" == "$head" ]] && { merged=1; ghmerged=1; }
  git -C "$main" merge-base --is-ancestor HEAD "$RB/$int" 2>/dev/null && merged=1
  [[ $merged == 1 ]] || { park_out "$main" leave not-merged "on $branch, not merged (pr=$pr), leaving it"; return 1; }
  # if this switch dies halfway, the next park repairs it
  local mark; mark="$(_git_dir "$main")/onetree-switching"; : > "$mark" 2>/dev/null || true
  local err
  # git refuses before touching a file, so main is as it was
  if ! err=$(switch_int "$main" "$int" --no-overwrite-ignore 2>&1); then
    rm -f "$mark"; park_out "$main" leave blocked "switching $branch -> $int $(git_refusal "$err")"; return 1
  fi
  git -C "$main" fetch -q "$RB" 2>/dev/null || true
  # refused, it stays put: the next park says why
  git -C "$main" merge -q --ff-only --no-overwrite-ignore "$RB/$int" 2>/dev/null || true
  rm -f "$mark"
  if [[ "$branch" != "(detached)" ]]; then
    if [[ $ghmerged == 1 ]]; then git -C "$main" branch -q -D "$branch" 2>/dev/null || true; else git -C "$main" branch -q -d "$branch" 2>/dev/null || true; fi
  fi
  park_out "$main" parked merged "$branch -> $int"
}
# main dry — put a clean, merged-away main checkout back on its integration branch; in JSON mode always one verdict
park_one() {
  local main=$1 dry=${2:-0} repo int branch
  repo=$(basename "$main"); int=$(integration "$main")
  branch=$(git -C "$main" symbolic-ref -q --short HEAD || echo "(detached)")
  if [[ $dry == 1 ]]; then
    guarded "$main" || { park_out "$main" none unguarded "not guarded, never parked"; return 0; }
    [[ "$branch" == "$int" ]] && { park_out "$main" none on-integration "on $int"; return 0; }
    [[ -z "$(git -C "$main" status --porcelain)" ]] || { park_out "$main" leave dirty "on $branch with uncommitted changes, leaving it"; return 1; }
    park_out "$main" would-park candidate "$branch -> $int"
    return 0
  fi
  guarded "$main" || { park_out "$main" none unguarded "not guarded, never parked"; return 0; }
  local hs=0 st=0; half_switch_p "$main" && hs=1
  with_main_unlocked "$main" _park_body "$main" "$hs" || st=$?
  # a fast-forward may have moved the lockfile; git hooks run from here use this node_modules
  deps_refresh "$main" || true
  return $st
}
# target dry — fetch every main at once and warm the PR cache, then one verdict per worktree and one per main; a dry run
# judges the worktrees at once
gc_run() {
  local target=$1 dry=$2 m w mains i=0 tmp
  mains=$(mains_for "$target")
  local active=""
  while IFS= read -r m; do
    [[ -n "$m" ]] || continue
    production_skip "$m" || active+="$m"$'\n'
  done <<<"$mains"
  mains=${active%$'\n'}
  [[ -n "$mains" ]] || return 0
  lsof_prime; fetch_all "$mains"; prefetch_prs "$mains"
  if [[ $dry == 1 ]]; then each_main "$mains" verdicts_of; return 0; fi   # verdicts only: every repo at once
  while IFS= read -r m; do   # removals and parks one at a time
    [[ -n "$m" ]] || continue
    cfg_dump "$m"; integration "$m" >/dev/null
    while IFS= read -r w; do [[ -n "$w" ]] || continue; remove_one "$m" "$w" 0 0 || true; done < <(worktrees_of "$m")
    park_one "$m" 0 || true
  done <<<"$mains"
}
verdicts_of() { cfg_dump "$1"; integration "$1" >/dev/null; each_worktree "$1" verdict_of; park_one "$1" 1 || true; }
cmd_gc() {
  local dry=0 json=0 fresh=0 target="" a t0 tmp
  for a in "$@"; do case "$a" in --dry-run) dry=1 ;; --json) json=1 ;; --fresh) fresh=1 ;; *) target=$a ;; esac; done
  [[ $fresh == 1 ]] && fresh_caches "$(mains_for "$target")"
  t0=$(date +%s)
  if [[ $json == 1 ]]; then
    # no pipeline, so the tallies survive
    GC_JSON=1; tmp=$(mktemp); gc_run "$target" "$dry" > "$tmp"; jq -s . "$tmp"; rm -f "$tmp"
  else
    gc_run "$target" "$dry"
  fi
  [[ $dry == 1 ]] || log_event gc-run "target=${target:-cwd}" "kept:=$GC_KEPT" "removed:=$GC_REMOVED" "parked:=$GC_PARKED" "fastForwarded:=$GC_FF" "seconds:=$(( $(date +%s) - t0 ))"
}

production_skip() { production "$1" || return 1; printf 'onetree: warning: skipping production checkout %s; unregister it before marking it production\n' "$1" >&2; }
cmd_park() { local m; DEPS_FORCE=1; while IFS= read -r m; do
  [[ -n "$m" ]] && ! production_skip "$m" || continue
  park_one "$m" 0 || true
done < <(mains_for "${1:---all}"); }

# ---- events, snapshot and the dashboard
# [--json] [--since 30m|24h|7d|<epoch>] [--kind K] [-n N] — the event log, oldest first; -n 0 for everything
cmd_events() {
  local json=0 since="" kind="" n=100 a cutoff=0 now sel
  while [[ $# -gt 0 ]]; do a=$1; shift
    case "$a" in
      --json) json=1 ;;  --since) since=${1:?}; shift ;;  --kind) kind=${1:?}; shift ;;  -n) n=${1:?}; shift ;;
      *) die "events: unknown option $a" ;;
    esac
  done
  now=$(date +%s)
  case "$since" in
    "") cutoff=0 ;;
    *m) cutoff=$(( now - ${since%m} * 60 )) ;;
    *h) cutoff=$(( now - ${since%h} * 3600 )) ;;
    *d) cutoff=$(( now - ${since%d} * 86400 )) ;;
    *[!0-9]*) die "events: --since takes 30m, 24h, 7d or an epoch" ;;
    *) cutoff=$since ;;
  esac
  sel=""
  if [[ -f "$EVENTS" ]]; then
    sel=$(jq -c --argjson cutoff "$cutoff" --arg kind "$kind" 'select((.t // 0) >= $cutoff and ($kind == "" or .kind == $kind))' "$EVENTS" 2>/dev/null || true)
    [[ "$n" == 0 ]] || sel=$(printf '%s\n' "$sel" | tail -n "$n")
  fi
  if [[ $json == 1 ]]; then printf '%s\n' "$sel" | jq -s .; return 0; fi
  [[ -n "$sel" ]] || return 0
  printf '%s\n' "$sel" | jq -r '[.ts, .kind, (.cmd // ""), (.action // .decision // ""), (.code // .rule // ""), (.path // .main // ""), (.reason // .command // .branch // "")] | @tsv' | tbl
}

# main -> {info, main (with its park verdict), worktrees (each with its gc verdict)}: a dry gc pass whose pieces run at
# once
repo_json() {
  local m=$1 tmp; tmp=$(mktemp -d)
  cfg_dump "$m"; integration "$m" >/dev/null   # read once here, inherited by everything forked below
  fetch_main "$m"; tmark "$(basename "$m"): fetch checked"
  ( info_json "$m" ) > "$tmp/0.info" 2>/dev/null &
  ( main_json "$m" ) > "$tmp/1.main" 2>/dev/null &
  ( park_one "$m" 1 || true ) > "$tmp/2.park" 2>/dev/null &
  each_worktree "$m" verdict_of > "$tmp/3.rows"
  wait; tmark "$(basename "$m"): info, main, park done"
  cat_all "$tmp"/0.info "$tmp"/1.main "$tmp"/2.park "$tmp"/3.rows | jq -s '{info:.[0], main:(.[1] + {park:.[2].park}), worktrees:.[3:]}'
  rm -rf "$tmp"
}
# [repo|--all] [--fresh] — everything a dashboard or script needs, in one document (docs/snapshot.md); the stages run at
# once
cmd_snapshot() {
  local target="" fresh=0 a m i=0 tmp doctor events agents mains pids=""
  for a in "$@"; do case "$a" in --fresh) fresh=1 ;; *) target=$a ;; esac; done
  GC_JSON=1
  mains=$(mains_for "${target:---all}"); [[ $fresh == 1 ]] && fresh_caches "$mains"
  lsof_prime; tmark "lsof"
  tmp=$(mktemp -d)
  local errto=/dev/null; [[ -n "${ONETREE_TIMING:-}" ]] && errto=/dev/stderr
  ( doctor_cached; tmark "doctor" ) > "$tmp/doctor" 2>"$errto" & pids="$pids $!"
  ( cmd_agents --json; tmark "agents" ) > "$tmp/agents" 2>"$errto" & pids="$pids $!"
  fetch_all "$mains"; tmark "fetched"
  prefetch_prs "$mains"; tmark "PR states"
  while IFS= read -r m; do
    [[ -n "$m" ]] || continue
    i=$((i+1)); ( repo_json "$m" ) > "$tmp/repo.$(printf '%03d' "$i")" 2>"$errto" & pids="$pids $!"
  done <<<"$mains"
  wait $pids; tmark "repos, agents, doctor"
  doctor=$(cat "$tmp/doctor"); [[ -n "$doctor" ]] || doctor=null
  agents=$(cat "$tmp/agents"); [[ -n "$agents" ]] || agents='[]'
  events=$(cmd_events --json --since 24h -n 500 2>/dev/null || true); [[ -n "$events" ]] || events='[]'
  cat_all "$tmp"/repo.* \
    | jq -s --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg host "$(hostname)" --arg bin "$(realfile "$0")" --argjson doctor "$doctor" --argjson events "$events" --argjson agents "$agents" \
        '{schema:1, generatedAt:$at, host:$host, onetree:{bin:$bin}, repos:., agents:$agents, doctor:$doctor, events:$events}'
  rm -rf "$tmp"
}

# [--port N] [--no-open] [--ttl S] [--fixture F] — serve the dashboard from the source checkout's ui/dist, loopback only
cmd_ui() {
  local port=7180 open=1 ttl=60 interval=60 fixture="" a src ui nv
  while [[ $# -gt 0 ]]; do a=$1; shift
    case "$a" in
      --port) port=${1:?}; shift ;;  --no-open) open=0 ;;  --ttl) ttl=${1:?}; shift ;;  --interval) interval=${1:?}; shift ;;  --fixture) fixture=${1:?}; shift ;;
      *) die "ui: unknown option $a" ;;
    esac
  done
  command -v node >/dev/null || die "ui: node 22+ is required"
  nv=$(node -p 'const [a, b] = process.versions.node.split(".").map(Number); a * 1000 + b' 2>/dev/null || echo 0)   # 22.6 runs .ts files directly
  [[ "$nv" -ge 22006 ]] || die "ui: node 22.6+ is required, found $(node -v 2>/dev/null || echo none)"
  # running from a checkout: its ui/; installed copy: the checkout install came from
  src=$(dirname "$(dirname "$(realfile "$0")")")
  [[ -f "$src/ui/server.ts" ]] || { src=$(gcfg onetree.source) || die "ui: no source checkout known; run \`onetree install\` from a git checkout of onetree"; src=$(tilde "$src"); }
  ui="$src/ui"; [[ -f "$ui/server.ts" ]] || die "ui: $ui/server.ts missing (onetree update)"
  [[ -f "$ui/dist/index.html" ]] || die "ui: no build in $ui/dist; run: cd $ui && npm ci && npm run build"
  set -- --port "$port" --ttl "$ttl" --interval "$interval" --onetree "$(realfile "$0")"
  [[ $open == 1 ]] && set -- "$@" --open
  [[ -n "$fixture" ]] && set -- "$@" --fixture "$fixture"
  exec node --experimental-strip-types --disable-warning=ExperimentalWarning "$ui/server.ts" "$@"
}

# main name — Claude's own WorktreeCreate in a repo onetree does not manage: <main>/.claude/worktrees/<name> on
# claude/<name>, cut from the default branch. Nothing is registered: onboarding is the user's call, so the agent is told
# to ask
plain_worktree() {
  local m=$1 n=$2 p base gd
  p=$m/$APP_WORKTREES/$n
  if [[ ! -d "$p" ]]; then
    git -C "$m" fetch -q origin 2>/dev/null || true
    base=$(git -C "$m" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null) || base=HEAD
    gd=$(git -C "$m" rev-parse --path-format=absolute --git-common-dir); mkdir -p "$gd/info"
    git -C "$m" check-ignore -q "$APP_WORKTREES/x" || { [[ -s "$gd/info/exclude" && -n "$(tail -c1 "$gd/info/exclude")" ]] && echo >> "$gd/info/exclude"; echo "/$APP_WORKTREES/" >> "$gd/info/exclude"; }
    if git -C "$m" show-ref -q --verify "refs/heads/claude/$n"; then git -C "$m" worktree add -q "$p" "claude/$n" >&2
    else git -C "$m" worktree add -q --no-track -b "claude/$n" "$p" "$base" >&2; fi
  fi
  printf 'onetree: %s is not managed by onetree, so this is a plain worktree. Ask the user once whether to onboard the repo (`onetree init --guard` or `--no-guard`).\n' "$(basename "$m")" >&2
  echo "$p"
}
# ---- launch: where an agent starts. The shell wrappers and any other launcher (bash, a script, a process supervisor) go through
# `onetree launch`. Print and exec modes run as typed, and the wrappers test for them with these same functions, copied
# in by declare -f, so a wrapper never needs onetree to run `claude -p` or `codex exec`.
onetree_claude_passthrough() {
  local take_value=0 arg
  for arg in "$@"; do
    if [[ $take_value -eq 1 ]]; then take_value=0; continue; fi
    case "$arg" in
      -p|--print|-w|--worktree|--worktree=*|-c|--continue|-r|--resume|--resume=*) return 0 ;;
      --) return 1 ;;
      --add-dir|--agent|--agents|--allowedTools|--allowed-tools|--append-system-prompt|--autocompact|--betas|--debug-file|--disallowedTools|--disallowed-tools|--effort|--environment|--fallback-model|--file|--input-format|--json-schema|--max-budget-usd|--mcp-config|--model|-n|--name|--output-format|--permission-mode|--permission-prompts|--plugin-dir|--plugin-url|--remote-control-session-name-prefix|--session-id|--setting-sources|--settings|--system-prompt|--system-prompt-snapshot|--tools) take_value=1 ;;
    esac
  done
  return 1
}
onetree_codex_passthrough() {
  local take_value=0 take_values=0 arg
  for arg in "$@"; do
    if [[ $take_value -eq 1 ]]; then take_value=0; continue; fi
    if [[ $take_values -eq 1 ]]; then
      case "$arg" in -*) take_values=0 ;; *) continue ;; esac
    fi
    case "$arg" in
      exec|e|login) return 0 ;;
      --) return 1 ;;
      -i|--image) take_values=1 ;;
      -c|--config|--enable|--disable|--remote|--remote-auth-token-env|-m|--model|--local-provider|-p|--profile|-s|--sandbox|-C|--cd|--add-dir|-a|--ask-for-approval) take_value=1 ;;
      -*) ;;
      *) return 1 ;;
    esac
  done
  return 1
}
# the file every shell sources: sh that bash and zsh both read. Claude Code snapshots an agent's shell functions, not
# its variables, and leaves out any function whose name starts with one underscore, so each name here starts with a
# letter and
render_wrappers() {
  local t
  t=$(cat <<'EOS'   # the path to onetree is written into the bodies
onetree_launch() {
  if [ ! -x "@ONETREE@" ]; then printf 'onetree: %s missing; refusing to start %s\n' "@ONETREE@" "$1" >&2; return 1; fi
  "@ONETREE@" launch "$@"
}
claude() { if onetree_claude_passthrough "$@"; then command claude "$@"; else onetree_launch claude "$@"; fi; }
codex() { if onetree_codex_passthrough "$@"; then command codex "$@"; else onetree_launch codex "$@"; fi; }
pi() { onetree_launch pi "$@"; }
dsh() { onetree_launch dsh "$@"; }
EOS
)
  printf '%s\n' '# Agents started in a guarded main checkout land in a fresh worktree (`onetree launch`). Sourced from ~/.zshrc and ~/.bashrc.' \
    '# Print and exec modes run as typed without onetree; anything else needs it, and refuses to start without it.'
  declare -f onetree_claude_passthrough onetree_codex_passthrough
  printf '%s\n' "${t//@ONETREE@/$BIN}"
}
# ---- resume: a session that moved into a worktree is filed by its host under that folder, so the main checkout's resume list misses it,
# and once gc removes the worktree there is nothing to resume in. The new events say which session made which worktree.
cmd_resume() {  # [slug|session] [repo] — list this repo's agent sessions and their worktrees; with one, bring its worktree back and say how to resume
  local key=${1:-} main repo rows ev path slug host sid c cfg
  main=$(main_of "${2:-}"); repo=$(basename "$main")
  rows=$(grep -F '"kind":"new"' "$EVENTS" 2>/dev/null | jq -c --arg r "$repo" 'select(.repo == $r and (.subagent // "") == "" and (.agent // "") != "" and ((.session // "") != "" or .pid != null))' 2>/dev/null || true)
  if [[ -z "$key" ]]; then
    [[ -n "$rows" ]] || { echo "onetree: no agent session has made a worktree of $repo" >&2; return 0; }
    { printf 'WHEN\tAGENT\tSESSION\tWORKTREE\tSTATE\n'
      jq -r '[.ts, .host, (if (.session // "") == "" then "pid " + (.pid | tostring) else .session end), .path] | @tsv' <<<"$rows" |
        while IFS=$'\t' read -r a b c d; do printf '%s\t%s\t%s\t%s\t%s\n' "$a" "$b" "$c" "$d" "$([[ -d "$d" ]] && echo here || echo removed)"; done; } | tbl
    return 0
  fi
  ev=$(jq -c --arg k "$key" 'select(.session == $k or (.path | split("/") | last) == $k)' <<<"$rows" | tail -1)
  [[ -n "$ev" ]] || die "resume: no session or worktree named $key made a worktree of $repo (onetree resume lists them)"
  path=$(jq -r .path <<<"$ev"); slug=${path##*/}; host=$(jq -r .host <<<"$ev"); sid=$(jq -r '.session // ""' <<<"$ev")
  if [[ -d "$path" ]]; then echo "worktree $path is still there"
  else path=$(cmd_new "$slug" "$main") || die "resume: could not recreate $slug"; echo "worktree $path recreated (its pushed branch, if any, is back)"; fi
  case "$host" in
    claude-*)   # Claude files a transcript under the folder the session was last in: resume from there
      cfg=${CLAUDE_CONFIG_DIR:-$HOME/.claude}; c=""
      # no transcript (another config dir, a pruned one) leaves the worktree as the place to resume from
      if [[ -n "$sid" ]]; then
        c=$(for f in "$cfg"/projects/*/"$sid".jsonl; do [[ -f "$f" ]] && jq -r 'select(.cwd) | .cwd' "$f" 2>/dev/null; done | tail -1) || c=
      fi
      [[ "$host" == claude-app ]] && echo "resume: reopen the session in the Claude app; its folder is back"
      [[ -n "$sid" ]] && echo "resume: cd $(shq "${c:-$path}") && claude --resume $sid" ;;
    codex-*) [[ "$host" == codex-app ]] && echo "resume: reopen the thread in the Codex app"
      [[ -n "$sid" ]] && echo "resume: cd $(shq "$path") && codex resume $sid" ;;
    pi) echo "resume: cd $(shq "$main") && pi --resume (pick the session; onetree's extension takes it back to $path)" ;;
  esac
  return 0
}
# [--task <slug>] <agent> [args…] — become the agent (exec) where it should run: in a guarded mirror, a fresh worktree;
# with --task, that named worktree of the repo here, guarded or not, print and exec modes too (a launcher's job
cmd_launch() {
  local task="" agent p x
  local -a pre=()           # that will edit); anywhere else, exactly as typed
  [[ "${1:-}" == --task ]] && { task=${2:?launch: --task needs a slug}; shift 2; }
  agent=${1:?launch: claude, codex, pi or dsh}; shift
  case "$agent" in claude|codex|pi|dsh) ;; *) die "launch: claude, codex, pi or dsh, not $agent" ;; esac
  if [[ -n "$task" ]]; then
    p=$(cmd_new "$task") || die "launch: no worktree, so $agent was not started"
  else
    case "$agent" in claude) onetree_claude_passthrough "$@" && exec claude "$@" ;; codex) onetree_codex_passthrough "$@" && exec codex "$@" ;; esac
    guarded_main_of_path "$PWD" >/dev/null || exec "$agent" "$@"
    p=$(ONETREE_CMD=auto cmd_auto "$agent") && [[ -n "$p" ]] || { printf 'onetree: refused to start %s in a guarded main checkout\n' "$agent" >&2; exit 1; }
    # never `claude -w`: that binds the session to the worktree and Claude then refuses any shell it cannot prove stays
    # inside it (#52)
    [[ "$agent" == claude ]] && claude_trust_root "$PWD"
  fi
  printf 'onetree: %s runs in %s\n' "$agent" "$p" >&2
  if [[ "$agent" == codex ]]; then   # its sandbox's grants and git settings (codex_grants)
    while IFS= read -r x; do pre+=("$x"); done < <(codex_grants "$p")
    export GIT_CONFIG_PARAMETERS="${GIT_CONFIG_PARAMETERS:+$GIT_CONFIG_PARAMETERS }$CODEX_GIT"
  fi
  cd "$p" && exec "$agent" ${pre[@]+"${pre[@]}"} "$@"
}
claude_trusts() {  # <dir> — Claude accepted its trust dialog for this main checkout (exact path only)
  local f=${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json m; m=$(guarded_main_of_path "$1") || return 1
  [[ -f "$f" ]] && jq -e --arg p "$m" '.projects[$p].hasTrustDialogAccepted == true' "$f" >/dev/null 2>&1
}
# <dir> — a trusted checkout's worktrees are trusted: record <root>/<repo> once in ~/.claude.json, Claude's documented
# way to pre-trust a folder, and a trusted folder above a worktree means no dialog there
claude_trust_root() {
  local f=${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json m r t
  claude_trusts "$1" || return 0; m=$(guarded_main_of_path "$1"); r="$(root_of "$m")/$(basename "$m")"
  jq -e --arg p "$r" '.projects[$p].hasTrustDialogAccepted == true' "$f" >/dev/null 2>&1 && return 0
  if t=$(mktemp "$f.XXXXXX") && jq --arg p "$r" '.projects[$p].hasTrustDialogAccepted = true' "$f" > "$t" && mv "$t" "$f"; then return 0; fi
  rm -f "${t:-}"; printf 'onetree: could not record Claude trust for %s; Claude will ask once\n' "$r" >&2; return 0
}
# main worktree — Claude trusts the main checkout, so the worktree onetree makes of it is trusted too, by its own path:
# Claude Code looks a folder up by exact path first, and the desktop app asks before it moves a session into an
# untrusted one (change_directory), then gives up when nobody answers for five minutes. A review checkout is not
# made here and gets no trust
claude_trust_worktree() {
  local f=${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json t
  [[ -f "$f" ]] && jq -e --arg m "$1" --arg p "$2" '.projects[$m].hasTrustDialogAccepted == true and .projects[$p].hasTrustDialogAccepted != true' "$f" >/dev/null 2>&1 || return 0
  if t=$(mktemp "$f.XXXXXX") && jq --arg p "$2" '.projects[$p].hasTrustDialogAccepted = true' "$f" > "$t" && mv "$t" "$f"; then return 0; fi
  rm -f "${t:-}"; return 0
}
cmd_auto() {
  local agent=${1:?agent}; local m; m=$(guarded_main_of_path "$PWD") || exit 1
  [[ "$agent" == --check ]] && { basename "$m"; exit 0; }
  # two sessions started in the same second must not share a worktree (`new` hands back a folder that exists): take
  # the next free name. shortcut: checked, not locked, so two calls in the same instant can still collide; lock if seen
  local base; base="$agent-$(date +%y%m%d-%H%M%S)"; local slug=$base n=1
  local dir; dir="$(root_of "$m")/$(basename "$m")"; local pre; pre=$(prefix_of "$m")
  while [[ -e "$dir/$slug" ]] || git -C "$m" show-ref --verify --quiet "refs/heads/$pre$slug"; do n=$((n+1)); slug="$base-$n"; done
  cmd_new "$slug" "$m"
}

# ---- registry and per-project behaviour
cmd_init() {
  local repo="" tofile=0 keys=() vals=() a excl=0 wr="" wrset=0 wradd="" wrrm="" wredit=0 carry="" carryu=0
  while [[ $# -gt 0 ]]; do a=$1; shift
    case "$a" in
      --guard) keys+=(guard); vals+=(true) ;;  --no-guard) keys+=(guard); vals+=(false) ;;
      --lock-ignored) keys+=(lockIgnored); vals+=(true) ;;  --no-lock-ignored) keys+=(lockIgnored); vals+=(false) ;;
      --integration) keys+=(integration); vals+=("${1:?}"); shift ;;
      --root) keys+=(root); vals+=("${1:?}"); shift ;;
      --branch-prefix) keys+=(branchPrefix); vals+=("${1:?}"); shift ;;
      --copy) keys+=(copy); vals+=("${1:?}"); shift ;;
      --keep) keys+=(keep); vals+=("${1:?}"); shift ;;
      --keep-source) keys+=(keepSource); vals+=("${1:?}"); shift ;;
      --bootstrap) keys+=(bootstrap); vals+=("${1:?}"); shift ;;
      --stale) keys+=(stale); vals+=("${1:?}"); shift ;;
      --remote) keys+=(remote); vals+=("${1:?}"); shift ;;
      --push-remote) keys+=(pushRemote); vals+=("${1:?}"); shift ;;
      --gh-user) keys+=(ghUser); vals+=("${1:?}"); shift ;;
      --writable) keys+=(writable); [[ $# -gt 0 ]] || die "--writable takes a quoted list (\"\" clears it)"; vals+=("$1"); wr=$1; wrset=1; shift ;;
      --writable-add) [[ $# -gt 0 ]] || die "--writable-add takes a quoted list"; wradd+=" $1"; wredit=1; shift ;;
      --writable-remove) [[ $# -gt 0 ]] || die "--writable-remove takes a quoted list"; wrrm+=" $1"; wredit=1; shift ;;
      --exclude-writable) excl=1 ;;
      --carry) carry=${1:?--carry takes a slug}; shift ;;
      --carry-untracked) carryu=1 ;;
      --file) tofile=1 ;;
      -*) die "unknown option $a" ;;
      *) repo=$a ;;
    esac
  done
  local main; main=$(main_of "$repo")
  production "$main" && die "$main is marked as a production checkout (onetree.production=true); remove the marker yourself before onboarding it"
  ensure_registered "$main"
  local was_guarded=0; guarded "$main" && was_guarded=1
  # edit the effective list instead of retyping it; the result is validated and stored like --writable
  if [[ $wredit == 1 ]]; then
    [[ $wrset == 0 ]] || die "--writable replaces the list; --writable-add and --writable-remove edit it: use one or the other"
    wr=$(wr_edit "$main" "$wradd" "$wrrm"); wrset=1; keys+=(writable); vals+=("$wr")
  fi
  if [[ $carryu == 1 && -z "$carry" ]]; then die "--carry-untracked goes with --carry <slug>"; fi
  local i target will_guard=0
  guarded "$main" && will_guard=1
  for i in "${!keys[@]}"; do
    [[ "${keys[$i]}" == guard && "${vals[$i]}" == true ]] && will_guard=1
    [[ "${keys[$i]}" == guard && "${vals[$i]}" == false ]] && will_guard=0
    case "${keys[$i]}" in
      remote|pushRemote)
        if [[ $tofile == 1 ]]; then die "--remote and --push-remote are per clone (a teammate's remotes may have other names); run without --file"; fi
        git -C "$main" config --get "remote.${vals[$i]}.url" >/dev/null 2>&1 || die "no remote named ${vals[$i]} in $main (git remote -v)" ;;
      ghUser) if [[ $tofile == 1 ]]; then die "--gh-user is per clone (a GitHub login is personal); run without --file"; fi ;;
    esac
  done
  if [[ $excl == 1 && $wrset == 0 ]]; then die "--exclude-writable goes with --writable"; fi
  if [[ $wrset == 1 ]]; then
    init_writable "$main" "$wr" "$excl"
    # stored as validated: ./ and // squeezed
    for i in "${!keys[@]}"; do [[ "${keys[$i]}" == writable ]] && vals[$i]=$INIT_WR; done
  fi
  if [[ $tofile == 1 ]] && { guarded "$main" || [[ $will_guard == 1 ]]; }; then
    die "onetree init --file on a guarded main: run it in a worktree and ship .onetree by PR"
  fi
  if [[ -n "$carry" ]]; then [[ $will_guard == 1 ]] || die "--carry moves a dirty main's work out before the lock; it goes with --guard"; fi
  if [[ $tofile == 1 ]]; then target=$( [[ -n "$repo" ]] && echo "$main" || git rev-parse --show-toplevel)/.onetree; [[ -f "$target" ]] || printf '[onetree]\n' >"$target"; fi
  for i in "${!keys[@]}"; do
    if [[ $tofile == 1 ]]; then git config -f "$target" "onetree.${keys[$i]}" "${vals[$i]}"; else git -C "$main" config --local "onetree.${keys[$i]}" "${vals[$i]}"; fi
  done
  CFG_DUMP_MAIN=   # the layers changed: read them again on the next lookup
  [[ $tofile == 1 && ${#keys[@]} -gt 0 ]] && echo "wrote $target (commit it so every clone gets the same behaviour)"
  mkdir -p "$(root_of "$main")"
  ignore_root "$main"; refresh_guarded
  if [[ $wrset == 1 ]]; then wr=$(wr_entries "$main" | tr '\n' ' '); wr=${wr% }; echo "writable: ${wr:-(none)}"; fi
  if [[ -n "$carry" ]] && ! carry_run "$main" "$carry" "$carryu"; then
    [[ $was_guarded == 1 ]] || { git -C "$main" config --local onetree.guard false; CFG_DUMP_MAIN=; refresh_guarded; }
    die "the carry did not finish, so nothing was locked$([[ $was_guarded == 1 ]] || printf ' and guard stays off'); main is as it was"
  fi
  if guarded "$main"; then
    lock_main "$main" 1 || { git -C "$main" config --local onetree.guard false; CFG_DUMP_MAIN=; refresh_guarded; die "could not lock $main as read-only; left guard=false"; }
  else
    unlock_main "$main" || true
  fi
  cmd_info "$main"
  integration_hint "$main" || true
}
# main add rm -> the effective writable list with the add entries appended (once) and the rm entries dropped, normalised
# like --writable
wr_edit() {
  local m=$1 e f out=() hit
  local -a cur=() add=() rm=()
  while IFS= read -r e; do [[ -n "$e" ]] && cur+=("$e"); done < <(wr_entries "$m")
  read -ra add <<<"$2"; read -ra rm <<<"$3"
  for e in ${rm[@]+"${rm[@]}"}; do
    while [[ "$e" == ./* ]]; do e=${e#./}; done; while [[ "$e" == *//* ]]; do e=${e//\/\//\/}; done
    hit=0; out=()
    for f in ${cur[@]+"${cur[@]}"}; do if [[ "$f" == "$e" || "$f" == "$e/" ]]; then hit=1; else out+=("$f"); fi; done
    cur=(${out[@]+"${out[@]}"})
    [[ $hit == 1 ]] || printf 'onetree: note: %s was not in the writable list\n' "$e" >&2
  done
  for e in ${add[@]+"${add[@]}"}; do
    while [[ "$e" == ./* ]]; do e=${e#./}; done; while [[ "$e" == *//* ]]; do e=${e//\/\//\/}; done
    for f in ${cur[@]+"${cur[@]}"}; do [[ "$f" == "$e" ]] && continue 2; done   # already listed: a no-op
    cur+=("$e")
  done
  printf '%s' "${cur[*]:-}"
}
# main list exclude — refuse a list that would hole the guard: a tracked path, a directory holding tracked files, a path
# git does not ignore. With exclude=1, untracked unignored paths are added to .git/info/exclude first.
init_writable() {
  local m=$1 list=$2 excl=$3 e gd gi bad="" probs n=0
  local -a raw=() es=()
  read -ra raw <<<"$list"
  for e in ${raw[@]+"${raw[@]}"}; do
    while [[ "$e" == ./* ]]; do e=${e#./}; done
    while [[ "$e" == *//* ]]; do e=${e//\/\//\/}; done
    case "/$e/" in //*|*/./*|*/../*|/.git/*|*[*?[]*) die "--writable: $e must be a path inside the repo (relative, no . or .., not .git, no glob)" ;; esac
    es+=("$e")
  done
  INIT_WR="${es[*]:-}"
  [[ ${#es[@]} -gt 0 ]] || return 0
  if [[ $excl == 1 ]]; then
    gd=$(_git_dir "$m"); gi="$gd/info/exclude"; mkdir -p "$gd/info"
    while IFS=$'\t' read -r e probs; do
      [[ "$probs" == "not ignored" ]] || continue
      grep -qxF -- "/$e" "$gi" 2>/dev/null && continue
      [[ -s "$gi" && -n "$(tail -c1 "$gi")" ]] && echo >>"$gi"
      printf '/%s\n' "$e" >>"$gi"; echo "added /$e to $gi"
    done < <(wr_problems "$m" "${es[@]}")
  fi
  while IFS=$'\t' read -r e probs; do
    [[ -n "$e" ]] || continue; n=$((n+1))
    case "$probs" in
      tracked) bad+="  $e is tracked: a tracked file is task work, it ships through a worktree and a PR"$'\n' ;;
      "tracked files inside") bad+="  $e holds tracked files: list the untracked, ignored subdirectory instead"$'\n' ;;
      "not ignored") bad+="  $e is not ignored by git, so it could carry task work. Either keep it local and writable: onetree init --writable \"$list\" --exclude-writable (adds it to .git/info/exclude), or leave it out and it stays read-only like the rest of the mirror"$'\n' ;;
    esac
  done < <(wr_problems "$m" "${es[@]}")
  [[ $n == 0 ]] || die "refusing --writable; each path must be untracked and gitignored:"$'\n'"${bad%$'\n'}"
  return 0
}
ignore_root() {  # a worktree root inside a git checkout: .git/info/exclude when guarded, else .gitignore
  local main=$1 root d top rel gi gd
  root=$(root_of "$main"); d=$root
  while [[ ! -d "$d" ]]; do d=$(dirname "$d"); done
  top=$(git -C "$d" rev-parse --show-toplevel 2>/dev/null) || return 0
  root="$(real "$d")${root#"$d"}"; [[ "$root" == "$top"/* ]] || return 0; rel=${root#"$top"/}
  git -C "$top" check-ignore -q "$rel/x" && return 0
  if guarded "$main"; then
    gd=$(git -C "$top" rev-parse --path-format=absolute --git-dir)
    mkdir -p "$gd/info"
    gi="$gd/info/exclude"
    grep -qx "/$rel/" "$gi" 2>/dev/null && return 0
    [[ -s "$gi" && -n "$(tail -c1 "$gi")" ]] && echo >>"$gi"
    echo "/$rel/" >>"$gi"; echo "added /$rel/ to $gi"
    return 0
  fi
  gi="$top/.gitignore"; [[ -s "$gi" && -n "$(tail -c1 "$gi")" ]] && echo >>"$gi"
  echo "/$rel/" >>"$gi"; echo "added /$rel/ to $gi (commit it)"
}
cmd_unregister() {
  local main; main=$(main_of "${1:-}"); local r
  if guarded "$main"; then unlock_main "$main" || true; git -C "$main" config --local onetree.guard false; CFG_DUMP_MAIN=; fi
  while IFS= read -r r; do [[ -n "$r" ]] || continue; [[ "$(real "$(tilde "$r")")" == "$main" ]] && git config -f "$CFG" --unset onetree.repo "^$(printf '%s' "$r" | sed 's/[.[\*^$]/\\&/g')\$"; done < <(gcfg_all onetree.repo)
  refresh_guarded; echo "unregistered $main (left onetree.guard=false in .git/config)"
}
cmd_repos() {
  local m; { printf 'REPO\tGUARD\tINTEGRATION\tROOT\tPATH\n'
    while IFS= read -r m; do [[ -n "$m" ]] || continue; printf '%s\t%s\t%s\t%s\t%s\n' "$(basename "$m")" "$(cfg guard "$m" false)" "$(integration "$m")" "$(root_of "$m")" "$m"; done < <(repos_all); } | tbl
}
cmd_info() {
  local json=0 target="" a; for a in "$@"; do [[ $a == --json ]] && json=1 || target=$a; done
  local main; main=$(main_of "$target"); local reg=no r; while IFS= read -r r; do [[ -n "$r" ]] || continue; [[ "$(real "$r")" == "$main" ]] && reg=yes; done < <(repos_all)
  if [[ $json == 1 ]]; then info_json "$main" | jq .; return 0; fi
  local int ghu wr k prod=no dev; int=$(integration "$main"); remotes_resolve "$main"
  production "$main" && prod=yes; dev=$(dev_clone "$main")
  printf 'repo          %s\nmain          %s\nregistered    %s\nproduction    %s\nproductionConflict %s\ndevClone      %s\nguard         %s\nintegration   %s\n' "$(basename "$main")" "$main" "$reg" "$prod" "$([[ $reg == yes && $prod == yes ]] && echo yes || echo no)" "${dev:-(not set)}" "$(cfg guard "$main" false)" "$int"
  printf 'remote        %s (%s) %s\npushRemote    %s (%s) %s\n' "$RB" "$RB_SRC" "$(remote_slug "$main" "$RB")" "$RP" "$RP_SRC" "$(remote_slug "$main" "$RP")"
  if cfg_find_clone ghUser "$main"; then ghu="$CFG_VAL ($CFG_SRC)"; else ghu="(gh's active account)"; fi
  wr=$(wr_entries "$main" | tr '\n' ' '); wr=${wr% }
  if lock_ignored "$main"; then wr="${wr:-(none)} (onetree.lockIgnored: listed paths only)"; else wr="gitignored paths${wr:+, and listed: $wr}"; fi
  deps_state "$main" "$main"
  printf 'ghUser        %s\nworktrees     %s/%s/<slug>\nbranch        %s<slug>\ncopy          %s\nkeep          %s\nkeepSource    %s\nwritable      %s\nbootstrap     %s\nstale         %sh\ndeps          %s\n' \
    "$ghu" "$(root_of "$main")" "$(basename "$main")" "$(prefix_of "$main")" "$(cfg copy "$main" ".env .env.local")" "$(cfg keep "$main" "(none)")" "$(cfg keepSource "$main" "$main")" "$wr" "$(cfg bootstrap "$main" "(auto: lockfile-based)")" "$(cfg stale "$main" 24)" \
    "$([[ $DEPS_STATE == none ]] && echo "(no package.json)" || echo "$DEPS_PM, $DEPS_STATE: $DEPS_WHY")"
  for k in $REM_SKIPPED; do printf 'onetree: warning: the committed .onetree sets %s; ignored, because it names something per clone. Set it with onetree init --%s\n' "$k" "$(case $k in pushRemote) echo push-remote ;; ghUser) echo gh-user ;; *) echo remote ;; esac) <value>" >&2; done
  [[ $reg == yes && $prod == yes ]] && printf 'onetree: warning: this production checkout is still registered; run `onetree unregister %s` in a terminal before leaving the marker set\n' "$main" >&2
  rem_url "$RB" >/dev/null || git -C "$main" config --get "remote.$RB.url" >/dev/null 2>&1 || printf 'onetree: warning: no remote named %s (git remote -v)\n' "$RB" >&2
  [[ "$RP" == "$RB" ]] || rem_url "$RP" >/dev/null || git -C "$main" config --get "remote.$RP.url" >/dev/null 2>&1 || printf 'onetree: warning: no remote named %s (git remote -v)\n' "$RP" >&2
  return 0
}
cmd_snippet() {
  local main; main=$(main_of "${1:-}"); local repo int root pfx g; repo=$(basename "$main"); int=$(integration "$main"); root=$(root_of "$main"); pfx=$(prefix_of "$main"); guarded "$main" && g=1 || g=0
  local fetch="git fetch" ship slug own gh="gh" wr
  remotes_resolve "$main"; [[ "$RB" == origin ]] || fetch="git fetch $RB"
  ship="open a GitHub PR into \`$int\`."
  if [[ "$RP" != "$RB" ]]; then   # a fork: say where the branch goes and which repo the PR opens on
    slug=$(gh_slug "$main"); own=$(remote_slug "$main" "$RP"); own=${own%/*}; own=${own##*/}
    cfg_find_clone ghUser "$main" && gh="GH_TOKEN=\$(gh auth token --user $CFG_VAL) gh"
    ship="push the branch to \`$RP\` (a bare \`git push -u\` does) and open the PR on \`$slug\` into \`$int\`:
  \`$gh pr create --repo $slug --base $int --head $own:<branch>\`."
  fi
  wr=$(wr_entries "$main" | tr '\n' ' '); wr=${wr% }
  cat <<EOS
# Worktrees in $repo (binding for every agent: Claude, Codex, pi, dsh)

$( [[ $g == 1 ]] && printf 'The main checkout `%s` is a read-only mirror: a hook blocks file edits, mutating git and chmod there, and its tracked files are filesystem `a-w` (`EACCES` on save; do not chmod).' "$main" || printf 'The main checkout is `%s`.' "$main" ) All task work happens in one worktree per task under
\`$root/$repo/<slug>\`, created only by \`onetree\` (\`onetree info\` prints these rules).

- **When a worktree is needed:** before the first action that changes state (file edits, git mutations, running
  scripts, deploys, backfills or database writes, starting servers or test suites). Read-only work can stay in the
  main checkout; read \`$RB/$int\` via \`$fetch\` + \`git show\`, not the working tree. When a read-only
  conversation turns into a change, create the worktree first, even mid-conversation.$( if [[ $g == 1 ]] && lock_ignored "$main"; then [[ -n "$wr" ]] && printf '\n  Local state stays writable in the mirror: `%s` (gitignored; a file entry takes in-place writes only).' "$wr"; elif [[ $g == 1 ]]; then printf '\n  Gitignored local state (dependencies, caches, `.env`) stays writable in the mirror; an ignored file in a locked directory takes in-place writes only.'; fi )
- **Starting a state-changing task$( [[ $g == 1 ]] && printf ' while your working directory is the mirror' ):** run \`onetree new <slug> $repo\` and work in the printed
  path; \`onetree new\` also prints how this agent moves there. Claude desktop app: call \`change_directory\` with
  the path (main conversation only; the app's panes then follow). dsh: its sandbox cannot run \`onetree new\`; call
  the \`onetree_new\` tool instead, then pass the path as \`workdir\` to every bash call and give file tools absolute
  paths under it, not \`cd\` (the plugin opens the worktree a call names as its \`workdir\` in the sandbox; one
  reached by \`cd\` inside a command it never sees). Everywhere else (Claude CLI or IDE, Codex, pi): prefix every command with
  \`cd <path> &&\` and edit by absolute path. State the path in your first reply.
  Never \`git checkout\`, \`switch\`, \`stash\`, \`reset\` or \`merge\` in the main checkout, never \`git worktree add\` by
  hand, never \`EnterWorktree\` (Claude Code then refuses shell commands it cannot prove stay in that one worktree).
- **Codex app worktrees:** the Codex app makes its own worktrees and runs its local environment's setup script (in
  \`.codex/environments\`) in each one; make that script run \`onetree bootstrap "\$CODEX_WORKTREE_PATH"\` so they get
  this repo's gitignored files and dependencies too.
- **Inside a worktree:** it is yours alone; never touch other worktrees or the main checkout. If the branch is a
  placeholder (\`${pfx}claude-…\`, \`${pfx}pi-…\`, \`${pfx}codex-…\`, \`${pfx}dsh-…\`) rename it before the first push:
  \`git branch -m ${pfx}<meaningful-slug>\`. If HEAD is detached, \`git switch -c ${pfx}<meaningful-slug>\` first.
  If a gitignored file or dependencies are missing, run \`onetree bootstrap\`. Run git from inside the worktree
  (\`cd <path> && git …\`), not through \`-C\` or \`GIT_DIR\` overrides.
- **Shipping:** $ship Never merge locally, never push to \`$int\`, never force-push.
  \`git fetch\` before every commit and every push; if the base moved, rebase and re-run the gates.
- **Done:** when the PR is merged say "worktree \`<path>\` is done" and stop. \`onetree gc\` runs hourly and removes a
  worktree only when it is clean, unlocked, idle, and its PR is merged at the worktree's head (or it holds no
  commits beyond \`$int\` and is older than $(cfg stale "$main" 24)h). A worktree another tool made is left to it.
EOS
}

# installed clients, verified 2026-10-20: Claude exports attended=0 for -p; Codex's hook ancestor is `codex exec ...`
session_noninteractive() {
  [[ "${CLAUDE_CODE_SESSION_ATTENDED:-}" == 0 ]] && return 0
  local p argv exe sub; p=${ONETREE_SESSION_PID:-$(agent_pid)}
  [[ "$p" =~ ^[0-9]+$ ]] || return 1
  argv=$(ps -ww -o command= -p "$p" 2>/dev/null || true)
  read -r exe sub _ <<<"$argv"
  [[ "${exe##*/}" == codex && "$sub" == exec ]]
}
# ---- session: the SessionStart hook, and the rules block each agent's instructions carry
# SessionStart hook: records the session; quiets non-interactive onboarding, never registered-repo safety guidance
cmd_session() {
  local j="" main r reg=no
  [[ -t 0 ]] || j=$(cat 2>/dev/null || true)
  [[ -z "$j" ]] || record_session "$j"
  main=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || { session_noninteractive || true; exit 0; }; main=$(real "$(dirname "$main")")
  while IFS= read -r r; do [[ -n "$r" ]] || continue; [[ "$(real "$r")" == "$main" ]] && reg=yes; done < <(repos_all)
  if production "$main"; then
    session_noninteractive && exit 0
    local dev; dev=$(dev_clone "$main")
    printf 'onetree: %s is a production checkout. Use it for read-only inspection only; do not edit files, mutate git, run scripts, services, tests, deploys or backfills here.%s Never offer onetree onboarding for this checkout.\n' "$(basename "$main")" "$([[ -n "$dev" ]] && printf ' Do development work in the separate clone: %s.' "$dev")"
  elif [[ $reg == no ]]; then
    session_noninteractive && exit 0
    printf 'onetree: %s is not set up for worktrees. Before creating any branch or worktree, ask the user once whether to onboard it (`onetree init --guard` makes this checkout a read-only mirror and routes every task through `onetree new <slug>`; `onetree init --no-guard` only registers it for `onetree gc`; skipping is fine). Run `onetree info` after onboarding.\n' "$(basename "$main")"
  elif r=$(guarded_main_of_path "$PWD"); then
    local wr note; wr=$(wr_entries "$r" 2>/dev/null | tr '\n' ' ' || true); wr=${wr% }
    if lock_ignored "$r"; then note=$([[ -n "$wr" ]] && printf ' Local state that belongs to this checkout stays writable here, without a worktree: %s (a file entry takes in-place writes only).' "$wr")
    else note=' Gitignored local state (dependencies, caches, .env, agent settings) stays writable here, without a worktree; an ignored file in a locked directory takes in-place writes only.'; fi
    # the pi extension and the dsh plugin say who is asking (the guard reads the same field): `pnpm dsh web` is a node
    # process with no dsh in its name. dsh's plugin asks from the folder the session was created in and sends the
    # session's working directory as cwd: inside a worktree of this checkout, that is where the session works
    local h own="" b; h=$(host_of)
    case "$(jq -r '.agent // empty' <<<"$j" 2>/dev/null)" in pi) h=pi ;; dsh) h=dsh; own=$(worktree_at "$(jq -r '.cwd // empty' <<<"$j" 2>/dev/null)" "$r") || own= ;; esac
    if [[ -n "$own" ]]; then
      b=$(git -C "$own" symbolic-ref -q --short HEAD 2>/dev/null || true)
      printf 'onetree: %s is a guarded read-only mirror, and this session works in a worktree of it, %s, on the branch %s: if that is still the placeholder, rename it before the first push (`git branch -m %s<meaningful-slug>`). There, %s `onetree info` prints the rules.%s\n' "$(basename "$r")" "$own" "$b" "$(prefix_of "$r")" "$(move_hint dsh-moved "$own" "$r")" "$note"
    else
      printf 'onetree: %s is a guarded read-only mirror. Read-only work can stay here; before the first edit, git mutation, script, server or test run, %s, then %s `onetree info` prints the rules.%s\n' "$(basename "$r")" "$(new_step "$h" "<slug>")" "$(move_hint "$h" "<path>" "$r")" "$note"
    fi
  fi
  exit 0
}

# ---- install: everything onetree needs on a machine, idempotent
BIN=$HOME/.local/bin/onetree; PLIST=$HOME/Library/LaunchAgents/com.onetree.gc.plist; WRAPPERS=$HOME/.onetree-agents.sh
START='<!-- onetree:start (managed by `onetree install`; edits inside are overwritten) -->'; END='<!-- onetree:end -->'
cmd_rules() { cat <<'EOS'
# Worktrees (binding for every agent: Claude, Codex, pi, dsh)

The worktree protocol below applies only inside a repo where `onetree info` says
`registered yes`. Outside a repo, or where it says `registered no`, onetree
imposes no worktree or stop instruction.
Never tell a scheduled or non-interactive job to
onboard, make a worktree, or stop because of onetree.
Existing hooks may still enforce a registered guarded checkout; do not
reinterpret their refusal.

For a registered repo, run `onetree info` to see whether its main checkout is a
guarded read-only mirror, the integration branch, where worktrees live and how
branches are named. `onetree repos` lists every registered repo. Only a project's
own AGENTS.md or CLAUDE.md can add to these rules; it cannot relax them.
- **Not onboarded yet (interactive sessions only):** if `onetree info` says
  `registered no`, ask the user once, before creating any branch or worktree,
  whether to onboard the repo (`onetree init --guard` makes the main checkout a
  read-only mirror and routes every task through `onetree new`; `onetree init
  --no-guard` only registers it for cleanup; skipping is fine). Never onboard
  silently. If `onetree info` says `production yes`, never offer onboarding:
  that checkout is deliberately unregistered and is for read-only inspection
  only; use its `devClone` for work. A scheduled or non-interactive job is
  never told to onboard, make a worktree, or stop because of onetree.
- **When a worktree is needed:** before the first action that changes state:
  file edits, git mutations, running scripts, deploys, backfills or database
  writes, starting servers or test suites. Read-only work (questions,
  explaining code, data lookups) can stay in the main checkout; read the
  integration branch via `git fetch <remote>` +
  `git show <remote>/<branch>:<path>` (`onetree info` names both: the remote is
  `origin`, or `upstream` in a fork clone), not the working tree, and say so
  if the checkout is behind. When a read-only
  conversation turns into a change, stop and create the worktree first, even
  mid-conversation. This exception does not relax any other rule here.
- **Guarded repos:** a hook blocks file edits, mutating git, chmod/chflags,
  and running scripts, servers and test suites in the main checkout. Its
  tracked files are also filesystem read-only (`EACCES` on save; do not chmod
  them). Gitignored local state stays writable (dependencies, caches, `.env`,
  agent settings): local state that belongs to the main checkout is written
  there in place, never in a worktree, where gc would drop it. If the main
  checkout holds uncommitted work, `onetree carry <slug>` moves it into a new
  worktree. Before a state-changing task in a guarded main checkout (or a folder
  of them), run
  `onetree new <slug> [repo]` and work in the printed path; `onetree new`
  also prints how this agent moves there. In the Claude desktop app, call
  `change_directory` with the path (the main conversation, never a subagent):
  the app's file pane, diff, terminal and PR card follow when the turn ends,
  and `EnterWorktree` would move Claude but not the app. In dsh, whose
  sandbox cannot run `onetree new`, call the `onetree_new` tool instead, then
  pass the path as `workdir` to every bash call and give file tools absolute
  paths under it, not `cd` (the plugin opens the worktree a call names as
  its `workdir` in the sandbox, never one reached by `cd`).
  Everywhere else (the Claude CLI or IDE, Codex, pi): prefix every command with
  `cd <worktree> &&` (the shell
  returns to the start folder between commands, and Codex's hook judges the
  command, never `workdir`) and edit by absolute path. In the Codex CLI the
  user can move the thread with `/cd <worktree>`; the Codex app's review pane
  stays where the thread started. State the path in your
  first reply. Never `git checkout`, `switch`, `stash`, `reset` or `merge` in a
  main checkout, never `git worktree add` by hand, never `EnterWorktree`: it
  binds the session to one worktree, and Claude Code then refuses any shell
  command it cannot prove stays inside it, in the session and its subagents.
  Unguarded repos are worked in directly unless the user asks for a
  worktree.
- **Inside a worktree:** it is yours alone; never touch other worktrees or the
  main checkout. If the branch is a placeholder (`…/claude-…`, `…/pi-…`,
  `…/codex-…`, `…/dsh-…`) rename it before the first push:
  `git branch -m <prefix><meaningful-slug>` (prefix from `onetree info`). If HEAD is
  detached, run `git switch -c <prefix><meaningful-slug>` first. If a
  gitignored file or dependencies are missing, run `onetree bootstrap`. Run git from
  inside the worktree (`cd <worktree> && git …`), not through `-C` or `GIT_DIR` overrides, so the
  repos' own hooks can see which checkout a command targets.
- **Shipping:** open a GitHub PR into the integration branch shown by
  `onetree info`, on the repo its `remote` line names, from a branch pushed to its
  `pushRemote` (in a fork clone `onetree snippet` prints the exact `gh pr create`).
  Never merge locally, never push to that branch, never force-push.
  `git fetch` before every commit and every push; if the base moved, rebase and
  re-run the gates.
- **Done:** when the PR is merged say "worktree `<path>` is done" and stop.
  `onetree gc` runs hourly. It removes a worktree only when it is clean, unlocked
  and no process is sitting in it, and either its PR is merged at the
  worktree's current head, its PR was closed and every commit is already
  pushed (past the stale window), or it holds no commits beyond the integration
  branch and is older than the repo's stale window; it also parks a clean guarded main
  checkout back on its integration branch once the branch it was left on has
  merged. A worktree another tool made (the Codex or Claude app's own) is
  left to that tool.
- **Shared runtime:** files are isolated; databases, caches and listening
  ports are not. Check `lsof -i :<port>` before binding one, and read the
  project's AGENTS.md for which ports it uses.
EOS
}
write_block() {  # file — replace or append the managed rules block
  local f=$1 tmp; mkdir -p "$(dirname "$f")"; tmp=$(mktemp)
  { if [[ -f "$f" ]]; then awk -v s="$START" -v e="$END" '$0==s{skip=1} !skip{print} $0==e{skip=0}' "$f"; fi
    [[ -s "$f" ]] && printf '\n'; printf '%s\n' "$START"; cmd_rules; printf '%s\n' "$END"; } | cat -s > "$tmp"
  cat "$tmp" > "$f"; rm -f "$tmp"   # through the file, not over it: a dotfiles symlink and the mode stay
}
strip_block() { local f=$1; [[ -f "$f" ]] || return 0; local tmp; tmp=$(mktemp); awk -v s="$START" -v e="$END" '$0==s{skip=1} !skip{print} $0==e{skip=0}' "$f" | cat -s > "$tmp"; cat "$tmp" > "$f"; rm -f "$tmp"; }
# the pi extension: guard and session hint like the Claude/Codex hooks, and since a pi session cannot change its folder,
# it follows the worktree its session made itself: commands run there and relative paths resolve there. Worktrees of a
# trusted
render_pi_extension() {
  local t
  t=$(cat <<'PIEXT'   # main are trusted (review checkouts never)
import { execFileSync, spawnSync } from "node:child_process";
import { existsSync, readFileSync, realpathSync } from "node:fs";
import { homedir } from "node:os";
import { basename, dirname, isAbsolute, join } from "node:path";

const ONETREE = "@ONETREE@";
const ENTRY = "onetree-worktree";
process.env.ONETREE_SESSION_PID = String(process.pid);   // whatever wraps a command, onetree finds this session by it

type Entry = { type?: string; customType?: string; data?: { path?: string } };
type Ctx = { cwd?: string; sessionManager?: { getBranch?: () => Entry[] } };
type Pi = { on: (ev: string, fn: (...a: never[]) => unknown) => void; appendEntry: (customType: string, data?: unknown) => void };

function run(args: string[], input?: string, cwd?: string) {
  return spawnSync(ONETREE, args, {
    encoding: "utf8",
    timeout: 15000,
    cwd: cwd || process.cwd(),
    input: input,
  });
}

function git(cwd: string, ...args: string[]) {
  return execFileSync("git", ["-C", cwd, ...args], { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }).trim();
}

function quote(s: string) {
  return "'" + s.split("'").join("'\"'\"'") + "'";
}

// A linked worktree whose main checkout the user trusts in trust.json (the nearest decided ancestor wins, as in pi) is trusted too.
function trustedWorktree(cwd: string) {
  try {
    const gitDir = git(cwd, "rev-parse", "--path-format=absolute", "--git-dir");
    const common = git(cwd, "rev-parse", "--path-format=absolute", "--git-common-dir");
    if (gitDir === common || existsSync(join(gitDir, "onetree-review")) || basename(cwd).startsWith("review-")) return false;
    const trust = JSON.parse(readFileSync(join(homedir(), ".pi", "agent", "trust.json"), "utf8")) as Record<string, boolean | null>;
    for (let d = realpathSync(dirname(common)); ; d = dirname(d)) {
      if (trust[d] === true) return true;
      if (trust[d] === false || d === dirname(d)) return false;
    }
  } catch {
    return false;
  }
}

export default function (pi: Pi) {
  let hinted = false;
  let worktree = "";
  const here = () => (worktree && existsSync(worktree) ? worktree : "");

  pi.on("session_start", (_event: unknown, ctx?: Ctx) => {
    hinted = false;
    worktree = "";
    const branch = (ctx && ctx.sessionManager && ctx.sessionManager.getBranch && ctx.sessionManager.getBranch()) || [];
    for (const e of branch) if (e && e.type === "custom" && e.customType === ENTRY && e.data && e.data.path) worktree = e.data.path;
  });

  pi.on("project_trust", (event: { cwd: string }) => ({ trusted: trustedWorktree(event.cwd) ? "yes" : "undecided" }));

  pi.on("before_agent_start", (_event: unknown, ctx?: Ctx) => {
    if (hinted) return;
    hinted = true;
    const cwd = (ctx && ctx.cwd) || process.cwd();
    const r = run(["session"], JSON.stringify({ agent: "pi", cwd: cwd }), cwd);
    const text = String(r.stdout || "").trim();
    if (text) {
      return {
        message: {
          customType: "onetree",
          content: text,
          display: true,
        },
      };
    }
  });

  pi.on("tool_result", (event: { toolName: string; input: { command?: string }; isError?: boolean }) => {
    if (event.toolName !== "bash" || event.isError || !/\bonetree\s+(new|carry)\b/.test(String(event.input.command || ""))) return;
    const path = String(run(["bound", "--pid", String(process.pid)]).stdout || "").trim();
    if (path && path !== worktree) {
      worktree = path;
      pi.appendEntry(ENTRY, { path: path });
    }
  });

  pi.on("tool_call", (event: { toolName: string; input: { command?: string; path?: string } }, ctx?: Ctx) => {
    const dir = here();
    const lead = "cd " + quote(dir) + " && ";
    if (dir && event.toolName === "bash" && event.input.command && !event.input.command.startsWith(lead)) {
      event.input.command = lead + event.input.command;
    } else if (dir && ["read", "write", "edit"].includes(event.toolName) && event.input.path && !isAbsolute(event.input.path) && !event.input.path.startsWith("~")) {
      event.input.path = join(dir, event.input.path);
    }
    let name = "";
    let body: { command?: string; file_path?: string } = {};
    if (event.toolName === "bash") {
      name = "Bash";
      body = { command: event.input.command };
    } else if (event.toolName === "write") {
      name = "Write";
      body = { file_path: event.input.path };
    } else if (event.toolName === "edit") {
      name = "Edit";
      body = { file_path: event.input.path };
    } else {
      return;
    }
    const cwd = (ctx && ctx.cwd) || process.cwd();
    const r = run(["guard"], JSON.stringify({
      tool_name: name,
      cwd: cwd,
      tool_input: body,
      agent: "pi",
    }), cwd);
    if (r.status === 0) return;
    const err = r.error && (r.error as { message?: string }).message;
    const reason = String(r.stderr || err || "onetree guard unavailable").trim();
    return { block: true, reason: reason };
  });
}
PIEXT
)
  printf '%s\n' "${t//@ONETREE@/$BIN}"
}
write_pi_extension() {  # ~/.pi/agent/extensions/onetree.ts
  mkdir -p "$HOME/.pi/agent/extensions"
  render_pi_extension > "$HOME/.pi/agent/extensions/onetree.ts"
}
# the dsh plugin follows a session's own working directory, which dsh stores and restores (resume, clear, compact,
# fork); onetree keeps no record of which session has which worktree (docs/design/dsh-session-worktree.md). When a
# session is announced (agent/created) with that directory in a guarded main checkout, the plugin runs `onetree auto dsh`
# there, outside dsh's sandbox, opens the worktree and what codex_grants lists in the session's sandbox (whose own root
# stays the folder the session was created in), moves the working directory there and says so in one message. A
# session already in a worktree only has it opened. Before each tool call it opens the worktree the working directory
# is in, if that is not done yet, and the worktree of the session's repository a call names (a bash workdir, a file
# tool's path), and asks onetree's guard, with dsh's tools mapped onto the shapes it reads and the call judged where it
# runs: a bash workdir, else the working directory. dsh lets a plugin allow or deny, never rewrite. Another worktree comes
# from the plugin's onetree_new tool, which runs `onetree new` outside the sandbox (#24)
render_dsh_plugin() {
  local t   # read, not $(cat <<…): bash 3.2 pairs the quotes of a here-document inside $(), and this text has apostrophes
  IFS= read -r -d '' t <<'DSHPLUGIN' || true
// onetree for dsh, managed by `onetree install`: a worktree for a session started in a guarded main checkout, the
// guard before each tool call, the session hint
import { execFile, spawnSync } from "node:child_process";
import { randomUUID } from "node:crypto";
import { existsSync, realpathSync } from "node:fs";
import { homedir } from "node:os";
import { dirname, join, resolve } from "node:path";

const ONETREE = "@ONETREE@";
const AUTO_MINUTES = 10;   // a worktree's bootstrap (a dependency install) can take minutes
export const name = "onetree";
// where dsh keeps each session's folder and its session.lock, which gc reads to see which sessions are loaded (issue #35)
const DSH_SESSIONS = join(resolve((process.env.DSH_HOME || "").trim() || join(homedir(), ".dsh")), "sessions");

function run(args, input, cwd) {
  return spawnSync(ONETREE, args, { encoding: "utf8", timeout: 15000, cwd: cwd || process.cwd(), input });
}
// gc's record of where a session works (onetree session, as a hook calls it); never waits, so never holds dsh up
function note(fields, cwd) {
  try {
    const c = execFile(ONETREE, ["session"], { cwd: cwd || process.cwd(), timeout: 15000 }, () => {});
    c.stdin.on("error", () => {});
    c.stdin.end(JSON.stringify({ agent: "dsh", dsh_sessions: DSH_SESSIONS, ...fields }));
  } catch (e) { /* gc then sees the session only by what it recorded before */ }
}
// never spawnSync for `auto`: it would stop the server, and every session it serves, for as long as bootstrap takes.
// The plain command the shell wrapper runs: `auto` binds its worktree to no session, whatever the environment holds
function auto(cwd, signal) {
  return new Promise(resolve => {
    execFile(ONETREE, ["auto", "dsh"], { encoding: "utf8", timeout: AUTO_MINUTES * 60000, cwd, signal },
      (error, stdout, stderr) => resolve({ error, tree: error ? "" : String(stdout || "").trim(), stderr: String(stderr || "").trim() }));
  });
}

// what a session's announcement still has to do (the tests wait on it); undefined once done
export function settled(agent) { return pending.get(agent && agent.session); }

// `onetree new <slug>` for the onetree_new tool, run where the session works, outside dsh's sandbox, and recorded as
// that session's (ONETREE_SESSION_ID). A cancelled call does not stop it (that would leave half a worktree); only the
// time limit `auto` has does
function newTree(slug, cwd, session_id) {
  return new Promise(resolve => {
    execFile(ONETREE, ["new", slug], { encoding: "utf8", timeout: AUTO_MINUTES * 60000, cwd, env: { ...process.env, ONETREE_HOST: "dsh", ONETREE_SESSION_ID: session_id } },
      (error, stdout, stderr) => resolve({ error, tree: error ? "" : String(stdout || "").trim().split("\n").pop(), stderr: String(stderr || "").trim() }));
  });
}

export function shape(tool, a) {
  a = a || {};
  if (tool === "bash") return { tool_name: "Bash", tool_input: { command: a.command, workdir: a.workdir } };
  if (tool === "write") return { tool_name: "Write", tool_input: { file_path: a.file_path } };
  if (tool === "edit") return { tool_name: "Edit", tool_input: { file_path: a.file_path } };
  if (tool === "str_replace_editor" && a.command !== "view") return { tool_name: "Write", tool_input: { file_path: a.path } };
  return null;
}

// the folder a call names, resolved against where it runs: a bash workdir, or the folder of a file tool's path
export function named(tool, a, cwd) {
  a = a || {};
  const p = tool === "bash" ? a.workdir : tool === "write" || tool === "edit" ? a.file_path : tool === "str_replace_editor" ? a.path : undefined;
  if (typeof p !== "string" || !p) return "";
  const full = resolve(cwd, p);
  return tool === "bash" ? full : dirname(full);
}

// neither service is in every profile: without the working directory a session cannot be moved, without the policy
// there is no sandbox to open
let policy = null, directory = null;
const agents = new Map();        // session id -> live agent: where a subagent's parent is found
const opened = new WeakMap();    // session object -> the folders its sandbox is open for: worktree roots, and working directories settled
const waiting = new WeakMap();   // session object -> the worktree made for it that it has not been moved into yet
const recorded = new WeakMap();  // session object -> the working directory gc's record holds for it
const roots = new WeakMap();     // session object -> the worktree roots opened in its sandbox, which gc's record lists
const pending = new WeakMap();   // session object -> its announcement, still being handled: the session shows at once, its first tool call waits

// where a call runs when it names no folder: the session's working directory, which this plugin (or the agent) may
// have moved; the folder it was created in when the profile has no working-directory service
async function here(agent, signal) {
  const header = (agent && agent.session && agent.session.header) || {};
  let cwd = header.cwd || process.cwd();
  if (directory && agent) { try { cwd = await directory.ensure(agent, signal); } catch (e) { /* judged where it was created */ } }
  return { cwd, session_id: header.id || "" };
}

// Open the session's sandbox for the worktree dir is in: its root and what `onetree codex-grants` lists, by real path
// (the sandbox refuses a call outright over a root that is not one), all or nothing. A grant lasts for the live
// session object, so the state is kept per session object and worktree root: made again after a resume, and for
// another worktree when the working directory changes. -> "" when open, or there is nothing to open (a main checkout,
// no sandbox policy in the profile); else why not. mustList: dir is a worktree, so an empty list is a failure
function open(session, dir, mustList) {
  if (!policy || !session) return "";
  let done = opened.get(session);
  if (!done) opened.set(session, done = new Set());
  if (done.has(dir)) return "";
  const r = run(["codex-grants", dir]);
  const dirs = String(r.stdout || "").split("\n").filter(d => d && d !== "--add-dir");
  if (r.status !== 0) return "`onetree codex-grants` failed";
  if (!dirs.length) {
    if (mustList) return "`onetree codex-grants` listed no git folders for it";
    done.add(dir); return "";
  }
  const top = spawnSync("git", ["-C", dir, "rev-parse", "--show-toplevel"], { encoding: "utf8", timeout: 15000 });
  if (top.status !== 0) return "git could not name the worktree " + dir + " is in";
  const made = [];
  let root;
  try {
    root = realpathSync.native(String(top.stdout).trim());
    if (!done.has(root)) for (const d of [root, ...dirs]) made.push(policy.registerWritableRoot(session, realpathSync.native(d)));
    done.add(root); done.add(dir);
  } catch (e) {
    for (const undo of made) { if (typeof undo === "function") undo(); }   // the next try starts clean
    return String((e && e.message) || e);
  }
  if (made.length) {   // gc keeps every worktree a loaded session has open: removing one would fail all its writes (#22)
    let set = roots.get(session);
    if (!set) roots.set(session, set = new Set());
    set.add(root);
    const id = session.header && session.header.id;
    if (id) note({ session_id: id, opened: [...set] }, root);
  }
  return "";
}
// git's common dir for dir, by real path: which repository it belongs to; "" outside one
function repoOf(dir) {
  const r = spawnSync("git", ["-C", dir, "rev-parse", "--path-format=absolute", "--git-common-dir"], { encoding: "utf8", timeout: 15000 });
  if (r.status !== 0) return "";
  try { return realpathSync.native(String(r.stdout).trim()); } catch (e) { return ""; }
}
// A worktree a call names (a bash workdir, a file tool's path) is opened when it belongs to the repository the session
// was created in: a session may work in several of its worktrees (#24). A folder of another repository is never
// opened by onetree; dsh asks the user about it as about any folder outside the sandbox
const homeRepo = new WeakMap();   // session object -> repoOf(the folder it was created in)
function openNamed(session, dir) {
  if (!policy || !session || !dir) return;
  let d = dir;
  while (!existsSync(d) && dirname(d) !== d) d = dirname(d);
  let done = opened.get(session);
  if (!done) opened.set(session, done = new Set());
  if (done.has(d)) return;
  if (!homeRepo.has(session)) homeRepo.set(session, repoOf((session.header && session.header.cwd) || ""));
  const home = homeRepo.get(session), repo = repoOf(d);
  if (home && repo === home) open(session, d, false);
  else done.add(d);   // not this repository's: asked once
}
// grants first, then the move: a session is moved only into a worktree its sandbox lets it write and commit in.
// -> "" when moved, else why not; tried again before each tool call
async function enter(agent, signal) {
  const tree = waiting.get(agent.session);
  const why = open(agent.session, tree, true);
  if (why) return "dsh's sandbox could not be opened for it: " + why;
  try { await directory.set(agent, tree, signal); } catch (e) { return String((e && e.message) || e); }
  waiting.delete(agent.session);
  return "";
}

async function settle(agent, signal) {
  const session = agent && agent.session;
  if (!session) return;
  const header = session.header || {};
  if (header.id) agents.set(header.id, agent);
  let at = (await here(agent, signal)).cwd, note = "";
  if (header.origin === "subagent") {
    // dsh starts a subagent in its parent's working directory. One it left in the folder of its header (the parent's
    // original folder) is put where the parent works; with the parent unknown it stays. Never a worktree of its own
    const parent = agents.get(header.parentSession);
    if (directory && parent && at === header.cwd) {
      const to = (await here(parent, signal)).cwd;
      if (to !== at) { try { at = await directory.set(agent, to, signal); } catch (e) { /* stays where dsh put it */ } }
    }
  } else if (directory && (waiting.has(session) || run(["auto", "--check"], "", at).status === 0)) {
    if (!waiting.has(session)) {   // one made earlier and not entered yet is entered now, not made again
      const r = await auto(at, signal);
      if (r.tree) waiting.set(session, realpathSync.native(r.tree));
      else {
        const why = r.error && r.error.killed ? "`onetree auto dsh` did not finish in " + AUTO_MINUTES + " minutes" : r.stderr.split("\n").pop() || String((r.error && r.error.message) || "no worktree was printed");
        note = "onetree: could not make a worktree for this session (" + why + "), so it stays in " + at + ", the read-only main checkout.";
      }
    }
    const tree = waiting.get(session);
    if (tree) {
      const why = await enter(agent, signal);
      if (why) note = "onetree: a worktree for this session was made at " + tree + ", but the session was not moved into it (" + why + "), so it stays in " + at + ", the read-only main checkout. onetree tries again before each tool call.";
      else at = tree;
    }
  }
  const why = open(session, at);   // already in a worktree (a resume, a fork, a subagent, a session started there): opened, nothing made or moved
  if (why && !note) note = "onetree: dsh's sandbox could not be opened for the worktree this session works in, " + at + " (" + why + "), so writes and commits there fail. onetree tries again before each tool call.";
  // asked from the folder the session was created in: for a session moved out of a main checkout, the checkout the hint is about
  const hint = String(run(["session"], JSON.stringify({ cwd: at, session_id: header.id || "", agent: "dsh", dsh_sessions: DSH_SESSIONS }), header.cwd || at).stdout || "").trim();
  recorded.set(session, at);
  const text = waiting.has(session) ? note : [note, hint].filter(Boolean).join("\n");   // not moved yet: the hint would say to make a worktree
  if (text && agent.inject) {
    agent.inject(Object.freeze({ id: randomUUID(), role: "user", content: [{ type: "text", text }], source: { kind: "onetree" } }));   // dsh refuses the retired { kind: "plugin" } wrapper: a producer names its own kind
  }
}

// dsh's sandbox cannot run `onetree new` (it writes the worktree root, onetree's config and log outside it), so a session
// that wants another worktree of its repository asks for one here (#24). The session does not move: it may work in
// several, each named as a workdir
const NEW_TOOL = {
  name: "onetree_new",
  description: "Make a git worktree for one task in the repository this session works in. onetree guards that repository's main checkout, and dsh's sandbox cannot run `onetree new`, so this tool runs it outside the sandbox: it fetches, cuts a branch from the integration branch, installs dependencies (this can take a few minutes), records the worktree as this session's and opens it in this session's sandbox. Calling it again with the same slug returns the same worktree. This session's working directory does not change: pass the returned path as `workdir` to every bash call there and give file tools absolute paths under it, not `cd` (the sandbox is opened for a call's `workdir`, never for a folder reached by `cd`).",
  parameters: {
    type: "object",
    properties: { slug: { type: "string", description: "Short name for the task: letters, digits, . _ - only, starting with a letter or digit. The worktree folder and its branch (the repository's prefix plus the slug) are named after it." } },
    required: ["slug"],
  },
  output: { schema: { type: "string" }, render: (_args, value) => [{ type: "text", text: String(value) }] },
  timeoutMs: AUTO_MINUTES * 60000 + 30000,
  async execute(args, exec) {
    const slug = args && typeof args.slug === "string" ? args.slug.trim() : "";
    if (!/^[A-Za-z0-9][A-Za-z0-9._-]*$/.test(slug)) throw new Error("slug: letters, digits, . _ - only, starting with a letter or digit");
    const agent = exec && exec.agent, session = agent && agent.session;
    if (!session) throw new Error("onetree_new: no session called it");
    if (pending.has(session)) await pending.get(session);   // its first worktree first
    const w = await here(agent, exec.signal);
    const r = await newTree(slug, w.cwd, w.session_id);
    if (!r.tree) {
      const why = r.error && r.error.killed ? "`onetree new` did not finish in " + AUTO_MINUTES + " minutes" : r.stderr.split("\n").filter(Boolean).pop() || String((r.error && r.error.message) || "no worktree was printed");
      throw new Error("onetree could not make the worktree: " + why);
    }
    const tree = realpathSync.native(r.tree);
    const branch = String(spawnSync("git", ["-C", tree, "symbolic-ref", "-q", "--short", "HEAD"], { encoding: "utf8", timeout: 15000 }).stdout || "").trim();
    const why = open(session, tree, true);
    if (why) throw new Error("onetree made the worktree " + tree + (branch ? " on the branch " + branch : "") + ", but dsh's sandbox could not be opened for it (" + why + "), so writes there fail. onetree tries again before each tool call that names it.");
    const next = r.stderr.split("\n").filter(l => l.startsWith("onetree: next,")).pop();
    return ["The worktree " + tree + (branch ? " on the branch " + branch : "") + " is ready and open in this session's sandbox.", next || "Pass `workdir` " + tree + " to every bash call there and give file tools absolute paths under it."].join("\n");
  },
};

export function apply(ctx) {
  if (ctx.inject) {
    ctx.inject(["sandboxPolicy"], scope => { policy = scope.sandboxPolicy; });
    ctx.inject(["workingDirectory"], scope => { directory = scope.workingDirectory; });
    ctx.inject(["tools"], scope => { scope.tools.register(NEW_TOOL); });
  }
  ctx.on("tools/pre-execute", async (exec, next) => {
    const agent = exec.agent, session = agent && agent.session;
    if (session && pending.has(session)) await pending.get(session);
    if (session && directory && waiting.has(session)) await enter(agent, exec.signal);
    const w = await here(agent, exec.signal);
    if (session && w.session_id && recorded.get(session) !== w.cwd) { recorded.set(session, w.cwd); note({ session_id: w.session_id, cwd: w.cwd }, w.cwd); }
    open(session, w.cwd);   // the sandbox is the enforcement: a worktree that is not open yet fails writes there, and is tried again on the next call
    openNamed(session, named(exec.name, exec.arguments, w.cwd));
    const call = shape(exec.name, exec.arguments);
    if (!call) return next();
    const r = run(["guard"], JSON.stringify({ ...call, ...w, agent: "dsh" }), w.cwd);
    if (r.status === 0) return next();
    return { kind: "deny", reason: String(r.stderr || (r.error && r.error.message) || "onetree guard unavailable").trim() };
  });
  // dsh shows a new session only once every agent/created listener returns, and a worktree takes seconds to make: it is made
  // after the listener returns, without the creation's signal, and the session's first tool call waits for it. A listener
  // that throws fails the session's creation: whatever goes wrong here, the guard still stands
  ctx.on("agent/created", ({ agent }) => {
    const session = agent && agent.session;
    const done = settle(agent).catch(() => { /* the session starts where it was created */ });
    if (session) { pending.set(session, done); done.then(() => { if (pending.get(session) === done) pending.delete(session); }); }
  });
  // an archived session is done with its worktree, though dsh keeps it loaded (and its lock held) until the server stops
  const archived = flag => ({ sessionId }) => {
    const live = agents.get(sessionId), cwd = live && recorded.get(live.session);
    if (sessionId) note({ session_id: sessionId, archived: flag, ...(cwd ? { cwd } : {}) }, cwd);
  };
  ctx.on("workspace/session-archived", archived(true));
  ctx.on("workspace/session-unarchiving", archived(false));
  ctx.on("agent/disposed", ({ agent }) => {
    const id = agent && agent.session && agent.session.header && agent.session.header.id;
    if (agents.get(id) === agent) agents.delete(id);
  });
}
DSHPLUGIN
  printf '%s' "${t//@ONETREE@/$BIN}"
}
# A Codex under workspace-write may write only its writable roots, and .git is always read-only inside them, so a commit
# in a worktree fails. Grant exactly what onetree's workflow writes there: objects, the worktree's own git dir (index,
# HEAD, rebase state), the branch's own namespace (refs/heads/feature/ and its reflogs; never refs/heads, where the
# integration branch lives, so a branch with no prefix gets none), and the remotes' tracking refs for fetch and push.
# Never .git itself: config and hooks stay read-only, so `git push -u` cannot record an upstream (push with `git push
# <remote> HEAD`) and `git config` fails. Fetch must not write FETCH_HEAD, and auto gc and maintenance must not run:
# CODEX_GIT says so through GIT_CONFIG_PARAMETERS, whose name Codex passes on (it drops variables named *KEY*, so
# GIT_CONFIG_KEY_n would vanish).
CODEX_GIT="'fetch.writefetchhead=false' 'maintenance.auto=false' 'gc.auto=0'"
# worktree — the --add-dir arguments, one word per line; a directory that will hold refs is created now
codex_grants() {
  local c g b x r rc=0
  c=$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 0
  g=$(git -C "$1" rev-parse --path-format=absolute --git-dir 2>/dev/null) || return 0
  [[ "$g" != "$c" ]] || return 0   # a main checkout: its git dir is .git itself, which is never granted
  printf '%s\n%s\n%s\n%s\n' --add-dir "$c/objects" --add-dir "$g"
  b=$(git -C "$1" symbolic-ref -q HEAD 2>/dev/null || true)
  # a directory that cannot be made is a grant missing: the rest is still listed, but the exit says the list is short
  if [[ "$b" == refs/heads/*/* ]]; then for x in "$c/${b%/*}" "$c/logs/${b%/*}"; do _grant_dir "$x" || rc=1; done; fi
  while IFS= read -r r; do
    [[ -n "$r" ]] || continue
    for x in "$c/refs/remotes/$r" "$c/logs/refs/remotes/$r"; do _grant_dir "$x" || rc=1; done
  done < <(git -C "$1" remote 2>/dev/null)
  return $rc
}
_grant_dir() { mkdir -p "$1" 2>/dev/null && [[ -d "$1" ]] && { printf '%s\n%s\n' --add-dir "$1"; return 0; }; printf 'onetree: codex-grants: cannot prepare %s\n' "$1" >&2; return 1; }
# seconds command… — killed after that long (macOS has no timeout)
bounded() { perl -e 'alarm shift @ARGV; exec { $ARGV[0] } @ARGV or exit 127' "$@"; }
YSTART='# onetree:start (managed by `onetree install`; edits inside are overwritten)'; YEND='# onetree:end'
# ~/.dsh/onetree-plugin.mjs, loaded for every dsh profile by a managed insert row in ~/.dsh/cordis.patch.yml
write_dsh_plugin() {
  local f=$HOME/.dsh/cordis.patch.yml tmp; tmp=$(mktemp)
  render_dsh_plugin > "$HOME/.dsh/onetree-plugin.mjs"
  { if [[ -f "$f" ]]; then awk -v s="$YSTART" -v e="$YEND" '$0==s{skip=1} !skip{print} $0==e{skip=0}' "$f"; fi
    printf '%s\n- insert:\n    - id: onetree\n      name: %s\n%s\n' "$YSTART" "'$HOME/.dsh/onetree-plugin.mjs'" "$YEND"; } | cat -s > "$tmp"
  mv "$tmp" "$f"
}
HOOK_RE='/onetree (guard|hook-create|hook-remove|session)$'   # a hook command onetree installed
# Codex keys each hook's trust by its position (codex_trust), so a reinstall keeps onetree's group where it is and
# writes only on a change. onetree owns handlers, not groups: a group of only onetree's handlers is its own, and in a
# group shared with the user's handlers only onetree's are taken out, the rest kept in order. A handler with no command
# (an MCP tool hook) is never onetree's.
hook_json() {  # file add|pre|remove — Claude and Codex share the hooks schema
  local f=$1 mode=$2 tmp; [[ -f "$f" ]] || printf '{}\n' > "$f"; tmp=$(mktemp)
  jq --arg bin "$BIN" --arg mode "$mode" --arg re "$HOOK_RE" '
    def mine: (.command // "") | test($re);
    def ours: (.hooks // []) | length > 0 and all(mine);
    def strip: if .hooks then .hooks |= map(select(mine | not)) else . end;
    def put($g): (. // []) as $a | ($a | map(ours) | index(true)) as $i
      | [$a | to_entries[] | if .key == $i then ($g // empty) elif (.value | ours) then empty else (.value | strip) end]
      | if $i == null and $g != null then . + [$g] else . end;
    ($mode == "add" or $mode == "pre") as $pre | ($mode == "add") as $worktree_hooks
    | .hooks = (.hooks // {})
    | .hooks.PreToolUse |= put(if $pre then {matcher:"Edit|Write|MultiEdit|NotebookEdit|Bash|apply_patch", hooks:[{type:"command", command:($bin+" guard"), timeout:20}]} else null end)
    | .hooks.SessionStart |= put(if $pre then {hooks:[{type:"command", command:($bin+" session"), timeout:10}]} else null end)
    | .hooks.WorktreeCreate |= put(if $worktree_hooks then {hooks:[{type:"command", command:($bin+" hook-create"), timeout:600}]} else null end)
    | .hooks.WorktreeRemove |= put(if $worktree_hooks then {hooks:[{type:"command", command:($bin+" hook-remove"), timeout:120}]} else null end)
    | .hooks |= with_entries(select(.value | length > 0)) | if (.hooks | length) == 0 then del(.hooks) else . end' "$f" > "$tmp" || { rm -f "$tmp"; return 1; }
  cmp -s "$tmp" "$f" || cat "$tmp" > "$f"; rm -f "$tmp"
}
sha256() { if command -v shasum >/dev/null 2>&1; then shasum -a 256; else sha256sum; fi | cut -d' ' -f1; }
# Codex runs a hook only while the sha256 of its normalised form (sorted compact JSON of event, matcher and handler,
# defaults filled in) equals the trusted_hash saved in config.toml under
# hooks.state."<hooks.json>:<event>:<group>:<handler>" when the user approved it with /hooks. Any edit to the hook,
# renaming onetree's binary included, leaves it untrusted, and Codex then skips it without a word.
codex_trust() {  # -> "key<TAB>hash<TAB>trusted hash" for each onetree hook in ~/.codex/hooks.json (the last field empty when never approved)
  local f=$HOME/.codex/hooks.json c=$HOME/.codex/config.toml key json us=$'\x1f'
  [[ -f "$f" ]] || return 0
  jq -r --arg f "$f" --arg re "$HOOK_RE" '
    def sorted: if type == "object" then to_entries | sort_by(.key) | map(.value |= sorted) | from_entries elif type == "array" then map(sorted) else . end;
    def snake: gsub("(?<a>[a-z])(?<b>[A-Z])"; "\(.a)_\(.b)") | ascii_downcase;
    (.hooks // {}) | to_entries[] | .key as $ev | .value | to_entries[] | .key as $gi | .value as $g
    | ($g.hooks // []) | to_entries[] | select(.value.command // "" | test($re)) | .key as $hi | .value as $h
    | {event_name: ($ev | snake),
       hooks: [{type: ($h.type // "command"), command: $h.command, timeout: ($h.timeout // 600), async: ($h.async // false)}
               + (if $h.statusMessage then {statusMessage: $h.statusMessage} else {} end)]}
    + (if $g.matcher != null and ($ev | IN("UserPromptSubmit", "Stop") | not) then {matcher: $g.matcher} else {} end)
    | "\($f):\($ev | snake):\($gi):\($hi)\u001f\(sorted | tojson)"' "$f" 2>/dev/null |
  while IFS=$us read -r key json; do
    printf '%s\t%s\t%s\n' "$key" "sha256:$(printf '%s' "$json" | sha256)" \
      "$([[ -f "$c" ]] && awk -v h="[hooks.state.\"$key\"]" '/^\[/ { in_ = ($0 == h); next } in_ && /^[ \t]*trusted_hash[ \t]*=/ { sub(/^[^=]*=[ \t]*"/, ""); sub(/".*$/, ""); print; exit }' "$c")"
  done
}
codex_trusted() { local rows; rows=$(codex_trust) && [[ -n "$rows" ]] && ! awk -F'\t' '$2 != $3 { bad = 1 } END { exit !bad }' <<<"$rows"; }
install_gc() {
  local path; path="$(dirname "$BIN"):$PATH"
  if [[ "$(uname)" == Darwin ]]; then
    mkdir -p "$(dirname "$PLIST")" "$HOME/Library/Logs"
    launchctl bootout "gui/$(id -u)/com.onetree.gc" 2>/dev/null || true
    cat > "$PLIST" <<EOS
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.onetree.gc</string>
  <key>ProgramArguments</key><array><string>$BIN</string><string>gc</string><string>--all</string></array>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>$HOME/Library/Logs/onetree.log</string>
  <key>StandardErrorPath</key><string>$HOME/Library/Logs/onetree.log</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>$path</string><key>HOME</key><string>$HOME</string></dict>
</dict></plist>
EOS
    launchctl bootstrap "gui/$(id -u)" "$PLIST" && echo "gc: launchd com.onetree.gc, hourly, log ~/Library/Logs/onetree.log (macOS will mention a new login item)"
  else
    { crontab -l 2>/dev/null | grep -v 'onetree gc --all' || true; echo "0 * * * * PATH=$path $BIN gc --all >> \$HOME/.onetree-gc.log 2>&1"; } | crontab - && echo "gc: crontab entry, hourly, log ~/.onetree-gc.log"
  fi
}
cmd_install() {
  local src; src=$(realfile "$0"); mkdir -p "$(dirname "$BIN")" "$(dirname "$CFG")"
  if [[ "$src" != "$BIN" ]]; then   # a copy, not a symlink: launchd/cron may not be allowed into ~/Documents or similar
    rm -f "$BIN"; cp "$src" "$BIN"; chmod +x "$BIN"; git config -f "$CFG" onetree.source "$(dirname "$(dirname "$src")")"; echo "installed $BIN (copied from $src; \`onetree update\` pulls and re-copies)"; fi
  for t in git jq gh lsof; do command -v "$t" >/dev/null || echo "WARNING: $t not found; install it (gh: PR state for gc; lsof: live-process check)"; done
  # shellcheck disable=SC2088  # stored literally; expanded when read
  gcfg onetree.root >/dev/null || git config -f "$CFG" onetree.root '~/worktrees'
  hook_json "$HOME/.claude/settings.json" add && echo "hooks: ~/.claude/settings.json (PreToolUse, SessionStart, WorktreeCreate, WorktreeRemove)"
  [[ -d "$HOME/.codex" ]] && hook_json "$HOME/.codex/hooks.json" pre && echo "hooks: ~/.codex/hooks.json (PreToolUse, SessionStart)"
  [[ -d "$HOME/.codex" ]] && ! codex_trusted && echo "NOTE: Codex skips onetree's hooks until you approve them: run codex, type /hooks, and approve the onetree entries it lists as new or modified."
  write_block "$HOME/.claude/CLAUDE.md"; echo "rules: ~/.claude/CLAUDE.md"
  [[ -d "$HOME/.codex" ]] && { write_block "$HOME/.codex/AGENTS.md"; echo "rules: ~/.codex/AGENTS.md"; }
  [[ -d "$HOME/.pi/agent" ]] && { write_block "$HOME/.pi/agent/AGENTS.md"; echo "rules: ~/.pi/agent/AGENTS.md"; write_pi_extension; echo "pi: ~/.pi/agent/extensions/onetree.ts (tool_call + session)"; }
  [[ -d "$HOME/.dsh" ]] && { write_block "$HOME/.dsh/AGENTS.md"; echo "rules: ~/.dsh/AGENTS.md (dsh loads this as user-global instructions)"; }
  [[ -d "$HOME/.dsh" ]] && { write_dsh_plugin; echo "dsh: ~/.dsh/onetree-plugin.mjs, loaded by ~/.dsh/cordis.patch.yml (guard + session)"; }
  render_wrappers > "$WRAPPERS"; rm -f "$HOME/.onetree-agents.zsh"   # the file's earlier name
  for f in "$HOME/.zshrc" "$HOME/.bashrc"; do
    [[ "$f" == "$HOME/.zshrc" || -f "$f" ]] || continue
    if grep -q 'onetree-agents\.zsh' "$f" 2>/dev/null; then   # repoint a line that sources the earlier name, in place (a dotfiles symlink stays one)
      tmp=$(mktemp); sed 's/onetree-agents\.zsh/onetree-agents.sh/g' "$f" > "$tmp"; cat "$tmp" > "$f"; rm -f "$tmp"
    fi
    grep -q 'onetree-agents\.sh' "$f" 2>/dev/null || printf '\n[ -f ~/.onetree-agents.sh ] && source ~/.onetree-agents.sh\n' >> "$f"
  done
  echo "shell: ~/.onetree-agents.sh sourced from ~/.zshrc$([[ -f "$HOME/.bashrc" ]] && printf ' and ~/.bashrc') (claude/codex/pi/dsh started in a guarded mirror get a worktree; creation failure refuses to start; other shells and programs: onetree launch)"
  install_gc
  case ":$PATH:" in *":$(dirname "$BIN"):"*) ;; *) echo "NOTE: add $(dirname "$BIN") to PATH";; esac
  echo "done. next: cd <repo> && onetree init --guard   (or --no-guard);  onetree doctor"
}
cmd_uninstall() {
  local m f
  while IFS= read -r m; do [[ -n "$m" ]] || continue; guarded "$m" && unlock_main "$m" || true; done < <(repos_all)
  if [[ "$(uname)" == Darwin ]]; then launchctl bootout "gui/$(id -u)/com.onetree.gc" 2>/dev/null || true; rm -f "$PLIST"; else crontab -l 2>/dev/null | grep -v 'onetree gc --all' | crontab - || true; fi
  hook_json "$HOME/.claude/settings.json" remove; [[ -f "$HOME/.codex/hooks.json" ]] && hook_json "$HOME/.codex/hooks.json" remove
  strip_block "$HOME/.claude/CLAUDE.md"; strip_block "$HOME/.codex/AGENTS.md"; strip_block "$HOME/.pi/agent/AGENTS.md"; strip_block "$HOME/.dsh/AGENTS.md"
  rm -f "$HOME/.pi/agent/extensions/onetree.ts" "$HOME/.dsh/onetree-plugin.mjs"
  if [[ -f "$HOME/.dsh/cordis.patch.yml" ]]; then tmp=$(mktemp); awk -v s="$YSTART" -v e="$YEND" '$0==s{skip=1} !skip{print} $0==e{skip=0}' "$HOME/.dsh/cordis.patch.yml" | cat -s > "$tmp"; cat "$tmp" > "$HOME/.dsh/cordis.patch.yml"; rm -f "$tmp"; fi
  rm -f "$WRAPPERS" "$HOME/.onetree-agents.zsh"
  for f in "$HOME/.zshrc" "$HOME/.bashrc"; do [[ -f "$f" ]] && { tmp=$(mktemp); grep -vE 'onetree-agents\.z?sh' "$f" > "$tmp"; cat "$tmp" > "$f"; rm -f "$tmp"; }; done
  rm -f "$BIN"; rm -rf "$SESSIONS"
  echo "uninstalled. kept: $CFG (registry), $EVENTS (event log), each repo's .git/config [onetree], existing worktrees."
}
cmd_update() {
  local src; src=$(gcfg onetree.source) || die "no onetree.source in $CFG: run install from a git checkout of onetree"
  [[ -x "$src/bin/onetree" ]] || die "$src/bin/onetree missing"
  local bp=${ONETREE_BREW_PREFIX:-} tag
  [[ -n "$bp" ]] || ! command -v brew >/dev/null || bp=$(brew --prefix)
  if [[ -n "$bp" && "$(real "$src")/" == "$(real "$bp")/"* ]]; then   # brew's own onetree, not the stale copy in ~/.local/bin, must reinstall
    echo "onetree: installed with Homebrew; update with: brew upgrade onetree && $bp/bin/onetree install"; return 0; fi
  if git -C "$src" symbolic-ref -q HEAD >/dev/null; then git -C "$src" pull -q --ff-only   # a contributor clone: its branch
  else   # a release install, detached at a tag: the newest vX.Y.Z by version order, never a pre-release
    git -C "$src" fetch -q --tags origin || die "update: fetching tags into $src failed"
    tag=$(git -C "$src" tag -l --sort=-v:refname 'v*' | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' || true); tag=${tag%%$'\n'*}
    [[ -n "$tag" ]] || die "update: no vX.Y.Z tag in $src"
    git -C "$src" -c advice.detachedHead=false checkout -q "$tag"
  fi && "$src/bin/onetree" install
}
# ---- doctor: checks that install worked and still holds
cmd_doctor() {
  # shellcheck disable=SC2034  # G is read inside the eval'd check strings (here and two lines down)
  local json=0 ok=0 bad=0 t G=$BIN m gd checks=""
  [[ "${1:-}" == --json ]] && json=1
  # shellcheck disable=SC2034
  [[ "$(basename "$0")" == onetree ]] && G=$0
  chk() {
    local r=false; if eval "$2" >/dev/null 2>&1; then r=true; ok=$((ok+1)); else bad=$((bad+1)); fi
    if [[ $json == 1 ]]; then checks+=$(jq -cn --arg name "$1" --argjson ok "$r" '{name:$name, ok:$ok}')$'\n'
    elif [[ $r == true ]]; then printf 'ok    %s\n' "$1"; else printf 'FAIL  %s\n' "$1"; fi
  }
  for t in git jq gh lsof; do chk "$t on PATH" "command -v $t"; done
  chk "git >= 2.31 (worktree --path-format)" 'git rev-parse --path-format=absolute --git-dir 2>/dev/null || [[ "$(git version | grep -oE "[0-9]+\.[0-9]+" | head -1 | awk -F. "{print \$1*100+\$2}")" -ge 231 ]]'
  chk "gh logged in" "gh auth status"
  chk "$BIN executable, not a symlink" "[[ -x $BIN && ! -L $BIN ]]"
  chk "onetree on PATH resolves to $BIN" "[[ \$(realfile \"\$(command -v onetree)\") == \$(realfile $BIN) ]]"
  chk "registry $CFG" "[[ -f $CFG ]]"
  chk "Claude hooks point at $BIN" "grep -q '$BIN guard' $HOME/.claude/settings.json && grep -q '$BIN session' $HOME/.claude/settings.json"
  [[ -d "$HOME/.codex" ]] && chk "Codex hooks point at $BIN" "grep -q '$BIN guard' $HOME/.codex/hooks.json && grep -q '$BIN session' $HOME/.codex/hooks.json"
  [[ -d "$HOME/.codex" ]] && chk "Codex trusts onetree's hooks (if not, Codex skips them: run codex, type /hooks, approve them)" "codex_trusted"
  chk "rules block in ~/.claude/CLAUDE.md" "grep -qF '$START' $HOME/.claude/CLAUDE.md"
  [[ -d "$HOME/.codex" ]] && chk "rules block in ~/.codex/AGENTS.md" "grep -qF '$START' $HOME/.codex/AGENTS.md"
  [[ -d "$HOME/.pi/agent" ]] && chk "rules block in ~/.pi/agent/AGENTS.md" "grep -qF '$START' $HOME/.pi/agent/AGENTS.md"
  [[ -d "$HOME/.pi/agent" ]] && chk "pi extension calls $BIN" "grep -qF '$BIN' $HOME/.pi/agent/extensions/onetree.ts"
  [[ -d "$HOME/.dsh" ]] && chk "rules block in ~/.dsh/AGENTS.md" "grep -qF '$START' $HOME/.dsh/AGENTS.md"
  [[ -d "$HOME/.dsh" ]] && chk "dsh plugin calls $BIN and ~/.dsh/cordis.patch.yml loads it" "grep -qF '$BIN' $HOME/.dsh/onetree-plugin.mjs && grep -qF '$YSTART' $HOME/.dsh/cordis.patch.yml"
  chk "shell wrappers sourced" "grep -q onetree-agents.sh $HOME/.zshrc"
  chk "shell wrappers fail closed" "grep -q 'refusing to start' $HOME/.onetree-agents.sh"
  chk "shell wrappers pin $BIN" "grep -qF '$BIN' $HOME/.onetree-agents.sh"
  chk "shell wrappers cover dsh" "grep -q 'dsh()' $HOME/.onetree-agents.sh"
  # what install wrote, against what this onetree and its source would write now
  local src f; src=$(gcfg onetree.source || true)
  [[ -n "$src" && -f "$src/bin/onetree" ]] && chk "installed onetree is the one in $src (if not: onetree update)" "cmp -s '$BIN' '$src/bin/onetree'"
  [[ -n "$src" && -d "$src/.git" ]] && chk "$src has no fetched commits left to pull, as of its last fetch (onetree gc fetches registered repos hourly; if it has: onetree update)" "[[ \$(git -C '$src' rev-list --count 'HEAD..@{u}' 2>/dev/null || echo 0) == 0 ]]"
  chk "shell wrappers are what this onetree writes (if not: onetree update)" "cmp -s '$WRAPPERS' <(render_wrappers)"
  [[ -d "$HOME/.pi/agent" ]] && chk "pi extension is what this onetree writes (if not: onetree update)" "cmp -s '$HOME/.pi/agent/extensions/onetree.ts' <(render_pi_extension)"
  [[ -d "$HOME/.dsh" ]] && chk "dsh plugin is what this onetree writes (if not: onetree update)" "cmp -s '$HOME/.dsh/onetree-plugin.mjs' <(render_dsh_plugin)"
  for f in claude:"$HOME/.claude/CLAUDE.md" codex:"$HOME/.codex/AGENTS.md" pi:"$HOME/.pi/agent/AGENTS.md" dsh:"$HOME/.dsh/AGENTS.md"; do
    [[ -d "$(dirname "${f#*:}")" ]] && chk "${f%%:*} has this onetree's rules (if not: onetree update)" "cmp -s <(awk -v s='$START' -v e='$END' '\$0 == e { exit } p { print } \$0 == s { p = 1 }' '${f#*:}') <(cmd_rules | cat -s)"
  done
  local a d
  for a in claude codex pi dsh; do   # a wrapper is only as good as the client it starts
    case $a in claude) d=$HOME/.claude ;; codex) d=$HOME/.codex ;; pi) d=$HOME/.pi/agent ;; dsh) d=$HOME/.dsh ;; esac
    [[ -d "$d" ]] && chk "$a on PATH starts (\`$a --version\`), so its shell wrapper can start it in a worktree" "bounded 10 $a --version </dev/null"
  done
  if [[ "$(uname)" == Darwin ]]; then chk "gc job loaded (launchd com.onetree.gc)" "launchctl print gui/$(id -u)/com.onetree.gc"; else chk "gc job in crontab" "crontab -l | grep -q ' onetree gc --all'"; fi
  chk "guard blocks a mutation in a guarded mirror (skipped when none registered)" '[[ -z "$(guarded_mains)" ]] || ! printf "{\"tool_name\":\"Bash\",\"cwd\":\"%s\",\"tool_input\":{\"command\":\"git stash\"}}" "$(guarded_mains | head -1)" | ONETREE_NO_EVENTS=1 "$G" guard 2>/dev/null'
  chk "guard blocks a script run in a guarded mirror (skipped when none registered)" '[[ -z "$(guarded_mains)" ]] || ! printf "{\"tool_name\":\"Bash\",\"cwd\":\"%s\",\"tool_input\":{\"command\":\"npm run dev\"}}" "$(guarded_mains | head -1)" | ONETREE_NO_EVENTS=1 "$G" guard 2>/dev/null'
  chk "guard lets a read pass in a guarded mirror (skipped when none registered)" '[[ -z "$(guarded_mains)" ]] || printf "{\"tool_name\":\"Bash\",\"cwd\":\"%s\",\"tool_input\":{\"command\":\"git status\"}}" "$(guarded_mains | head -1)" | ONETREE_NO_EVENTS=1 "$G" guard 2>/dev/null'
  chk "guard fail-open on invalid json" 'printf not-json | ONETREE_NO_EVENTS=1 "$G" guard'
  chk "guard blocks chmod in a guarded mirror (skipped when none registered)" '[[ -z "$(guarded_mains)" ]] || ! printf "{\"tool_name\":\"Bash\",\"cwd\":\"%s\",\"tool_input\":{\"command\":\"chmod u+w README.md\"}}" "$(guarded_mains | head -1)" | ONETREE_NO_EVENTS=1 "$G" guard 2>/dev/null'
  chk "guard blocks find-exec chmod in a guarded mirror (skipped when none registered)" '[[ -z "$(guarded_mains)" ]] || ! printf "{\"tool_name\":\"Bash\",\"cwd\":\"%s\",\"tool_input\":{\"command\":\"find . -exec chmod u+w {} +\"}}" "$(guarded_mains | head -1)" | ONETREE_NO_EVENTS=1 "$G" guard 2>/dev/null'
  chk "event log dir $(dirname "$EVENTS") is writable or creatable" '[[ -w "$(dirname "$EVENTS")" ]] || { [[ ! -e "$(dirname "$EVENTS")" ]] && [[ -w "$(dirname "$(dirname "$EVENTS")")" || ! -e "$(dirname "$(dirname "$EVENTS")")" ]]; }'
  while IFS= read -r m; do
    [[ -n "$m" ]] || continue
    chk "guarded main $m has no user-writable working-tree entry" '! main_has_writable "$m"'
    chk "guarded main $m porcelain clean (or warn-only dirty is a FAIL)" '[[ -z "$(git -C "$m" status --porcelain)" ]]'
    gd=$(git -C "$m" rev-parse --path-format=absolute --git-dir 2>/dev/null) || continue
    chk "park lock for $m is not stale" '! _park_lock_stale "$gd/onetree-park.lock"'
  done < <(guarded_mains)
  while IFS= read -r m; do
    [[ -n "$m" ]] || continue
    chk "registered repo $m is not marked production (unregister it first)" '! production "$m"'
    m=$(real "$m")
    if [[ -n "$(cfg writable "$m" 2>/dev/null)" ]]; then chk "writable paths of $m are untracked and ignored" '[[ -z "$(wr_problems "$m")" ]]'; fi
    # a mirror onetree keeps: worktrees clone its node_modules only when it matches, and hooks run there use it
    guarded "$m" && deps_state "$m" "$m" && case "$DEPS_STATE:$DEPS_PM" in
      current:*|stale:*|unknown:npm|unknown:pnpm) chk "guarded main $m dependencies match its lockfile ($DEPS_PM, $DEPS_STATE: $DEPS_WHY)" '[[ "$DEPS_STATE" == current ]]' ;;
    esac
    gd=$(_git_dir "$m" 2>/dev/null) && [[ -e "$gd/onetree-deps/old" ]] && chk "guarded main $m has no node_modules stranded by a failed swap (at $gd/onetree-deps/old)" false
    if guarded "$m" && ! lock_ignored "$m"; then chk "guarded main $m has no tool cache missing from a locked directory (tsc build info, eslint cache)" '[[ -z "$(tool_caches "$m")" ]]'; fi
    guarded "$m" && continue
    chk "unguarded main $m root is user-writable" '[[ -w "$m" ]]'
  done < <(repos_all)
  # only where a fork or config picked the remotes: a default origin-only repo gets no remotes check
  while IFS= read -r m; do
    [[ -n "$m" ]] || continue
    m=$(real "$m"); remotes_resolve "$m"
    if [[ "$RB_SRC" != default || "$RP_SRC" != default ]]; then chk "remotes of $m resolve (base $RB, push $RP)" 'git -C "$m" config --get "remote.$RB.url" && git -C "$m" config --get "remote.$RP.url"'; fi
    if [[ -f "$m/.onetree" ]]; then chk "committed .onetree of $m sets no per-clone key (remote, pushRemote, ghUser)" '[[ -z "$REM_SKIPPED" ]]'; fi
  done < <(repos_all)
  local names; names=$(repo_names)
  if [[ $json == 1 ]]; then
    printf '%s' "$checks" | jq -s --argjson ok "$ok" --argjson failed "$bad" --arg repos "$names" \
      '{ok:$ok, failed:$failed, repos:($repos | split(" ") | map(select(.!=""))), checks:.}'
  else
    printf '%d ok, %d failed. registered repos: %s\n' "$ok" "$bad" "$names"
  fi
  [[ $bad == 0 ]]
}

# ---- PreToolUse guard: command-position parser (quoted text is data; git -C is judged in that path)
# command — its tokens, a quote spanning lines as the shell reads it; a quote left open at the end (which the shell
# would refuse
_tokens() {
  local out   # to run) is read again line by line, so a stray apostrophe cannot hide the commands after it
  if out=$(_tokens_awk 1 "$1"); then printf '%s\n' "$out"; else _tokens_awk 0 "$1"; fi
}
# span command — one token per line; operators are their own tokens; quotes stripped; a newline is a separator; a
# heredoc
_tokens_awk() {
  local span=$1; shift   # body is data, except the $(…) and `…` the shell expands in one whose delimiter is unquoted
  awk -v span="$span" '
    function emit(t){ if(t!=""){ if(quoted && t ~ /^(;|&&|\|\||\||&|\(|\)|>|>>|<)$/) print "\001" t; else print t }; quoted=0 }   # a quoted ; or > is a word: marked, so it is never read as an operator
    function subst(s,   out, k, m, d, st){         # the command substitutions in a line of text, each as "(cmd)\n"
      out=""; k=1; m=length(s)
      while(k<=m){
        if(substr(s,k,2)=="$("){ k+=2; st=k; d=1; while(k<=m && d>0){ if(substr(s,k,1)=="(") d++; else if(substr(s,k,1)==")") d--; k++ }; out=out "(" substr(s,st,k-st-1) ")\n"; continue }
        if(substr(s,k,1)=="`"){ k++; st=k; while(k<=m && substr(s,k,1)!="`") k++; out=out "(" substr(s,st,k-st) ")\n"; k++; continue }
        k++
      }
      return out
    }
    { buf = buf $0 "\n" }
    END {
      n=length(buf); i=1; tok=""; heredoc=""; q=""; depth=0; sp=0; bt=0; hsubs=""
      while(i<=n){
        c=substr(buf,i,1); two=substr(buf,i,2)
        if(heredoc!=""){                                   # inside a heredoc body: skip to the delimiter line
          j=index(substr(buf,i), "\n"); if(j==0) break
          line=substr(buf,i,j-1); sub(/^\t+/,"",line); i+=j
          if(line==heredoc) heredoc=""; else if(!hquoted) hsubs=hsubs subst(line)
          if((heredoc=="" || i>n) && hsubs!=""){ buf=substr(buf,1,i-1) hsubs substr(buf,i); n=length(buf); hsubs=""; heredoc="" }   # judged where they run: after the body
          continue
        }
        if(q!=""){                                         # inside quotes: text is data, and foo"bar" is one word, as the shell reads it
          if(c=="\n"){ if(!span){ q=""; continue }; tok=tok " "; i++; continue }   # in a quote a newline is text: one word, read on one line
          if(c==q){ q=""; i++; continue }
          if(q=="\""){
            if(c=="\\"){ i++; if(i<=n) tok=tok substr(buf,i,1); i++; continue }
            if(two=="$(" || c=="`"){                       # "$(…)" and "`…`" run commands: open a subshell, quoting resumes at its close
              emit(tok); tok=""; emit("("); q=""; sp++; sub_at[sp]=(c=="`") ? -1 : depth
              if(c=="`") i++; else { depth++; i+=2 }
              continue
            }
          }
          tok=tok c; i++; continue
        }
        if(c=="\047" || c=="\""){ q=c; quoted=1; i++; continue }
        if(c=="`"){                                        # `…` is a subshell; a second backtick closes it
          emit(tok); tok=""; i++
          if(sp>0 && sub_at[sp]==-1){ emit(")"); sp--; q="\"" } else if(bt){ emit(")"); bt=0 } else { emit("("); bt=1 }
          continue
        }
        if(c=="\\"){ i++; if(i<=n && substr(buf,i,1)!="\n"){ tok=tok substr(buf,i,1); quoted=1 }; i++; continue }
        if(two=="<<"){                                     # <<WORD / <<-WORD / <<"WORD": the body is text, not commands
          i+=2; if(substr(buf,i,1)=="-") i++
          while(substr(buf,i,1)==" " || substr(buf,i,1)=="\t") i++
          pending=""; pquoted=0
          while(i<=n){
            c=substr(buf,i,1)
            if(c=="\n" || c==" " || c=="\t" || c==";" || c=="|" || c=="&" || c==">" || c=="<") break
            if(c!="\047" && c!="\"" && c!="\\") pending=pending c; else pquoted=1
            i++
          }
          continue                                         # the rest of the line still belongs to this command
        }
        if(c=="\n"){ emit(tok); tok=""; emit(";"); i++; heredoc=pending; hquoted=pquoted; pending=""; continue }
        if(two=="&&" || two=="||" || two==">>"){ emit(tok); tok=""; emit(two); i+=2; continue }
        if(c=="("){ depth++ }
        if(c==")"){ depth--; if(sp>0 && sub_at[sp]==depth){ sp--; q="\"" } }   # back inside the "…" that held $(
        if(c==";" || c=="|" || c=="&" || c=="(" || c==")" || c==">" || c=="<"){ emit(tok); tok=""; emit(c); i++; continue }
        if(c==" " || c=="\t"){ emit(tok); tok=""; i++; continue }
        tok=tok c; i++
      }
      emit(tok)
      if(span && q!="") exit 3
    }' <<<"$1"
}
_is_op() { case "$1" in ";"|"&&"|"||"|"|"|"&"|"("|")") return 0 ;; *) return 1 ;; esac; }
# verb args… — 0 unless this git command is known to leave refs, the index, the working tree and .git/config alone. An
# unknown verb writes, a user's alias included: an alias can be anything. Options may come before the operation
_git_mut() {
  local a k=0 v
  case "$1" in
    ""|status|log|show|diff|diff-tree|diff-index|diff-files|rev-parse|rev-list|ls-files|ls-tree|ls-remote|cat-file|describe|blame|annotate|grep|shortlog|\
    whatchanged|show-ref|show-branch|for-each-ref|name-rev|merge-base|cherry|range-diff|count-objects|var|version|help|check-ignore|check-attr|\
    check-ref-format|check-mailmap|verify-commit|verify-tag|archive|request-pull|clone) return 1 ;;
    # a refspec into a local branch or tag writes it
    fetch) shift; for a in "$@"; do case "$a" in *:refs/remotes/*) ;; -*) ;; *:*) return 0 ;; esac; done ;;
    # a writing option, else a listing option, else a bare name creates
    branch) shift; _drop_opt_values "$@"; set -- ${KEPT[@]+"${KEPT[@]}"}
      for a in "$@"; do case "$a" in -[dDmMcCfu]*|-[!-]*[dDmMcCfu]*|--delete|--move|--copy|--force|--set-upstream-to*|--unset-upstream|--edit-description) return 0 ;; esac; done
      for a in "$@"; do case "$a" in -[larvn]*|-[!-]*[larvn]*|--list|--all|--remotes|--verbose|--show-current|--contains*|--no-contains*|--points-at*|--merged*|--no-merged*) return 1 ;; esac; done
      for a in "$@"; do case "$a" in -*) ;; *) return 0 ;; esac; done ;;
    tag) shift; _drop_opt_values "$@"; set -- ${KEPT[@]+"${KEPT[@]}"}
      for a in "$@"; do case "$a" in -[dDfasmFeu]*|-[!-]*[dDfasmFeu]*|--delete|--force|--annotate|--sign|--message*|--file*|--edit|--local-user*) return 0 ;; esac; done
      for a in "$@"; do case "$a" in -[lnv]*|-[!-]*[lnv]*|--list|--verify|--contains*|--no-contains*|--points-at*|--merged*|--no-merged*) return 1 ;; esac; done
      for a in "$@"; do case "$a" in -*) ;; *) return 0 ;; esac; done ;;
    # a second name writes
    symbolic-ref) shift; for a in "$@"; do case "$a" in -d|--delete) return 0 ;; -*) ;; *) k=$((k+1)); [[ $k -ge 2 ]] && return 0 ;; esac; done ;;
    hash-object) shift; for a in "$@"; do [[ "$a" == -w ]] && return 0; done ;;
    # the first word after the options is the operation
    worktree|remote|reflog|notes|sparse-checkout|submodule|stash|bisect) v=$1; shift; a=""
      while [[ $# -gt 0 ]]; do [[ "$1" == -* ]] || { a=$1; break; }; shift; done
      case "$v:$a" in
        worktree:list|worktree:|remote:|remote:show|remote:get-url|reflog:|reflog:show|reflog:exists|notes:|notes:list|notes:show|\
        sparse-checkout:list|submodule:|submodule:status|submodule:summary|stash:list|stash:show|bisect:log|bisect:view|bisect:visualize) return 1 ;;
        reflog:expire|reflog:delete) return 0 ;;
        reflog:*) return 1 ;;   # git reflog <ref> shows it
        *) return 0 ;;
      esac ;;
    *) return 0 ;;
  esac
  return 1
}
# args… (of git branch or tag) -> KEPT, without the separate value of a listing option (--sort -creatordate)
_drop_opt_values() {
  KEPT=(); local a skip=0
  for a in "$@"; do
    if [[ $skip == 1 ]]; then skip=0; continue; fi
    case "$a" in --format|--sort|--contains|--no-contains|--points-at|--merged|--no-merged) skip=1 ;; esac
    KEPT+=("$a")
  done
}
_text_tool() {  # word — 0 for a program that only prints, searches or sends the words it is given, never runs them here
  case "${1##*/}" in echo|printf|grep|egrep|fgrep|rg|ag|ack|man|tldr|which|type|whatis|apropos|help|info|gh|jq|curl|wget|ssh) return 0 ;; esac
  return 1
}
_git_cmd() {  # word — 0 when git knows it as a command or an alias (so `brew install git curl` is not a git command)
  [[ -n "$1" ]] || return 1
  [[ -n "${GIT_CMDS+x}" ]] || GIT_CMDS=" $(git --list-cmds=main,others,alias 2>/dev/null | tr '\n' ' ') "
  [[ "$GIT_CMDS" == "  " || "$GIT_CMDS" == *" $1 "* ]]   # no list from this git: every word counts
}
# args… (after `git config`) — 0 when it writes the repo's own config; a read, --global or --system does not
_git_config_mut() {
  local a pos=0 wr=0 rd=0
  while [[ $# -gt 0 ]]; do a=$1; shift
    case "$a" in
      --global|--system) return 1 ;;
      --get|--get-all|--get-regexp|--get-urlmatch|--get-color|--get-colorbool|-l|--list|--blob|--blob=*) rd=1 ;;
      --add|--unset|--unset-all|--replace-all|--remove-section|--rename-section|-e|--edit) wr=1 ;;
      -f|--file|--type|--default|--comment|--value) [[ $# -gt 0 ]] && shift ;;
      -*) ;;
      *) if [[ $pos == 0 ]]; then case "$a" in get|list) return 1 ;; set|unset|remove-section|rename-section|edit) return 0 ;; esac; fi
         pos=$((pos+1)) ;;
    esac
  done
  [[ $wr == 1 ]] && return 0
  [[ $rd == 0 && $pos -ge 2 ]]   # git config key value sets it; a key alone reads it
}
_hit() { printf '%s\t%s\n' "$1" "$2"; }
# words… -> WRAP_N, how many leading words wrap the command (VAR=1, env -u X, nice -n 5, timeout 30s, sudo -u who, exec
# -a, xargs …); WRAP_SPLIT, the words env -S adds in front of the command; WRAP_CD, the folder env -C or sudo -D runs it
# in. Each wrapper's
_wrap_n() {
  local n=0 wr="" vo=""
  WRAP_SPLIT="" WRAP_CD=""   # options that take the next word are listed by name
  while [[ $# -gt 0 ]]; do
    if [[ -n "$wr" ]]; then   # inside a wrapper's own options
      case "$1" in
        --) wr=""; n=$((n+1)); shift; continue ;;
        --chdir=*) WRAP_CD=${1#--chdir=}; n=$((n+1)); shift; continue ;;
        -*) case " $vo " in *" $1 "*) [[ $# -ge 2 ]] && { [[ "$wr" == env && "$1" == -S ]] && WRAP_SPLIT=$2
                                                           case "$wr:$1" in env:-C|env:--chdir|sudo:-D|sudo:--chdir) WRAP_CD=$2 ;; esac; n=$((n+1)); shift; } ;; esac
            n=$((n+1)); shift; continue ;;
        # the duration, the lock file
        *) [[ "$wr" == timeout || "$wr" == flock ]] && { wr=""; n=$((n+1)); shift; continue; }
           wr="" ;;
      esac
    fi
    case "$1" in *=*) n=$((n+1)); shift; continue ;; esac
    wr=${1##*/}   # /usr/bin/time is time
    case "$wr" in
      env)     vo="-u -C -S --unset --chdir --split-string" ;;
      nice)    vo="-n --adjustment" ;;
      time)    vo="-f -o --format --output" ;;
      sudo)    vo="-u -g -h -p -r -t -U -C -D -T --user --group --host --prompt --role --type --chdir --other-user" ;;
      doas)    vo="-u -C" ;;
      timeout) vo="-s -k --signal --kill-after" ;;
      exec)    vo="-a" ;;
      xargs)   vo="-a -d -E -I -L -n -P -s -S --arg-file --delimiter --eof --replace --max-lines --max-args --max-procs --max-chars" ;;
      stdbuf)  vo="-i -o -e --input --output --error" ;;
      ionice)  vo="-c -n -p" ;;
      command|nohup|chronic|setsid|caffeinate|unbuffer) vo="" ;;
      watch)   vo="-n -d --interval --differences" ;;
      flock)   vo="-w -E --timeout --conflict-exit-code" ;;
      *) wr=""; break ;;
    esac
    n=$((n+1)); shift
  done
  WRAP_N=$n
}
# words_nl -> WORDS (a quoted operator's mark dropped)
_words() { WORDS=(); local w; while IFS= read -r w; do [[ -n "$w" ]] && WORDS+=("${w#$'\001'}"); done <<<"$1"; }
# words… -> KW_N, how many leading shell keywords and braces only open or close a block; KW_HDR=1 for a for, select or
_kw_n() {
  KW_N=0 KW_HDR=0   # case header, which is words, not a command
  while [[ $# -gt 0 ]]; do
    case "$1" in if|then|else|elif|fi|do|done|while|until|'{'|'}'|'!'|'esac'|coproc|function) KW_N=$((KW_N+1)); shift ;; for|select|case) KW_HDR=1; return ;; *) return ;; esac
  done
}
_dir_after() {  # dir words_nl [prev] -> cwd after this simple command (cd updates it; cd - goes back to prev)
  local dir=$1 prev=${3:-}; _words "$2"; set -- ${WORDS[@]+"${WORDS[@]}"}
  _kw_n "$@"; [[ $KW_HDR == 1 ]] && { printf '%s' "$dir"; return; }; shift "$KW_N"
  _wrap_n "$@"; shift "$WRAP_N"
  if [[ "${1##*/}" == cd ]]; then shift
    # cd -P -- dir
    while [[ $# -gt 0 ]]; do case "$1" in --) shift; break ;; -[LPe@]|-[LPe@][LPe@]) shift ;; *) break ;; esac; done
    local t; if [[ $# -eq 0 ]]; then t=$HOME; elif [[ "$1" == - ]]; then t=${prev:-$dir}; else t=$(norm "$1" "$dir"); fi
    # a cd into a folder that doesn't exist fails: the shell stays
    if [[ -d "$t" ]]; then printf '%s' "$t"; else printf '%s' "$dir"; fi
    return
  fi
  printf '%s' "$dir"
}
_arg_in_mirror() {  # rule dir args... — 0 and prints rule\tpath if an operand is a path into a guarded main
  local rule=$1 dir=$2 a r; shift 2
  for a in "$@"; do
    case "$a" in -*|=*) continue ;; esac
    r=$(guarded_main_of_path "$(norm "$a" "$dir")") || continue
    _hit "$rule" "$r"; return 0
  done
  return 1
}
# writable local state (onetree.writable) in the walker: a write passes when every path it writes is writable_ok.
# Writers that need the parent directory (mv, rm, mkdir, rmdir, sed -i, perl -i: they create, rename or unlink entries)
# pass only inside a directory entry.
_wr_pass() {  # dir operand need(any|in) — 0 when operand resolves into a guarded main and is writable local state there
  local t m; WR_NEW=0; t=$(norm "$2" "$1"); m=$(guarded_main_of_path "$t") || return 1
  writable_ok "$m" "$t" || return 1
  [[ "$3" == any || "$WR_KIND" == in ]]
}
_operands() {  # args… -> the non-option words, one per line
  local a; for a in "$@"; do case "$a" in -*) ;; *) printf '%s\n' "$a" ;; esac; done
}
# dir operand need — 0 when a path a file command writes is none of the guard's business (it resolves outside every
# guarded main:
_wr_ok() {
  # a log in /tmp, a copy out of the mirror) or is writable local state there. A symlink leaf is never taken for outside
  local t; t=$(norm "$2" "$1")
  if [[ ! -L "$t" ]] && ! guarded_main_of_path "$t" >/dev/null; then return 0; fi
  _wr_pass "$1" "$2" "$3"
}
# cmd dir args… — 0 when every path this file command writes is outside the mirror or writable local state (cp: its
# destination; tee, touch: in place; mv, rm: every operand, since moving a file out deletes it here)
_wr_cmd() {
  local cmd=$1 dir=$2 a need=in n=0 last=""; shift 2
  case "$cmd" in tee|touch) need=any ;; cp) need=any ;; mv|rm|rmdir|mkdir) need=in ;; *) return 1 ;; esac
  while IFS= read -r a; do [[ -n "$a" ]] || continue; n=$((n+1)); last=$a
    [[ "$cmd" == cp ]] && continue
    _wr_ok "$dir" "$a" "$need" || return 1
  done < <(_operands "$@")
  [[ $n -gt 0 || "$cmd" == tee ]] || return 1   # tee with no file only copies stdin to stdout
  [[ "$cmd" != cp ]] || _wr_ok "$dir" "$last" any
}
# sed|perl args… -> the files an in-place edit rewrites: operands minus the script (the first operand, unless -e/-f/-E
# gave one)
_inplace_files() {
  local tool=$1 a skip=0 script=0 first=1; shift
  for a in "$@"; do
    if [[ $skip == 1 ]]; then skip=0; continue; fi
    case "$a" in
      -e|-f|-E) skip=1; script=1 ;;
      -*) [[ "$tool" == perl && "$a" =~ ^-[A-Za-z]*[eE]$ ]] && { skip=1; script=1; } ;;   # perl -pe 'code'
      *) if [[ $script == 0 && $first == 1 ]]; then first=0; continue; fi; printf '%s\n' "$a" ;;
    esac
  done
}
_wr_inplace() {  # tool dir args… — 0 when every file the in-place edit rewrites is inside a writable directory entry;
  # 2 when one is a writable file entry (its directory is locked, so the rename fails); 1 otherwise
  local tool=$1 dir=$2 f n=0 st=0; shift 2
  while IFS= read -r f; do
    [[ -n "$f" ]] || continue; n=$((n+1))
    _wr_pass "$dir" "$f" any || return 1
    [[ "$WR_KIND" == in ]] || st=2
  done < <(_inplace_files "$tool" "$@")
  [[ $n -gt 0 ]] || return 1
  return $st
}
# -i, -pi, -i.bak, -lpi: perl rewrites its files
_perl_inplace() { local a; for a in "$@"; do [[ "$a" =~ ^-[aclnpsTtuUwWX0-9]*i ]] && return 0; done; return 1; }
INPLACE_RULE="an in-place rewrite of a file whose directory is locked (it is writable in place only: use the Edit tool, > or >>)"
# git ignores it, so it may be local state, but the directory is locked: nothing can create it there
NEWFILE_RULE="a new file in a locked directory"
# an agent may not switch onetree off or rewrite its settings. These rules hold wherever the agent is, since they are
# about onetree, not one mirror
SELF_OFF="turning the guard off"; SELF_CFG="changing onetree settings"
_is_guarded() { local g; while IFS= read -r g; do [[ -n "$g" && "$g" == "$1" ]] && return 0; done < <(guarded_mains); return 1; }
# the configured name: its directory resolved, the leaf kept, so a symlinked config is still protected by its own name
_cfg_real() { realfile "$CFG"; }
# the file the configured name finally points at, symlinks followed (the configured name itself when it is no symlink)
_cfg_target() {
  local p l n=0; p=$(_cfg_real)
  while [[ -L "$p" && $n -lt 20 ]]; do l=$(readlink "$p"); [[ "$l" == /* ]] || l="$(dirname "$p")/$l"; p=$(realfile "$l"); n=$((n+1)); done
  printf '%s' "$p"
}
# device:inode, symlinks followed; GNU first, as mtime does
_fid() { stat -L -c '%d:%i' "$1" 2>/dev/null || stat -L -f '%d:%i' "$1" 2>/dev/null; }
# dir operand mode — 0 when the operand is onetree's config file. name: its configured name or the file that name points
# at. write: also any other name for the same file (a symlink or hard link: writing through it writes the config). tree:
# also a directory holding either (rm -r, mv); removing another link is harmless
_cfg_is() {
  local t c g id; t=$(norm "$2" "$1"); c=$(_cfg_real); g=$(_cfg_target)
  case "${t##*/}" in .|..|"") t=$(real "$t") ;; *) t=$(realfile "$t") ;; esac
  [[ "$t" == "$c" || "$t" == "$g" ]] && return 0
  case "${3:-name}" in
    write) [[ -e "$t" ]] || return 1; id=$(_fid "$g"); [[ -n "$id" && "$(_fid "$t")" == "$id" ]] ;;
    tree) [[ "$t" == / || "$c" == "$t"/* || "$g" == "$t"/* ]] ;;
    *) return 1 ;;
  esac
}
# dir operand mode -> main when the operand is a production checkout's ordinary .git/config, or tree contains it
_production_cfg_main() {
  local t d m mode=${3:-write}; t=$(norm "$2" "$1"); t=$(realfile "$t")
  if [[ "${t##*/}" == config ]]; then d=$(dirname "$t")
  elif [[ $mode == tree && "${t##*/}" == .git ]]; then d=$t
  elif [[ $mode == tree && -d "$t/.git" ]]; then d=$t/.git
  else return 1; fi
  [[ "${d##*/}" == .git && -d "$d" ]] || return 1
  m=$(real "$(dirname "$d")"); production "$m" || return 1
  printf '%s' "$m"
}
# cmd dir args… — prints rule\tpath, 0 when a file command would rewrite, move or remove onetree's config file
_cfg_writer() {
  local cmd=$1 dir=$2 a last="" mode="write" files pm; shift 2
  case "$cmd" in
    rm|rmdir|mv) mode="tree"; files=$(_operands "$@") ;;
    tee|touch|truncate) files=$(_operands "$@") ;;
    # only the destination is written; a directory destination is written into. ln replaces the name, so another link to
    # the config is fine
    cp|install|ln)
      while IFS= read -r a; do [[ -n "$a" ]] && last=$a; done < <(_operands "$@")
      [[ -n "$last" ]] || return 1
      [[ "$cmd" == ln ]] && mode="name"
      if _cfg_is "$dir" "$last" "$mode" || [[ "$(real "$(norm "$last" "$dir")")" == "$(dirname "$(_cfg_real)")" ]]; then _hit "$SELF_CFG: onetree's config file" "$(_cfg_real)"; return 0; fi
      pm=$(_production_cfg_main "$dir" "$last" "$mode") && { _hit "$SELF_CFG: production marker" "$pm"; return 0; }
      return 1 ;;
    sed) for a in "$@"; do case "$a" in -i|-i*|--in-place|--in-place=*) files=$(_inplace_files sed "$@"); break ;; esac; done ;;
    perl) _perl_inplace "$@" && files=$(_inplace_files perl "$@") ;;
    *) return 1 ;;
  esac
  while IFS= read -r a; do
    [[ -n "$a" ]] || continue
    _cfg_is "$dir" "$a" "$mode" && { _hit "$SELF_CFG: onetree's config file" "$(_cfg_real)"; return 0; }
    pm=$(_production_cfg_main "$dir" "$a" "$mode") && { _hit "$SELF_CFG: production marker" "$pm"; return 0; }
  done <<<"${files:-}"
  return 1
}
_patch_paths() {  # patch text -> "op<TAB>path" for every file an apply_patch adds, updates, deletes or moves to
  awk '{ sub(/\r$/, "") }
    /^\*\*\* (Add|Update|Delete) File: /{ op = $2; sub(/^\*\*\* (Add|Update|Delete) File: /, ""); print op "\t" $0; next }
    /^\*\*\* Move to: /{ sub(/^\*\*\* Move to: /, ""); print "Move\t" $0 }' <<<"$1"
}
# dir [repo] — the main checkout `onetree <cmd> [repo]` run in dir acts on, resolved as main_of does; 1 when there is
# none
_onetree_target() {
  local dir=$1 a=${2:-} c r
  if [[ -n "$a" ]]; then
    c=$(norm "$a" "$dir")
    if [[ -e "$c/.git" ]]; then c=$(git -C "$c" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1; real "$(dirname "$c")"; return 0; fi
    while IFS= read -r r; do [[ -n "$r" && "$(basename "$r")" == "$a" ]] && { real "$r"; return 0; }; done < <(repos_all)
    return 1
  fi
  c=$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  real "$(dirname "$c")"
}
# dir args… (after `onetree`) — prints rule\tpath, 0 when the command turns the guard off: uninstall while any repo is
# guarded; unregister of a guarded repo; an init on one whose last --guard/--no-guard is --no-guard
_onetree_self() {
  local dir=$1 sub=${2:-} a repo="" off=0 m
  if [[ $# -ge 2 ]]; then shift 2; else shift; fi
  case "$sub" in
    uninstall) [[ -n "$(guarded_mains)" ]] || return 1; _hit "$SELF_OFF: onetree uninstall" "$(_cfg_real)"; return 0 ;;
    unregister) repo=${1:-} ;;
    init)
      while [[ $# -gt 0 ]]; do a=$1; shift
        case "$a" in
          --guard) off=0 ;;
          --no-guard) off=1 ;;
          --integration|--root|--branch-prefix|--copy|--keep|--keep-source|--bootstrap|--stale|--remote|--push-remote|--gh-user|--writable|--writable-add|--writable-remove|--carry) [[ $# -gt 0 ]] && shift ;;
          -*) ;;
          *) repo=$a ;;
        esac
      done
      [[ $off == 1 ]] || return 1 ;;
    *) return 1 ;;
  esac
  m=$(_onetree_target "$dir" "$repo") && _is_guarded "$m" || return 1
  if [[ "$sub" == init ]]; then _hit "$SELF_OFF: onetree init --no-guard" "$m"; else _hit "$SELF_OFF: onetree unregister" "$m"; fi
}
# gdir gitdir GIT_CONFIG GIT_CONFIG_GLOBAL GIT_CONFIG_SYSTEM args… (after `git config`) — prints rule\tpath, 0 when it
# writes an onetree.* key, or edits a whole file, where onetree reads its settings: a guarded repo's config, or
# onetree's config file under any name git may be told to write it by
_git_config_self() {
  local gdir=$1 gd=$2 ecfg=$3 eglobal=$4 esystem=$5 file="" scope=repo rd=0 wr=0 ren=0 prodwr=0 k a c m pm
  local -a pos=() keys=() files=()
  shift 5
  while [[ $# -gt 0 ]]; do a=$1; shift
    case "$a" in
      -f|--file) file=${1:-}; [[ $# -gt 0 ]] && shift ;;
      --file=*) file=${a#--file=} ;;
      -f?*) file=${a#-f} ;;   # -f<path>, attached
      --blob|--blob=*) return 1 ;;   # reads a blob, never writes
      --global) scope=global ;;   # ~/.gitconfig is not onetree's global layer, but GIT_CONFIG_GLOBAL can name any file
      --system) scope=system ;;
      --local|--worktree) ;;   # --worktree writes .git/config unless extensions.worktreeConfig is on
      --type|--default|--comment|--value) [[ $# -gt 0 ]] && shift ;;
      --get|--get-all|--get-regexp|--get-urlmatch|--get-color|--get-colorbool|-l|--list) rd=1 ;;
      --rename-section) wr=1; ren=1 ;;
      --add|--unset|--unset-all|--replace-all|--remove-section) wr=1 ;;
      -e|--edit) wr=1; keys=(onetree) ;;
      -*) ;;
      *) pos+=("$a") ;;
    esac
  done
  case "${pos[0]:-}" in   # git 2.46 subcommands, else the classic form: a key and a value set it
    # both ends: renaming another section into onetree writes it as surely as setting it
    rename-section) wr=1; keys=("${pos[1]:-}" "${pos[2]:-}") ;;
    set|unset|remove-section) wr=1; keys=("${pos[1]:-}") ;;
    edit) wr=1; keys=(onetree) ;;
    get|list) return 1 ;;
    *) if [[ ${#keys[@]} -eq 0 ]]; then if [[ $ren == 1 ]]; then keys=("${pos[0]:-}" "${pos[1]:-}"); else keys=("${pos[0]:-}"); fi; fi
       [[ $wr == 1 || ( $rd == 0 && ${#pos[@]} -ge 2 ) ]] || return 1 ;;
  esac
  wr=0
  for k in "${keys[@]}"; do
    k=$(printf '%s' "$k" | tr '[:upper:]' '[:lower:]')
    [[ "$k" == onetree || "$k" == onetree.* ]] && wr=1
    [[ "$k" == onetree || "$k" == onetree.production || "$k" == onetree.devclone ]] && prodwr=1
  done
  [[ $wr == 1 ]] || return 1
  # an explicit file wins; otherwise judge every file git could pick, GIT_CONFIG included
  if [[ -n "$file" ]]; then files=("$file")
  else
    [[ -n "$ecfg" ]] && files+=("$ecfg")
    [[ $scope == global && -n "$eglobal" ]] && files+=("$eglobal")
    [[ $scope == system && -n "$esystem" ]] && files+=("$esystem")
  fi
  for a in ${files[@]+"${files[@]}"}; do
    _cfg_is "$gdir" "$a" write && { _hit "$SELF_CFG: git config onetree.*" "$(_cfg_real)"; return 0; }
    m=$(guarded_main_of_path "$(norm "$a" "$gdir")") && { _hit "$SELF_CFG: git config onetree.*" "$m"; return 0; }
    if [[ $prodwr == 1 ]]; then pm=$(_production_cfg_main "$gdir" "$a") && { _hit "$SELF_CFG: git config onetree.*" "$pm"; return 0; }; fi
  done
  [[ -z "$file" && $scope == repo ]] || return 1
  if [[ -n "$gd" ]]; then c=$(git --git-dir="$gd" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  else c=$(git -C "$gdir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1; fi
  m=$(real "$(dirname "$c")")
  if ! _is_guarded "$m"; then
    [[ $prodwr == 1 ]] && production "$m" || return 1
  fi
  _hit "$SELF_CFG: git config onetree.*" "$m"
}
# dir in_mirror target… — prints rule\tpath, 0 when a redirect writes onetree's config file, or a mirror path that is
# not writable local state
_check_redirs() {
  local dir=$1 in_mirror=$2 w r pm; shift 2
  for w in "$@"; do   # every redirect on the command, not only the last one
    [[ -n "$w" && "$w" != /dev/null ]] || continue
    _cfg_is "$dir" "$w" write && { _hit "$SELF_CFG: onetree's config file" "$(_cfg_real)"; return 0; }
    pm=$(_production_cfg_main "$dir" "$w") && { _hit "$SELF_CFG: production marker" "$pm"; return 0; }
    # into writable local state: in place, which a file in a locked directory allows
    if [[ "$w" != /* && $in_mirror == 1 ]]; then
      _wr_pass "$dir" "$w" any || { if [[ $WR_NEW == 1 ]]; then _hit "$NEWFILE_RULE" "$(norm "$w" "$dir")"; else _hit "an output redirect" "$dir"; fi; return 0; }
      continue
    fi
    r=$(guarded_main_of_path "$(norm "$w" "$dir")") && { _wr_pass "$dir" "$w" any || { if [[ $WR_NEW == 1 ]]; then _hit "$NEWFILE_RULE" "$(norm "$w" "$dir")"; else _hit "a write to a mirror path" "$r"; fi; return 0; }; }
  done
  return 1
}
_check_simple() {  # dir words_nl — prints rule\tpath, 0 if this simple command must be blocked
  local dir=$1 in_mirror=0 r cmd0 gdir gd="" gcf="" gcg="" gcs="" verb nxt orig w sc="" st skip=0
  r=$(guarded_main_of_path "$dir") && in_mirror=1
  local args=() redirs=()
  while IFS= read -r w; do
    [[ -n "$w" ]] || continue
    case "$w" in
      ">"|">>") IFS= read -r w || true; redirs+=("$w"); continue ;;
      "<") IFS= read -r w || true; continue ;;
    esac
    args+=("${w#$'\001'}")
  done <<<"$2"
  set -- "${args[@]}"
  # the command is the word after the keywords that open its block
  _kw_n "$@"; [[ $KW_HDR == 1 ]] && return 1; shift "$KW_N"
  local n split; _wrap_n "$@"; n=$WRAP_N; split=$WRAP_SPLIT
  # env -C / --chdir: the command runs there
  [[ -n "$WRAP_CD" ]] && { dir=$(norm "$WRAP_CD" "$dir"); in_mirror=0; r=$(guarded_main_of_path "$dir") && in_mirror=1; }
  while [[ $n -gt 0 ]]; do
    case "$1" in   # GIT_DIR=<main>/.git git … acts on that repo; GIT_CONFIG* name the file git config writes
      GIT_DIR=*) gd=${1#GIT_DIR=} ;;
      GIT_CONFIG=*) gcf=${1#GIT_CONFIG=} ;;
      GIT_CONFIG_GLOBAL=*) gcg=${1#GIT_CONFIG_GLOBAL=} ;;
      GIT_CONFIG_SYSTEM=*) gcs=${1#GIT_CONFIG_SYSTEM=} ;;
    esac
    shift; n=$((n-1))
  done
  # env -S 'git stash' runs git stash
  [[ -n "$split" ]] && { local -a sw; read -ra sw <<<"$split"; set -- ${sw[@]+"${sw[@]}"} "$@"; }
  [[ $# -gt 0 ]] || return 1
  # a command word with spaces is a command line a wrapper hands to sh (watch 'cmd')
  [[ "$1" == *[[:space:]]* ]] && { _guard_walk "$dir" "$*"; return; }
  orig=$1; cmd0=${1##*/}; shift
  # onetree itself passes, unless it would turn the guard off; its redirects are judged like any other
  case "$cmd0" in onetree)
    _onetree_self "$dir" "$@" && return 0
    _check_redirs "$dir" "$in_mirror" ${redirs[@]+"${redirs[@]}"} && return 0
    return 1 ;;
  esac
  _cfg_writer "$cmd0" "$dir" "$@" && return 0
  # a version or help probe as the only argument runs nothing of the checkout's; its redirects are still judged below
  case "$cmd0" in make|npm|node|pnpm|yarn|bun|uv|python|python[0-9]*)
    [[ $# -eq 1 ]] && case "$1" in --version|-v|-V|--help|-h) cmd0=probe ;; esac ;;
  esac
  # their branches return early
  case "$cmd0" in eval|bash|sh|zsh|dash) _check_redirs "$dir" "$in_mirror" ${redirs[@]+"${redirs[@]}"} && return 0 ;; esac
  case "$cmd0" in
    eval) _guard_walk "$dir" "$*" && return 0; return 1 ;;
    bash|sh|zsh|dash)
      local probe=0
      while [[ $# -gt 0 ]]; do   # -c takes the next word as the command text; anything else non-option is a script file
        case "$1" in
          -c|-[!-]*c) [[ $# -ge 2 ]] && { _guard_walk "$dir" "$2" && return 0; }; return 1 ;;
          --version|--help) probe=1; shift; continue ;;
          -*) shift; continue ;;
          *) sc=$1; break ;;
        esac
      done
      # no -c and no script: it reads its commands from stdin (a heredoc, a pipe, -s), which the guard never sees
      if [[ -z "$sc" ]]; then
        [[ $in_mirror == 1 && $probe == 0 ]] && { _hit "a shell reading its commands from stdin" "$dir"; return 0; }
        return 1
      fi
      [[ $in_mirror == 1 ]] && { _hit "running a script, server or test" "$dir"; return 0; }
      _arg_in_mirror "running a mirror script by path" "$dir" "$sc" && return 0
      return 1 ;;
  esac
  if [[ "$cmd0" == git ]]; then
    gdir=$dir
    while [[ $# -gt 0 ]]; do
      case "$1" in
        # each -C is relative to the one before
        -C) [[ $# -ge 2 ]] || break; gdir=$(norm "$2" "$gdir"); shift 2; continue ;;
        -C*) gdir=$(norm "${1#-C}" "$gdir"); shift; continue ;;
        # -c name=value: its value is not the subcommand
        -c) if [[ $# -ge 2 ]]; then shift 2; else shift; fi; continue ;;
        --git-dir) [[ $# -ge 2 ]] && gd=$2; shift; [[ $# -gt 0 ]] && shift; continue ;;
        --git-dir=*) gd=${1#--git-dir=}; shift; continue ;;
        --work-tree) shift; [[ $# -gt 0 ]] && shift; continue ;;
        --work-tree=*) shift; continue ;;
        -*) shift; continue ;;
        *) verb=$1; shift; break ;;
      esac
    done
    nxt=${1:-}
    [[ -n "$gd" ]] && gd=$(norm "$gd" "$gdir")   # a relative --git-dir is read from where -C left git
    # git's own output files (diff --output, archive -o) are writes, judged like a redirect from where git runs
    local o prev=""; for o in "$@"; do
      case "$prev:$o" in *:--output=*) redirs+=("$(norm "${o#--output=}" "$gdir")") ;; --output:*|archive-o:*) redirs+=("$(norm "$o" "$gdir")") ;; esac
      prev=$o; [[ "$verb:$o" == archive:-o ]] && prev=archive-o
    done
    if [[ "$verb" == config ]]; then
      _git_config_self "$gdir" "$gd" "$gcf" "$gcg" "$gcs" "$@" && return 0
      # a write is judged where it lands: --file / -f, else GIT_CONFIG, else the repo git acts on
      if _git_config_mut "$@"; then
        local cf=""; prev=""; for o in "$@"; do case "$prev:$o" in -f:*|--file:*) cf=$o ;; *:--file=*) cf=${o#--file=} ;; esac; prev=$o; done
        [[ -n "$cf" ]] || cf=$gcf
        if [[ -n "$cf" ]]; then r=$(guarded_main_of_path "$(norm "$cf" "$gdir")") && { _hit "mutating git" "$r"; return 0; }
        else r=$(guarded_main_of_path "${gd:-$gdir}") && { _hit "mutating git" "$r"; return 0; }; fi
      fi
    elif _git_mut "$verb" "$@"; then
      r=$(guarded_main_of_path "${gd:-$gdir}") && { _hit "mutating git" "$r"; return 0; }
    fi
    _check_redirs "$dir" "$in_mirror" ${redirs[@]+"${redirs[@]}"} && return 0
    return 1
  fi
  # gh's own words are text, but these change the local checkout or its config
  if [[ $in_mirror == 1 && "$cmd0" == gh ]]; then
    case "${1:-} ${2:-}" in "pr checkout"|"pr co"|"repo sync"|"repo set-default") _hit "mutating git" "$r"; return 0 ;; esac
  fi
  # fail closed: a program the guard does not know may run what it is given (watch, flock -c, parallel, find -exec, …)
  if [[ $in_mirror == 1 ]]; then
    if ! _text_tool "$cmd0"; then
       local -a rest=("$@"); local i j
       for ((i = 0; i < ${#rest[@]}; i++)); do
         if [[ "${rest[i]}" == -exec || "${rest[i]}" == -execdir || "${rest[i]}" == -ok || "${rest[i]}" == -okdir ]] && _text_tool "${rest[i+1]:-}"; then
           # find -exec grep 'git reset' {} +: grep's words are data
           while [[ $((i+1)) -lt ${#rest[@]} && "${rest[i+1]}" != ';' && "${rest[i+1]}" != '+' ]]; do i=$((i+1)); done
         # a git command among its words: past git's own options, any real git command is classified
         elif [[ "${rest[i]##*/}" == git ]]; then
           j=$((i+1)); while [[ $j -lt ${#rest[@]} ]]; do case "${rest[j]}" in -C|-c|--git-dir|--work-tree|--namespace) j=$((j+2)) ;; -*) j=$((j+1)) ;; *) break ;; esac; done
           _git_cmd "${rest[j]:-}" && _git_mut "${rest[@]:j}" && { _hit "mutating git" "$r"; return 0; }
         # a quoted command line handed over to run (watch 'cmd', flock -c 'cmd')
         elif [[ "${rest[i]}" == *[[:space:]]* ]]; then
           _guard_walk "$dir" "${rest[i]}" && return 0
         fi
       done
    fi
  fi
  case "$cmd0" in chmod|chflags)
    if [[ $in_mirror == 1 ]]; then _hit "chmod/chflags on a mirror" "$dir"; return 0; fi
    for nxt in "$@"; do
      case "$nxt" in -*) continue ;; esac
      r=$(guarded_main_of_path "$(norm "$nxt" "$dir")") && { _hit "chmod/chflags on a mirror path" "$r"; return 0; }
    done
    return 1 ;;
  esac
  if [[ "$cmd0" == find || "$cmd0" == xargs ]]; then
    for nxt in "$@"; do
      case "$nxt" in chmod|chflags)
        if [[ $in_mirror == 1 ]]; then _hit "chmod/chflags on a mirror" "$dir"; return 0; fi
        _arg_in_mirror "chmod/chflags on a mirror path" "$dir" "$@" && return 0
        break ;;
      esac
    done
  fi
  # perl -i rewrites its files: judged like sed -i, not as a script run
  if [[ "$cmd0" == perl ]] && _perl_inplace "$@"; then
    if [[ $in_mirror == 1 ]] || w=$(_arg_in_mirror "a write to a mirror path" "$dir" "$@"); then
      st=0; _wr_inplace perl "$dir" "$@" || st=$?
      # perl -i on a file entry would fail without saying so
      [[ $st == 2 ]] && { _hit "$INPLACE_RULE" "$dir"; return 0; }
      [[ $st == 1 && $in_mirror == 1 ]] && { _hit "a file-changing command" "$dir"; return 0; }
      [[ $st == 1 ]] && { printf '%s\n' "$w"; return 0; }
    fi
    cmd0=perl-i   # judged; skip the interpreter rules below
  fi
  case "$cmd0" in
    tee|cp|mv|rm|rmdir|mkdir|touch|ln|install|npx|yarn|pnpm)
      # a block unless every path it writes is writable local state (its redirects are still judged below)
      if [[ $in_mirror == 1 ]]; then _wr_cmd "$cmd0" "$dir" "$@" || { _hit "a file-changing command" "$dir"; return 0; }
      elif w=$(_arg_in_mirror "a write to a mirror path" "$dir" "$@"); then _wr_cmd "$cmd0" "$dir" "$@" || { printf '%s\n' "$w"; return 0; }; fi ;;
    sed)
      for nxt in "$@"; do
        case "$nxt" in -i|-i*|--in-place|--in-place=*)
          if [[ $in_mirror == 1 ]] || w=$(_arg_in_mirror "a write to a mirror path" "$dir" "$@"); then
            st=0; _wr_inplace sed "$dir" "$@" || st=$?
            [[ $st == 2 ]] && { _hit "$INPLACE_RULE" "$dir"; return 0; }
            [[ $st == 1 && $in_mirror == 1 ]] && { _hit "a file-changing command" "$dir"; return 0; }
            [[ $st == 1 ]] && { printf '%s\n' "$w"; return 0; }
          fi
          break ;;
        esac
      done ;;
    npm)
      # the subcommand is the first word that is no option, and --prefix (or -C) names the project npm runs in; any
      # other path is data handed to the script
      sc=""
      for nxt in "$@"; do
        if [[ $skip == 1 ]]; then skip=0; _arg_in_mirror "running a mirror script by path" "$dir" "$nxt" && return 0; continue; fi
        case "$nxt" in
          --prefix|-C) skip=1 ;;
          --prefix=*) _arg_in_mirror "running a mirror script by path" "$dir" "${nxt#*=}" && return 0 ;;
          --) break ;;
          -*) ;;
          *) [[ -n "$sc" ]] || sc=$nxt ;;
        esac
      done
      if [[ $in_mirror == 1 ]]; then
        case "$sc" in
          i|install|ci|un|uninstall|update|pkg|link) _hit "a file-changing command" "$dir"; return 0 ;;
          run|run-script|start|test|t|exec|x|restart) _hit "running a script, server or test" "$dir"; return 0 ;;
        esac
      fi ;;
    python|python[0-9]*|perl|node)
      # the script is the first word that is neither an option nor an option's value. The words after it are its
      # arguments, data: `x.py --repo <main>` reads the mirror, `python -u <main>/x.py` runs it (#15)
      for nxt in "$@"; do
        if [[ $skip == 1 ]]; then skip=0; continue; fi
        case "$cmd0:$nxt" in
          node:-e|node:-p|node:-pe|node:--eval|node:--print|p*:-c|p*:-m|p*:-[!-]*e*)   # code or a module, not a file
            if [[ $in_mirror == 1 ]]; then _hit "a file-changing command" "$dir"; return 0; fi
            break ;;
          *:-) break ;;   # the script comes on stdin
          # shortcut: only the common options that take a separate value; another one's value is read as the script
          p*:-W|p*:-X|perl:-I|node:-r|node:--require|node:--import|node:--loader|node:--env-file|node:-C|node:--conditions) skip=1 ;;
          *:-*) ;;
          *) if [[ $in_mirror == 1 ]]; then _hit "running a script, server or test" "$dir"; return 0; fi
             _arg_in_mirror "running a mirror script by path" "$dir" "$nxt" && return 0
             break ;;
        esac
      done ;;
    bun|bunx|deno|tsx|ts-node|make|docker|docker-compose|terraform|tofu|ansible|ansible-playbook)
      if [[ $in_mirror == 1 ]]; then _hit "running a script, server or test" "$dir"; return 0; fi ;;
    uv) case "$1" in run) if [[ $in_mirror == 1 ]]; then _hit "running a script, server or test" "$dir"; return 0; fi ;; esac ;;
  esac
  case "$orig" in ./*|scripts/*|bin/*)
    if [[ $in_mirror == 1 ]]; then _hit "running a script, server or test" "$dir"; return 0; fi ;;
  esac
  case "$orig" in */*)   # a program named by a path: running it is running that checkout's code
    r=$(guarded_main_of_path "$(norm "$orig" "$dir")") && { _hit "running a mirror script by path" "$r"; return 0; } ;;
  esac
  _check_redirs "$dir" "$in_mirror" ${redirs[@]+"${redirs[@]}"} && return 0
  return 1
}
# dir command fn stop — runs `fn dir words_nl` on each simple command, following cd and subshells (a cd inside ( … ) is
# undone at the close); stop=1 returns 0 at the first fn that returns 0. A cd that may not run (in a block, after && or
# ||) leaves its folder as `maybe`,
_walk() {
  local dir=$1 fn=$3 stop=$4 tok simple="" depth=0 prev="" nd maybe="" pend="" lastop="" blk=0 w0
  local -a outer=() outerp=() outerm=()
  while IFS= read -r tok; do              # and later commands are judged in both
    if _is_op "$tok"; then
      if "$fn" "$dir" "$simple" && [[ $stop == 1 ]]; then return 0; fi
      if [[ -n "$maybe" && "$maybe" != "$dir" ]] && "$fn" "$maybe" "$simple" && [[ $stop == 1 ]]; then return 0; fi
      w0=${simple%%$'\n'*}
      case "$w0" in if|while|until|for|select|case|'{') blk=$((blk+1)) ;; fi|done|'esac'|'}') [[ $blk -gt 0 ]] && blk=$((blk-1)) ;; esac
      nd=$(_dir_after "$dir" "$simple" "$prev")
      if [[ "$nd" != "$dir" ]]; then
        if [[ $blk -gt 0 || "$lastop" == "&&" || "$lastop" == "||" ]]; then pend=$dir   # this cd may not run
        else pend=""; [[ -n "$maybe" ]] && { maybe=$(_dir_after "$maybe" "$simple" "$prev"); [[ "$maybe" == "$nd" ]] && maybe=""; }; fi
        prev=$dir; dir=$nd
      fi
      # past the && chain the cd was in, either folder is possible
      [[ "$tok" != "&&" && -n "$pend" ]] && { [[ -n "$maybe" ]] || maybe=$pend; pend=""; }
      simple=""; lastop=$tok
      case "$tok" in
        "(") outer[depth]=$dir; outerp[depth]=$prev; outerm[depth]=$maybe; depth=$((depth+1)); lastop="" ;;
        ")") [[ $depth -gt 0 ]] && { depth=$((depth-1)); dir=${outer[depth]}; prev=${outerp[depth]}; maybe=${outerm[depth]}; } ;;
      esac
    else
      simple+="$tok"$'\n'
    fi
  done < <(_tokens "$2")
  "$fn" "$dir" "$simple" && [[ $stop == 1 ]] && return 0
  [[ -n "$maybe" && "$maybe" != "$dir" ]] && "$fn" "$maybe" "$simple" && [[ $stop == 1 ]]
}
# dir command — prints rule, 0 if some simple command must be blocked
_guard_walk() { _walk "$1" "$2" _check_simple 1; }
# dir command — the directory each apply_patch in a shell command runs in, one per line
_patch_dirs() { _walk "$1" "$2" _patch_simple 0 || true; }
# dir words_nl — prints dir when this simple command runs apply_patch; a nested bash -c or eval is walked from dir
_patch_simple() {
  local dir=$1; _words "$2"; set -- ${WORDS[@]+"${WORDS[@]}"}
  _wrap_n "$@"; shift "$WRAP_N"
  # env -S 'apply_patch' runs apply_patch
  [[ -n "$WRAP_SPLIT" ]] && { local -a sw; read -ra sw <<<"$WRAP_SPLIT"; set -- ${sw[@]+"${sw[@]}"} "$@"; }
  [[ $# -gt 0 ]] || return 1
  case "${1##*/}" in
    apply_patch|applypatch) printf '%s\n' "$dir" ;;
    eval) shift; _patch_dirs "$dir" "$*" ;;
    bash|sh|zsh|dash) shift
      while [[ $# -gt 0 ]]; do case "$1" in -c|-[!-]*c) [[ $# -ge 2 ]] && _patch_dirs "$dir" "$2"; return 0 ;; -*) shift ;; *) return 0 ;; esac; done ;;
  esac
  return 0
}
norm() { local p=$1; p=${p//\"/}; p=${p//\'/}; p=$(tilde "$p"); [[ "$p" == /* ]] || p="$2/$p"; printf '%s' "$p"; }
# path main [rule] — refuse (exit 2 + stderr), and record the refusal with the agent, session, pid and command from
# cmd_guard's scope
block() {
  local r apid wr="" note; r=$(basename "$2"); apid=${ONETREE_SESSION_PID:-$(agent_pid)}; [[ "$apid" =~ ^[0-9]+$ ]] || apid=null
  log_event guard decision=block "rule=${3:-a write}" "tool=${tool:-}" "agent=${agent:-unknown}" "session=${sid:-}" "pid:=$apid" "cwd=${cwd:-}" "path=$1" "main=$2" "repo=$r" "command=${cmd:-}" "file=${fp:-}"
  if lock_ignored "$2" 2>/dev/null; then
    wr=$(wr_entries "$2" 2>/dev/null | tr '\n' ' ' || true); wr=${wr% }
    note=$([[ -n "$wr" ]] && printf ' Only gitignored local state stays writable here: %s.' "$wr")
  else note=' Gitignored local state (dependencies, caches, .env, local settings) stays writable here; tracked files, and new files git would track, do not.'; fi
  [[ "${3:-}" == "$NEWFILE_RULE" ]] && note+=" git ignores ${1#"$2"/}, but its directory is locked, so nothing can create it here; if it is local state this checkout needs, \`onetree init --writable-add ${1#"$2"/}\` creates it once."
  local h own where   # each step may fail without ending the guard early: any exit but 2 lets the call through
  # Claude sets agent_id only on a subagent's calls
  h=$(host_of) || h=; [[ -n "${aid:-}" && "$h" == claude-* ]] && h=claude-subagent
  case "${agent:-}" in pi|dsh) h=$agent ;; esac   # its extension or plugin says who is asking: no guess from the process
  # dsh's plugin sends the session's working directory as cwd: inside a worktree of this checkout, the session works there
  own=; [[ "$h" != dsh ]] || own=$(worktree_at "${scwd:-}" "$2") || own=
  if [[ -n "$own" ]]; then h=dsh-moved; else own=$(bound_worktrees "${sid:-}" "$([[ "$apid" == null ]] || echo "$apid")" "$2" | awk 'NR == 1') || own=; fi
  if [[ -n "$own" ]]; then where="This session already has a worktree, $own: do it there. To work there, $(move_hint "$h" "$own" "$2")"
  else where="Work in a worktree instead: $(new_step "$h" "<slug>" "$r"), then $(move_hint "$h" "<path>" "$2")"; fi
  printf 'onetree guard (%s): %s is the read-only main checkout of %s. %s Never switch, stash, reset, edit, or run scripts, servers or tests in the main checkout; reading is fine.%s\n' "${3:-a write}" "$1" "$r" "$where" "$note" >&2
  exit 2
}
# path rule — refuse a command that would turn the guard off or change onetree's settings, wherever the agent runs it.
# path is the guarded main it touches, or onetree's config file when it touches every repo (main and repo are then empty
# in the event)
block_self() {
  local m="" r="" what apid
  if _is_guarded "$1"; then m=$1; r=$(basename "$1"); what="the guarded repo $r ($1)"
  elif production "$1"; then m=$1; r=$(basename "$1"); what="the production checkout $r ($1)"
  else what="onetree for every repo on this machine"; fi
  apid=${ONETREE_SESSION_PID:-$(agent_pid)}; [[ "$apid" =~ ^[0-9]+$ ]] || apid=null
  log_event guard decision=block "rule=$2" "tool=${tool:-}" "agent=${agent:-unknown}" "session=${sid:-}" "pid:=$apid" "cwd=${cwd:-}" "path=$1" "main=$m" "repo=$r" "command=${cmd:-}" "file=${fp:-}"
  printf "onetree guard (%s): an agent may not turn the guard off or change onetree's settings; this would change %s. If the user wants it, they run the command themselves in a terminal. Do not look for another way to do it.\n" "$2" "$what" >&2
  exit 2
}
# hook json -> the patch, wherever the client put it in tool_input
_patch_text() { jq -r '[.tool_input | .. | strings] | join("\n")' <<<"$1" 2>/dev/null; }
# text -> "n<TAB>line" for every line of the n-th patch in it (from the line holding *** Begin Patch to the one holding
# *** End Patch)
_patch_tagged() {
  awk '{ line = $0; tag = (inside ? n : 0)
    while (1) {
      if (!inside) { b = index(line, "*** Begin Patch"); if (!b) break; n++; inside = 1; tag = n; line = substr(line, b + 15) }
      e = index(line, "*** End Patch"); if (!e) break
      inside = 0; line = substr(line, e + 13)
    }
    if (tag) print tag "\t" $0 }' <<<"$1"
}
# text -> the text with each patch replaced by the word __ONETREE_PATCH_<n>__, so a patch quoted across lines no longer
_patch_split() {
  awk '{ line = $0; buf = ""   # throws the tokenizer, whose quotes end with their line, off the commands that follow it
    while (1) {
      if (!inside) { b = index(line, "*** Begin Patch"); if (!b) { buf = buf line; break }; n++; buf = buf substr(line, 1, b - 1) "__ONETREE_PATCH_" n "__"; inside = 1; line = substr(line, b + 15) }
      e = index(line, "*** End Patch"); if (!e) break
      inside = 0; line = substr(line, e + 13)
    }
    held = held buf
    if (!inside) { print held; held = "" } }
    END { if (held != "") print held }' <<<"$1"
}
# patch-text dir — judge each file the patch names, resolved from dir, wherever the agent is: onetree's config file is
# refused (deleting it by its name; adding, updating or moving onto it under any name, since apply_patch writes through
# a link), and a mirror
_patch_guard() {
  local text=$1 base=$2 op f m r pm
  [[ "$text" == *"*** "*" File: "* ]] || return 0   # path is judged like Edit
  while IFS=$'\t' read -r op f; do
    [[ -n "$f" ]] || continue
    fp=$(norm "$f" "$base")
    case "$op" in Delete) m="name" ;; *) m="write" ;; esac
    _cfg_is "$base" "$f" "$m" && block_self "$(_cfg_real)" "$SELF_CFG: onetree's config file"
    pm=$(_production_cfg_main "$base" "$f") && block_self "$pm" "$SELF_CFG: production marker"
    if r=$(guarded_main_of_path "$fp"); then
      # deleting needs a writable directory, as rm does
      if writable_ok "$r" "$fp" && [[ "$op" != Delete || "$WR_KIND" == in ]]; then continue; fi
      [[ $WR_NEW == 1 ]] && block "$fp" "$r" "$NEWFILE_RULE"
      block "$fp" "$r"
    fi
  done < <(_patch_paths "$text")
  fp=
}
cmd_guard() {
  local j tool cwd scwd fp cmd r p out why sid agent aid pd d tagged np k pt
  j=$(cat) || exit 0
  { IFS= read -r -d '' tool; IFS= read -r -d '' cwd; IFS= read -r -d '' sid; IFS= read -r -d '' agent; IFS= read -r -d '' cmd; IFS= read -r -d '' d; IFS= read -r -d '' aid; } \
    < <(jq -j '[.tool_name, .cwd, .session_id, '"$AGENT_JQ"', (.tool_input.command // .tool_input.cmd), .tool_input.workdir, .agent_id] | map((. // "" | tostring) + "\u0000") | add' <<<"$j" 2>/dev/null) || true
  [[ -n "$tool" ]] || exit 0   # one jq start per call, every field at once; bad JSON still passes
  GUARDED_MEMO=$(gcfg_all onetree.guarded)
  [[ -n "$cwd" ]] || cwd=$PWD
  scwd=$cwd   # the session's own directory, whatever workdir a call names
  # the pi extension says so; Claude and Codex are told apart by where they keep transcripts
  [[ -n "$agent" ]] || agent=unknown
  case "$tool" in
    Edit|Write|MultiEdit|NotebookEdit)
      fp=$(jq -r '.tool_input.file_path // .tool_input.notebook_path // empty' <<<"$j" 2>/dev/null) || exit 0; [[ -n "$fp" ]] || exit 0
      [[ "$fp" == /* ]] || fp="$cwd/$fp"
      _cfg_is "$cwd" "$fp" write && block_self "$(_cfg_real)" "$SELF_CFG: onetree's config file"
      r=$(_production_cfg_main "$cwd" "$fp") && block_self "$r" "$SELF_CFG: production marker"
      # these tools write in place, so an ignored file in a locked directory is fine once it exists
      if r=$(guarded_main_of_path "$fp"); then
        writable_ok "$r" "$fp" && exit 0
        [[ $WR_NEW == 1 ]] && block "$fp" "$r" "$NEWFILE_RULE"
        block "$fp" "$r"
      fi
      exit 0 ;;
    # each file is judged where it resolves, so a session that cannot leave the mirror patches its worktree by absolute
    # path; a patch that names no file is refused there
    apply_patch)
      pt=$(_patch_text "$j")
      _patch_guard "$pt" "$cwd"
      [[ "$(_patch_paths "$pt")" == *[![:space:]]* ]] || { r=$(guarded_main_of_path "$cwd") && block "$cwd" "$r"; }
      exit 0 ;;
    Bash|bash|shell|local_shell|exec_command)
      [[ -n "$cmd" ]] || exit 0
      # where the command starts when the agent names it (dsh, a Codex-shaped payload); Codex itself never passes it
      [[ -n "$d" ]] && cwd=$(norm "$d" "$cwd")
      # a patch run through the shell names its files the same way, relative to where its apply_patch runs (cd
      # <worktree> && apply_patch … is the normal case). The n-th patch belongs to the n-th apply_patch; when the counts
      # differ, every patch is judged at every place
      if [[ "$cmd" == *apply_patch* && "$cmd" == *"*** Begin Patch"* ]]; then
        tagged=$(_patch_tagged "$(_patch_text "$j")")
        np=$(awk -F'\t' 'END { print $1 + 0 }' <<<"$tagged")
        pd=$(_patch_dirs "$cwd" "$(_patch_split "$cmd")"); [[ -n "$pd" ]] || pd=$cwd
        k=0
        while IFS= read -r d; do
          [[ -n "$d" ]] || continue; k=$((k+1))
          if [[ "$(grep -c . <<<"$pd")" == "$np" ]]; then _patch_guard "$(awk -F'\t' -v k="$k" '$1 == k { sub(/^[^\t]*\t/, ""); print }' <<<"$tagged")" "$d"
          else _patch_guard "$(_patch_text "$j")" "$d"; fi
        done <<<"$pd"
      fi
      [[ "$cmd" == *[a-z]* ]] || exit 0
      # `onetree` itself passes per simple command unless it turns the guard off (_onetree_self)
      if out=$(_guard_walk "$cwd" "$cmd"); then
        why=${out%%$'\t'*}; p=${out#*$'\t'}; [[ -n "$p" ]] || p=$cwd
        # about onetree itself: refused outside a mirror too
        case "$why" in "$SELF_OFF"*|"$SELF_CFG"*) block_self "$p" "$why" ;; esac
        r=$(guarded_main_of_path "$p") || r=$(guarded_main_of_path "$cwd") || exit 0
        block "$p" "$r" "$why"
      fi
      exit 0 ;;
  esac
  exit 0
}

# ---- dispatch
# `<cmd> --help` is never an argument
case "${1:-}/${2:-}" in -h/*|--help/*|help/*|*/-h|*/--help) sed -n '2,/^set -/p' "$0" | grep '^#'; exit 0 ;; esac
case "${1:-}" in
  version|--version) d=$(dirname "$(dirname "$(realfile "$0")")")   # a contributor clone off a tag says which commit it runs
    if [[ -e "$d/.git" ]] && ! git -C "$d" describe --exact-match --tags --match 'v*' >/dev/null 2>&1; then echo "onetree $VERSION (dev $(git -C "$d" rev-parse --short HEAD))"; else echo "onetree $VERSION"; fi ;;
  new) shift; cmd_new "$@" ;;
  carry) shift; cmd_carry "$@" ;;
  ls)  shift; cmd_ls "$@" ;;
  rm)  shift; cmd_rm "$@" ;;
  gc)  shift; cmd_gc "$@" ;;
  park) shift; cmd_park "$@" ;;
  bootstrap) shift; cmd_bootstrap "$@" ;;
  render) case "${2:-}" in pi) render_pi_extension ;; dsh) render_dsh_plugin ;; *) die "render: pi | dsh" ;; esac ;;
  codex-grants) codex_grants "${2:?worktree}" ;;
  bound) shift; s=""; p=""   # the pi extension asks which worktree its session moved to
    while [[ $# -gt 0 ]]; do case "$1" in --session) s=${2:?}; shift 2 ;; --pid) p=${2:?}; shift 2 ;; *) die "bound: unknown option $1" ;; esac; done
    bound_worktrees "$s" "$p" "" | awk 'NR == 1' ;;
  review) shift; cmd_review "$@" ;;
  auto) shift; cmd_auto "$@" ;;
  launch) shift; cmd_launch "$@" ;;
  resume) shift; cmd_resume "$@" ;;
  init) shift; cmd_init "$@" ;;
  unregister) shift; cmd_unregister "$@" ;;
  repos) cmd_repos ;;
  info) shift; cmd_info "$@" ;;
  snippet) shift; cmd_snippet "$@" ;;
  guard) cmd_guard ;;
  install) cmd_install ;;
  update) cmd_update ;;
  uninstall) cmd_uninstall ;;
  doctor) shift; cmd_doctor "$@" ;;
  events) shift; cmd_events "$@" ;;
  agents) shift; cmd_agents "$@" ;;
  snapshot) shift; cmd_snapshot "$@" ;;
  ui) shift; cmd_ui "$@" ;;
  rules) cmd_rules ;;
  session) cmd_session ;;
  hook-create)
    j=$(cat); name=$(jq -r '.name // empty' <<<"$j")
    # an isolated subagent's worktree is its own, not the session's: bound and resume skip it shortcut: Claude 2.1.319
    # fires this from the parent, naming it agent-<id>; drop if Claude passes agent_id
    SUBAGENT=$(jq -r '.agent_id // empty' <<<"$j")
    [[ -z "$SUBAGENT" && "$name" =~ ^agent-([0-9a-f]{8,})$ ]] && SUBAGENT=${BASH_REMATCH[1]}
    cwd=$(jq -r '.cwd // empty' <<<"$j"); [[ -n "$cwd" ]] || cwd=$PWD
    if main=$(cd "$cwd" && git rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then repo=$(dirname "$main"); slug=${name:-claude-$(date +%y%m%d-%H%M%S)}
    elif [[ "$name" == */* ]]; then repo=${name%%/*}; slug=${name#*/}
    else die "not inside a repo: name the worktree <repo>/<slug> (repos: $(repos_all | xargs -n1 basename | tr '\n' ' '))"; fi
    slug=${slug//\//-}
    if [[ "$repo" == /* ]] && ! is_registered "$(real "$repo")"; then plain_worktree "$(real "$repo")" "$slug"; else cmd_new "$slug" "$repo"; fi ;;
  hook-remove)   # explicit: Claude asked for this one, so it goes like `onetree rm` would take it, whoever made it
    j=$(cat); p=$(jq -r '.worktree_path // empty' <<<"$j"); [[ -d "$p" ]] || { echo "already gone: $p" >&2; exit 0; }
    PR_TTL=0; main=$(cd "$p" && main_of); remove_one "$main" "$p" 0 0 1 >&2 || die "kept $p: it still holds work" ;;
  *) sed -n '2,/^set -/p' "$0" | grep '^#'; exit 2 ;;
esac
