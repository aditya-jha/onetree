{
  "name": "onetree-ui",
  "private": true,
  "version": "1.1.0",
  "description": "The onetree dashboard: a loopback page over `onetree snapshot`. Served by `onetree ui`.",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "vite",
    "serve": "node --experimental-strip-types --disable-warning=ExperimentalWarning server.ts --fixture fixtures/snapshot.json --port 7180",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test src/lib/derive.test.ts server.test.ts",
    "check:dist": "sh scripts/check-dist.sh",
    "verify": "npm run typecheck && npm test && npm run check:dist"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
